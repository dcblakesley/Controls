@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

<section @attributes="AdditionalAttributes" class="validation-summary" aria-label="Validation errors">
    @if (FormOptions is not null)
    {
        @foreach (var v in FormOptions.FieldIdentifiers)
        {
            @foreach (var z in CurrentEditContext.GetValidationMessages(v))
            {
                <a class="validation-summary-message" href="#@(FormOptions.FieldIds.TryGetValue(v, out var fid) ? fid : AttributesHelper.GetId(null, FormGroupOptions, null, v))">@z</a>
            }
        }
    }
</section>
        

@code
{
    [CascadingParameter] public FormOptions? FormOptions { get; set; }
    [CascadingParameter] public FormGroupOptions? FormGroupOptions { get; set; }

    // The same subscribe/re-point/detach sequence the edit controls use, through the one shared
    // implementation (EditControlParametersBase drives it too). Created lazily: its handler is an
    // instance method group, which a field initializer can't take.
    ValidationStateSubscription? _validationSubscription;

    /// <summary>
    /// Gets or sets a collection of additional attributes that will be applied to the rendered <c>section</c> element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [CascadingParameter] EditContext CurrentEditContext { get; set; } = default!;

    protected override void OnParametersSet()
    {
        if (CurrentEditContext == null)
        {
            throw new InvalidOperationException($"{nameof(ValidationView)} requires a cascading parameter " +
                                                $"of type {nameof(EditContext)}. For example, you can use {nameof(ValidationView)} inside " +
                                                $"an {nameof(EditForm)}.");
        }

        _validationSubscription ??= new ValidationStateSubscription(StateHasChanged);
        _validationSubscription.SyncTo(CurrentEditContext);
    }

    public void Dispose() => _validationSubscription?.Detach();
}
