@inherits EditControlBase<bool?>

@if (ShouldShowComponent())
{
    @* The consumer's `style` lands on the wrapper (one rule for every control -- see EditControlBase's
       unmatched-attribute remarks); the remaining unmatched attributes go on the radiogroup fieldset,
       matching the other three radio-group controls. Splatted first, so every attribute written below
       wins; `class` travels CssClass onto each radio input, so AttributeSplat.Rest withholds it. *@
    <div class="edit-control-wrapper @ContainerClass"
         style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">
        @* id/data-test-id/role/aria-* now come from RadioAria, shared with EditRadio/EditRadioEnum/
           EditRadioString (this control used to write the block out by hand); splatted first so the
           explicit class below wins, and merged with the consumer's own unmatched attributes
           (RadioAria's keys win; one element, one @attributes). Defaults IsHorizontal=true, so
           aria-orientation="horizontal" renders unless a consumer explicitly sets IsHorizontal=false. *@
        <fieldset @attributes="AttributeSplat.RestWith(AdditionalAttributes, RadioAria.Fieldset(ShowEditor, _id, _isRequired, IsInvalid, _describedBy, _errorMsgId, isHorizontal: IsHorizontal))"
                  class="edit-radio-fieldset">
            <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label LabelContent=@LabelContent IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLegend="true" IsLabelHidden=@ShouldHideLabel />

            @if (ShowEditor)
            {
                <div class=@(IsHorizontal
                            ? "edit-radio-buttons-container-horizontal"
                            : "edit-radio-buttons-container-vertical")>
                    @RadioOption(false, "false", EffectiveFalseText)
                    @RadioOption(true, "true", EffectiveTrueText)
                    @if (ShowNullOption)
                    {
                        @RadioOption(null, "none", EffectiveNullText)
                    }
                </div>
            }
            else
            {
                <ReadOnlyValue Id=@_id
                              CssClass=@CssClass
                              Text=@GetDisplayText(CurrentValue) />
            }

            <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
            <BoundValueDisplay Text=@CurrentValueAsString />
        </fieldset>
    </div>
}

@code {
    // Shared by all three radios above -- the false/true/null options are identical apart from the
    // bound value, the id/data-test-id suffix, and the displayed text.
    RenderFragment RadioOption(bool? value, string idSuffix, string text) => @<label class="edit-radio-label">
        <input type="radio"
               name=@_id
               value="@(value switch { true => "true", false => "false", null => "" })"
               checked="@(CurrentValue == value)"
               @onchange="@(() => OnValueChanged(value))"
               id=@($"rb-{_id}-{idSuffix}")
               data-test-id=@($"rb-{_id}-{idSuffix}")
               class="edit-radio-input @CssClass"
               disabled=@IsDisabled />
        @text
    </label>;
}
