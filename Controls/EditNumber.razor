@typeparam T
@inherits EditTextControlBase<T>

@if (ShouldShowComponent())
{
    <div class="edit-control-wrapper @ContainerClass">
        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@ShowEditor />

        @if (ShowEditor)
        {
            @* @bind-value:event defaults to UpdateTrigger.Change (onchange), NOT Input (oninput):
               browsers report type=number as "" while the text is a partial number ("-", "3.", "1e"),
               so per-keystroke binding would flash "must be a number" mid-typing. Matches Microsoft's
               InputNumber. See DefaultUpdateTrigger's doc comment in EditNumber.razor.cs for the
               full rationale (UpdateOn itself now lives on EditTextControlBase<TValue>).
               (Comment deliberately outside the tag — a Razor comment inside an attribute list
               compiles into a literal attribute name and breaks setAttribute.) *@
            <EditInputShell IsInvalid=@IsInvalid
                            IsDisabled=@IsDisabled
                            WrapperClass=@(EditInputShell.SizeClass(Size))
                            Prefix=@Prefix
                            Suffix=@Suffix>
                <input type="number"
                       style=@(UseAffixLayout ? null : "padding-inline-end: 2rem")
                       disabled=@IsDisabled
                       id=@_id
                       data-test-id=@_id
                       step=@EffectiveStep
                       min=@(EffectiveMin?.ToString(CultureInfo.InvariantCulture))
                       max=@(EffectiveMax?.ToString(CultureInfo.InvariantCulture))
                       placeholder=@EffectivePlaceholder
                       @bind-value=@CurrentValueAsString
                       @bind-value:event="@UpdateEventName"
                       class=@InputClass
                       aria-required=@_isRequired
                       aria-invalid=@(IsInvalid ? "true" : null)
                       aria-describedby=@_describedBy
                       aria-errormessage=@(IsInvalid ? _errorMsgId : null) />
            </EditInputShell>
        }
        else
        {
            <ReadOnlyValue Id=@_id CssClass=@CssClass Text=@GetFormattedNumber() />
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label />
        @if (FormOptions != null && FormOptions.ShowBoundValues)
        {
            <div class="bound-value">@CurrentValueAsString</div>
        }
    </div>
}