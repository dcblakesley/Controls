@typeparam TValue
@inherits EditSelectBase<TValue>

@if (ShouldShowComponent())
{
    @* The consumer's `style` lands on the wrapper (one rule for every control -- see EditControlBase's
       unmatched-attribute remarks); the remaining unmatched attributes go on the <select> below. *@
    <div class="edit-control-wrapper @ContainerClass"
         style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">
        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label LabelContent=@LabelContent IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@ShowEditor />

        @if (ShowEditor)
        {
            @* Splat first so every explicit attribute below wins. The CONDITIONAL state attributes
               (disabled/aria-required/aria-invalid/aria-errormessage) ride the merged dictionary
               (EditControlBase.EditorStateAttributes) rather than their own explicit attributes here --
               an explicit frame wins outright over an earlier same-named one even when its own value is
               null, so writing them here would DELETE a consumer's splatted value rather than merely
               decline to override it. *@
            <select @attributes="AttributeSplat.RestWith(AdditionalAttributes, EditorStateAttributes)"
                    @bind=@CurrentValueAsString
                    @ref="_editorRef"
                    class=@($"edit-input edit-select-select {CssClass}")
                    id=@_id
                    data-test-id=@_id
                    aria-labelledby=@($"lbltext-{_id}")
                    aria-describedby=@_describedBy>

                @ChildContent
            </select>
        }
        else
        {
            <ReadOnlyValue Id=@_id CssClass=@CssClass Text=@(ReadOnlyText ?? CurrentValueAsString) />
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
        <BoundValueDisplay Text=@CurrentValueAsString />
    </div>
}
