@inherits EditControlListBase<IBrowserFile>

@if (ShouldShowComponent())
{
    @* IsInvalid walks the EditContext's message list on every read, and this markup needs the answer
       five times (once directly, four more through HasError). Captured into locals rather than a
       field: validation state changes outside the parameter lifecycle, so a field would go stale. *@
    var isInvalid = IsInvalid;
    var hasError = HasError(isInvalid);

    @* Byte-identical between both variants -- the input is the real, focusable, click-catching element
       in both; only the surrounding visual chrome differs. aria-errormessage keys off isInvalid
       (EditContext validation), not hasError: error-msg-{id} (FieldValidationDisplay, rendered
       unconditionally below) only ever contains EditContext.GetValidationMessages content. A pure
       upload-time rejection (_uploadErrors, e.g. bad extension) sets hasError -- and so aria-invalid --
       without any EditContext message, and is announced instead through its own role="alert" block
       further down. Gating aria-errormessage on hasError would point it at that EditContext-only
       element while it's empty, i.e. a real error state with a dangling-in-effect (present but blank)
       errormessage target. Declared here (rather than inside the CanAddMoreFiles branch that actually
       renders it) because an inline markup block -- @<Tag> -- cannot nest inside another one, and the
       Bordered fieldContent capture just below is itself one. *@
    RenderFragment inputFile = @<InputFile OnChange="LoadFiles"
               id=@_id
               accept="@string.Join(",", NormalizedExtensions)"
               multiple
               disabled=@(IsDisabled || _isLoadingFiles)
               aria-describedby=@_describedBy
               aria-invalid=@(hasError ? "true" : null)
               aria-errormessage=@(isInvalid ? _errorMsgId : null)
               aria-required=@_isRequired />;

    @* Splat first so the explicit class/style below win; the consumer's own class stays on the single
       FieldCssClass channel (the drop zone / select button / read-only list), so only style and the
       remaining attributes land here. Never on the drop zone itself — its class list is state-driven. *@
    <div @attributes="AttributeSplat.Rest(AdditionalAttributes)"
         class="edit-control-wrapper @ContainerClass"
         style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">
        @* Captured into a fragment (rather than duplicated) so Bordered below can wrap this exact
           label+content in one bordered card -- a field-container convention some consuming design
           systems use around an already-uploaded file link -- without a second, drifting copy of the
           editor/read-only markup. *@
        @{
        RenderFragment fieldContent = @<text>
        @* IsForLabelable gates on CanAddMoreFiles too — at the MaxFiles cap the <InputFile> carrying
           _id unmounts, and a label pointing at a missing id is invalid (and clicks dead). *@
        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@(ShowEditor && CanAddMoreFiles) />

        @if (ShowEditor)
        {
            @* LST-3/LST-4: the only other observable effect while a batch is validated/buffered is the
               <input> going disabled -- nothing announces that a batch is running, nor its outcome
               (successful additions/removals, including a partial success where some files were
               deduped/capped alongside others that succeeded -- the rejections already have their own
               role="alert" block below, but the surviving list was never announced at all). One
               role="status" region covers both: it reads the loading text while a batch is in flight,
               then flips to the current file-list status once _isLoadingFiles clears -- a real content
               change either way, which is what a browser/AT keys an announcement off. *@
            <span class="edit-sr-only" role="status">@(_isLoadingFiles ? LoadingStatusText : FileListStatusText)</span>

            @if (CanAddMoreFiles)
            {
                @if (Variant == EditFileVariant.Button)
                {
                    @* Same invisible-InputFile-overlay technique as the dropzone below (the input is the
                       real, focusable, click-catching element; the button look is purely visual) -- so
                       keyboard/focus/click behavior match even though there's no dashed card or drag-drop. *@
                    <span class="edit-file-select-btn @(hasError ? "error" : "") @(IsDisabled ? "disabled" : "") @FieldCssClass">
                        <i class="edit-icon-upload-btn" aria-hidden="true"></i>
                        <span>@ButtonText</span>
                        @inputFile
                    </span>
                }
                else
                {
                    <div class="edit-file-drop-zone @_hoverClass @(hasError ? "error" : "") @(IsDisabled ? "disabled" : "") @FieldCssClass"
                         @ondragenter="OnDragEnter"
                         @ondragleave="OnDragLeave"
                         @ondragover:preventDefault="true">
                        <i class="edit-icon-upload@(hasError ? "-error" : "")" aria-hidden="true"></i>
                        <div class="edit-file-drop-text">
                            <div>Click or drag files to this area to upload</div>
                            @if (EffectiveAllowedExtensions.Length > 0)
                            {
                                <div class="edit-file-formats">Supported formats: @string.Join(", ", EffectiveAllowedExtensions)</div>
                            }
                            @* LST-5: the resolved caps were previously discoverable only by triggering a
                               rejection. EffectiveMaxFileSizeBytes/EffectiveMaxTotalBytes always resolve
                               to a real, finite default (10 MB/100 MB), so this line always renders; the
                               file-count clause is appended only when EffectiveMaxFiles is actually
                               finite (> 0 -- 0 means genuinely unlimited). *@
                            <div class="edit-file-limits">@CapsHintText</div>
                        </div>
                        @inputFile
                    </div>
                }
            }

            @if (Value?.Count > 0)
            {
                <ul class="edit-file-list" aria-label="Selected files">
                    @for (var i = 0; i < Value.Count; i++)
                    {
                        var f = Value[i];
                        <li class="edit-file-item">
                            <i class="edit-icon-paperclip" aria-hidden="true"></i>
                            @if (AllowDownload)
                            {
                                @* Ant Design's own already-uploaded-file link look -- clicking re-saves
                                   this file's already-buffered bytes (see DownloadFile), never a network
                                   fetch, so it works for a file just picked in this session too. *@
                                <button type="button"
                                        class="edit-file-name edit-file-name-link"
                                        title="Download @f.Name"
                                        aria-label="Download @f.Name"
                                        @onclick="() => DownloadFile(f)"
                                        @onclick:stopPropagation>@f.Name</button>
                            }
                            else
                            {
                                <span class="edit-file-name" title="@f.Name">@f.Name</span>
                            }
                            <span class="edit-file-size">@FormatSize(f.Size)</span>
                            <button type="button"
                                    id=@($"del-{_id}-{i}")
                                    class="edit-file-delete-btn"
                                    title="Remove @f.Name"
                                    aria-label="Remove @f.Name"
                                    disabled=@(IsDisabled || _isLoadingFiles)
                                    @onclick="() => RemoveFile(f)"
                                    @onclick:stopPropagation>
                                <i class="edit-icon-delete" aria-hidden="true"></i>
                            </button>
                        </li>
                    }
                </ul>
            }

            @if (_uploadErrors.Count > 0)
            {
                @* One element per rejected file — several rejections used to overwrite each other,
                   leaving only the last visible. *@
                <div class="edit-validation-message" role="alert">
                    @foreach (var error in _uploadErrors)
                    {
                        <div>@error</div>
                    }
                </div>
            }
        }
        else
        {
            @if (Value is null || Value.Count == 0)
            {
                <ReadOnlyValue Id=@_id CssClass=@FieldCssClass Text="" AriaDescribedBy=@_describedBy />
            }
            else
            {
                @* aria-labelledby unconditionally: FormLabel renders lbltext-{_id} even when the label
                   is visually hidden (sr-only), so the old ShouldHideLabel gate dropped the association
                   on a premise that no longer holds — matching every other control's read-only view.
                   The edit-mode list above names itself with a literal aria-label instead. *@
                <ul class="edit-file-list edit-file-list--readonly @FieldCssClass"
                    id=@_id
                    data-test-id=@_id
                    aria-labelledby="lbltext-@_id">
                    @foreach (var file in Value)
                    {
                        <li class="edit-file-item">
                            <i class="edit-icon-paperclip" aria-hidden="true"></i>
                            @if (AllowDownload)
                            {
                                <button type="button"
                                        class="edit-file-name edit-file-name-link"
                                        title="Download @file.Name"
                                        aria-label="Download @file.Name"
                                        @onclick="() => DownloadFile(file)">@file.Name</button>
                            }
                            else
                            {
                                <span>@file.Name</span>
                            }
                            <span class="edit-file-size">@FormatSize(file.Size)</span>
                        </li>
                    }
                </ul>
            }
        }
</text>;
        }

        @if (Bordered)
        {
            <div class="edit-file-card">
                @fieldContent
            </div>
        }
        else
        {
            @fieldContent
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
        <BoundValueDisplay Text=@BoundValueText />
    </div>
}
