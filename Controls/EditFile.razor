@inherits EditControlListBase<IBrowserFile>

@if (ShouldShowComponent())
{
    @* Splat first so the explicit class/style below win; the consumer's own class stays on the single
       FieldCssClass channel (the drop zone / select button / read-only list), so only style and the
       remaining attributes land here. Never on the drop zone itself — its class list is state-driven. *@
    <div @attributes="AttributeSplat.Rest(AdditionalAttributes)"
         class="edit-control-wrapper @ContainerClass"
         style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">
        @* IsForLabelable gates on CanAddMoreFiles too — at the MaxFiles cap the <InputFile> carrying
           _id unmounts, and a label pointing at a missing id is invalid (and clicks dead). *@
        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@(ShowEditor && CanAddMoreFiles) />

        @if (ShowEditor)
        {
            @if (CanAddMoreFiles)
            {
                // Byte-identical between both variants -- the input is the real, focusable,
                // click-catching element in both; only the surrounding visual chrome differs.
                // aria-errormessage keys off IsInvalid (EditContext validation), not _hasError:
                // error-msg-{id} (FieldValidationDisplay, rendered unconditionally below) only ever
                // contains EditContext.GetValidationMessages content. A pure upload-time rejection
                // (_uploadErrors, e.g. bad extension) sets _hasError -- and so aria-invalid -- without
                // any EditContext message, and is announced instead through its own role="alert" block
                // further down. Gating aria-errormessage on _hasError would point it at that
                // EditContext-only element while it's empty, i.e. a real error state with a dangling-
                // in-effect (present but blank) errormessage target.
                RenderFragment inputFile = @<InputFile OnChange="LoadFiles"
                           id=@_id
                           accept="@string.Join(",", NormalizedExtensions)"
                           multiple
                           disabled=@(IsDisabled || _isLoadingFiles)
                           aria-describedby=@_describedBy
                           aria-invalid=@(_hasError ? "true" : null)
                           aria-errormessage=@(IsInvalid ? _errorMsgId : null)
                           aria-required=@_isRequired />;

                @if (Variant == EditFileVariant.Button)
                {
                    @* Same invisible-InputFile-overlay technique as the dropzone below (the input is the
                       real, focusable, click-catching element; the button look is purely visual) -- so
                       keyboard/focus/click behavior match even though there's no dashed card or drag-drop. *@
                    <span class="edit-file-select-btn @(_hasError ? "error" : "") @(IsDisabled ? "disabled" : "") @FieldCssClass">
                        <i class="edit-icon-upload-btn" aria-hidden="true"></i>
                        <span>@ButtonText</span>
                        @inputFile
                    </span>
                }
                else
                {
                    <div class="edit-file-drop-zone @_hoverClass @(_hasError ? "error" : "") @(IsDisabled ? "disabled" : "") @FieldCssClass"
                         @ondragenter="OnDragEnter"
                         @ondragleave="OnDragLeave"
                         @ondragover:preventDefault="true">
                        <i class="edit-icon-upload@(_hasError ? "-error" : "")" aria-hidden="true"></i>
                        <div class="edit-file-drop-text">
                            <div>Click or drag files to this area to upload</div>
                            @if (EffectiveAllowedExtensions.Length > 0)
                            {
                                <div class="edit-file-formats">Supported formats: @string.Join(", ", EffectiveAllowedExtensions)</div>
                            }
                        </div>
                        @inputFile
                    </div>
                }
            }

            @if (Value?.Count > 0)
            {
                <ul class="edit-file-list" aria-label="Selected files">
                    @for (var i = 0; i < Value.Count; i++)
                    {
                        var f = Value[i];
                        <li class="edit-file-item">
                            <i class="edit-icon-paperclip" aria-hidden="true"></i>
                            <span class="edit-file-name">@f.Name</span>
                            <span class="edit-file-size">@FormatSize(f.Size)</span>
                            <button type="button"
                                    id=@($"del-{_id}-{i}")
                                    class="edit-file-delete-btn"
                                    title="Remove @f.Name"
                                    aria-label="Remove @f.Name"
                                    disabled=@(IsDisabled || _isLoadingFiles)
                                    @onclick="() => RemoveFile(f)"
                                    @onclick:stopPropagation>
                                <i class="edit-icon-delete" aria-hidden="true"></i>
                            </button>
                        </li>
                    }
                </ul>
            }

            @if (_uploadErrors.Count > 0)
            {
                @* One element per rejected file — several rejections used to overwrite each other,
                   leaving only the last visible. *@
                <div class="edit-validation-message" role="alert">
                    @foreach (var error in _uploadErrors)
                    {
                        <div>@error</div>
                    }
                </div>
            }
        }
        else
        {
            @if (Value is null || Value.Count == 0)
            {
                <ReadOnlyValue Id=@_id CssClass=@FieldCssClass Text="" />
            }
            else
            {
                @* aria-labelledby unconditionally: FormLabel renders lbl-{_id} even when the label is
                   visually hidden (sr-only), so the old ShouldHideLabel gate dropped the association
                   on a premise that no longer holds — matching every other control's read-only view.
                   The edit-mode list above names itself with a literal aria-label instead. *@
                <ul class="edit-file-list edit-file-list--readonly @FieldCssClass"
                    id=@_id
                    data-test-id=@_id
                    aria-labelledby="lbl-@_id">
                    @foreach (var file in Value)
                    {
                        <li class="edit-file-item">
                            <i class="edit-icon-paperclip" aria-hidden="true"></i>
                            <span>@file.Name</span>
                            <span class="edit-file-size">@FormatSize(file.Size)</span>
                        </li>
                    }
                </ul>
            }
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
        @if (FormOptions != null && FormOptions.ShowBoundValues)
        {
            <div class="bound-value">@(Value?.Count == 0 ? "(none)" : string.Join(", ", (Value ?? []).Select(f => f.Name)))</div>
        }
    </div>
}
