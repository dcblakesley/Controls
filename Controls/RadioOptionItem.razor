@typeparam TItem

@if (IsButtonMode)
{
    @* AntD's segmented "button" look -- a visually-hidden input + sibling label button (the same
       styled-checkbox technique CheckboxOptionList uses). *@
    <span class="edit-radio-button-wrap">
        <InputRadio Value=@Value
                    disabled=@IsDisabled
                    class=@($"edit-radio-button-input {CssClass}")
                    id=@OptionId
                    data-test-id=@OptionId />
        <label class=@($"edit-radio-button {LabelClass}") for=@OptionId>@Display</label>
    </span>
}
else
{
    <label class=@($"edit-radio-label {LabelClass}")>
        <InputRadio Value=@Value
                    disabled=@IsDisabled
                    class=@($"edit-radio-input {CssClass}")
                    id=@OptionId
                    data-test-id=@OptionId />
        @Display
    </label>
}
