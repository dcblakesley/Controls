@typeparam TEnum
@inherits RadioGroupControlBase<TEnum?>

@if (ShouldShowComponent())
{
    @* The consumer's `style` lands on the wrapper (one rule for every control -- see EditControlBase's
       unmatched-attribute remarks); the remaining unmatched attributes go on the radiogroup fieldset. *@
    <div class="edit-control-wrapper @ContainerClass"
         style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">
        @* id/data-test-id/role/aria-* come from RadioAria, shared with EditRadio/EditRadioString;
           splatted first so the explicit class below wins, and merged with the consumer's own
           unmatched attributes (RadioAria's keys win; one element, one @attributes). *@
        <fieldset @attributes="AttributeSplat.RestWith(AdditionalAttributes, RadioAria.Fieldset(ShowEditor, _id, _isRequired, IsInvalid, _describedBy, _errorMsgId, isHorizontal: IsHorizontal || OptionType == RadioOptionType.Button))"
                  class="edit-radio-fieldset">
            <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label LabelContent=@LabelContent IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLegend=true IsLabelHidden=@ShouldHideLabel />

            @if (ShowEditor)
            {
                @* ValueExpression forwarded so the inner group notifies/styles the real model field;
                   `disabled` would be a no-op here (InputRadioGroup renders no element) — each
                   InputRadio below carries it individually. *@
                <InputRadioGroup Value=@CurrentValue ValueChanged=@((TEnum? v) => OnSelectionChangedAsync(v)) ValueExpression=@ValueExpression>

                    @if (OptionType == RadioOptionType.Button)
                    {
                        @* Button mode is inherently horizontal (AntD's segmented look) -- IsHorizontal
                           is ignored here rather than composed with it. Same InputRadio/keyboard
                           semantics as default mode, just styled as a visually-hidden input + sibling
                           label button (the established styled-checkbox technique). *@
                        var buttonOptions = GetOptions();
                        <div class=@ButtonGroupClass>
                            @for (var i = 0; i < buttonOptions.Count; i++)
                            {
                                var option = buttonOptions[i];
                                <RadioOptionItem Value=@option IsButtonMode="true" IsDisabled=@IsOptionNativelyDisabledFor(option) IsLocked=@IsOptionLockedFor(option) Id=@_id IdSuffix=@(_optionIds[i]) CssClass=@CssClass LabelClass=@LabelClass Display=@option.GetName() />
                            }
                        </div>
                        @if (HasOtherOption && buttonOptions.Count > 0)
                        {
                            var lastOption = buttonOptions[^1];
                            <div class="edit-radio-other-option-container">
                                <RadioOtherInput Id=@($"other-{_id}")
                                                 Value=@DisplayedOtherValue
                                                 IsDisabled=@(!EqualityComparer<TEnum?>.Default.Equals(CurrentValue, lastOption) || IsOptionDisabledFor(lastOption))
                                                 Placeholder=@OtherPlaceholder
                                                 AriaLabel=@(OtherAriaLabel ?? RadioOtherInput.DefaultAriaLabel)
                                                 CommitAttributes=@OtherInputAttribute />
                            </div>
                        }
                    }
                    else
                    {
                        <div class=@(IsHorizontal
                                              ? "edit-radio-buttons-container-horizontal"
                                              : "edit-radio-buttons-container-vertical")>
                    @{
                                var options = GetOptions();
                                for (var i = 0; i < options.Count; i++)
                                {
                                    var option = options[i];
                                    var isLastOption = i == options.Count - 1;
                                    var showOtherInput = HasOtherOption && isLastOption;

                                    <div class="edit-radio-option">
                                        <RadioOptionItem Value=@option IsButtonMode="false" IsDisabled=@IsOptionNativelyDisabledFor(option) IsLocked=@IsOptionLockedFor(option) Id=@_id IdSuffix=@(_optionIds[i]) CssClass=@CssClass LabelClass=@LabelClass Display=@option.GetName() />

                                        @* The Other box shares this option's .edit-radio-option flex row, so the
                                           radio and its free-text box sit side by side. EditRadioString mirrors
                                           this wrapper -- keep the two in step (both render RadioOtherInput). *@
                                        @if (showOtherInput)
                                        {
                                            <RadioOtherInput Id=@($"other-{_id}")
                                                             Value=@DisplayedOtherValue
                                                             IsDisabled=@(!EqualityComparer<TEnum?>.Default.Equals(CurrentValue, option) || IsOptionDisabledFor(option))
                                                             Placeholder=@OtherPlaceholder
                                                             AriaLabel=@(OtherAriaLabel ?? RadioOtherInput.DefaultAriaLabel)
                                                             CommitAttributes=@OtherInputAttribute />
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </InputRadioGroup>
            }
            else
            {
                @* The "Other: text" form needs BOTH conditions -- gating on the enum value alone
                   rendered a dangling "Other: " whenever the free-text box was left empty. *@
                <ReadOnlyValue Id=@_id
                               CssClass=@CssClass
                               Text=@(IsOtherSelected && !string.IsNullOrEmpty(OtherValue) ? $"{Value?.GetName()}: {OtherValue}" : Value?.GetName()) />
                }

            <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
            <BoundValueDisplay Text=@CurrentValueAsString />
        </fieldset>
    </div>
}
