@typeparam TItem

@if (ShowEditor)
{
    <div class=@(IsHorizontal ? "edit-checkedList-checkboxes-container-horizontal" : "edit-checkedList-checkboxes-container-vertical")>
        @for (var i = 0; i < Options.Count; i++)
        {
            var option = Options[i];
            var optionId = $"cbx-{Id}-{OptionIds[i]}";
            var isOptionDisabled = IsDisabled || IsOptionDisabled?.Invoke(option) == true;
            @* Keyed on the rendered element id, not the option value: OptionIds comes from
               EnumHelpers.ToUniqueIds, so it is distinct by construction, while the option value is
               not -- alias enum members (Active = 1, Enabled = 1) and a duplicate entry in a
               consumer's string Options list both yield equal values, and Blazor throws on duplicate
               @key siblings at the first re-render (the first render succeeds, the first click
               crashes). The radio/select option lists carry no @key and survived the same input. *@
            <label @key="optionId" class=@($"edit-checkbox-label{(UseStyledCheckbox ? " edit-checkbox-label-styled" : "")} {LabelClass}") for=@optionId>
                @if (UseStyledCheckbox)
                {
                    <span class="edit-checkbox-wrap">
                        <input type="checkbox"
                               value=@option
                               checked="@(Value?.Contains(option) == true)"
                               disabled=@isOptionDisabled
                               aria-disabled=@(isOptionDisabled ? "true" : null)
                               aria-invalid=@(IsInvalid ? "true" : null) aria-describedby=@DescribedBy
                               tabindex="0"
                               @onchange="() => OnToggle.InvokeAsync(option)"
                               id=@optionId
                               data-test-id=@optionId
                               class="edit-checkedList-checkbox edit-checkbox-input-styled @FieldCssClass" />
                        <span class="edit-checkbox-box" aria-hidden="true"></span>
                    </span>
                }
                else
                {
                    <input type="checkbox"
                           value=@option
                           checked="@(Value?.Contains(option) == true)"
                           disabled=@isOptionDisabled
                           aria-disabled=@(isOptionDisabled ? "true" : null)
                           aria-invalid=@(IsInvalid ? "true" : null) aria-describedby=@DescribedBy
                           tabindex="0"
                           @onchange="() => OnToggle.InvokeAsync(option)"
                           id=@optionId
                           data-test-id=@optionId
                           class="edit-checkedList-checkbox @FieldCssClass" />
                }
                @DisplayText(option)
            </label>
        }
    </div>
}
else
{
    @if (Value is null || Value.Count == 0)
    {
        <ReadOnlyValue Id=@Id CssClass=@FieldCssClass Text=""/>
    }
    else
    {
        @for (var i = 0; i < Value.Count; i++)
        {
            var option = Value[i];
            <ReadOnlyValue Id=@($"{Id}-option-{SelectedIds[i]}") HasLabelElement="false" CssClass=@FieldCssClass Text=@DisplayText(option)/>
        }
    }
}
