@inherits EditTextInputBase

@if (ShouldShowComponent())
{
    @* The consumer's `style` lands on the wrapper (one rule for every control -- see EditControlBase's
       unmatched-attribute remarks); the remaining unmatched attributes go on the <input> below. *@
    <div class="edit-control-wrapper @ContainerClass"
         style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">

        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label LabelContent=@LabelContent IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@ShowEditor />

        @if (ShowEditor)
        {
            <EditInputShell IsInvalid=@IsInvalid
                            IsDisabled=@IsDisabled
                            WrapperClass=@(EditInputShell.SizeClass(Size))
                            Prefix=@Prefix
                            Suffix=@Suffix
                            AllowClear=@AllowClear
                            IsClearable=@IsClearable
                            OnClear=@Clear
                            ClearButtonLabel=@EffectiveClearButtonLabel
                            CountText=@CountText
                            CountId=@CountId
                            CountAccessibleText=@CountAccessibleText
                            CountLimitStatus=@CountLimitStatus
                            ShowPasswordToggle=@EffectiveIsPassword
                            IsPasswordRevealed=@_passwordRevealed
                            OnTogglePassword=@TogglePasswordVisibility
                            ShowPasswordButtonLabel=@EffectiveShowPasswordButtonLabel>
                @* One @attributes per element, so the consumer's unmatched attributes, this control's
                   own oninput handler, and its `list` contribution are all merged into EditorAttributes
                   (the control's own win) -- and the splat is FIRST, so every explicitly-written
                   attribute below, including the ones @bind-value emits, wins over a consumer's. `class`
                   travels CssClass and `style` the wrapper, so AttributeSplat withholds both; a null
                   merge emits no frames at all. `list` rides the merged dictionary rather than its own
                   explicit attribute below deliberately -- see EditorAttributes'/
                   SuggestionsInputAttributes' remarks: an explicit frame wins outright over an earlier
                   same-named one even when its own value is null, which would erase a consumer's
                   splatted `list` the instant Suggestions is unset. *@
                <input @attributes="EditorAttributes"
                       @bind-value="CurrentValue"
                       @bind-value:event="@UpdateEventName"
                       @bind-value:after="OnValueCommittedAsync"
                       @ref="_editorRef"
                       disabled=@IsDisabled
                       id=@_id
                       data-test-id=@_id
                       class=@InputClass
                       placeholder=@EffectivePlaceholder
                       maxlength=@EffectiveMaxLength
                       type=@(EffectiveIsPassword ? (_passwordRevealed ? "text" : "password") : null)
                       aria-labelledby="lbltext-@_id"
                       aria-invalid=@(IsInvalid ? "true" : null)
                       aria-required=@_isRequired
                       aria-describedby=@_describedBy
                       aria-errormessage=@(IsInvalid ? _errorMsgId : null)
                       autocomplete=@EffectiveAutocomplete />
            </EditInputShell>
            @* Invisible sibling, deliberately NOT inside the shell: a closed <datalist> has no box per
               spec, so it needs no place in the Prefix/Suffix/clear-button/count/password-toggle layout
               EditInputShell owns -- adding it there would risk disturbing that locked order for zero
               visual gain. Gated on SuggestionsListId, not Suggestions directly, so the password
               suppression (see EffectiveSuggestions) also skips rendering this dead markup. *@
            @if (SuggestionsListId is not null)
            {
                <datalist id="@SuggestionsListId">
                    @foreach (var suggestion in EffectiveSuggestions!)
                    {
                        <option value="@suggestion"></option>
                    }
                </datalist>
            }
        }
        else
        {
            <!-- Read-Only Views -->
            @* Both special read-only views need a value to put in them. With none, the masked view is
               an empty span next to an eye toggle that reveals nothing, and the link is an invisible
               but still-clickable <a>. An empty value therefore falls through to the plain read-only
               value, which has its own reserved-space placeholder.

               The mask is EffectiveMaskText, not MaskText: a password field masks here too (with a
               bullet), because read-only is not a reason to print a secret in the clear. A set
               MaskText still wins -- see EffectiveMaskText.

               IsNullOrEmpty, not IsNullOrWhiteSpace, on the mask: an all-whitespace MaskText is still
               a mask the consumer asked for. Skipping the masked branch for one printed the raw value
               instead -- a silent disclosure -- and disagreed with GetMaskValue's own guard. Note the
               link branch below needs no mask check: it is only reachable when the branch above was
               declined, and with a non-empty value that can only mean an empty effective mask (so a
               password field never renders as a link either). *@
            @if (!string.IsNullOrEmpty(EffectiveMaskText) && !string.IsNullOrEmpty(Value))
            {
                @* Masked read-only row, with the eye toggle that reveals the real value.

                   ONE render site, with the hidden/revealed difference expressed as ternaries on the
                   attributes and text -- never two sibling @if/@else blocks calling a shared
                   RenderFragment. Each `@Fragment(...)` call site is its own render REGION, so the
                   two-block shape made toggling a remove-and-reinsert: the focused <button> was
                   destroyed and rebuilt, focus fell to <body> mid-gesture, and a screen reader's
                   virtual buffer reset. With a single site the diff patches this element's
                   attributes/text in place and the button the user is standing on survives.

                   role="group": a bare <div> is role-generic, where ARIA prohibits naming -- the
                   aria-labelledby below was inert. The row genuinely groups a value with the control
                   that reveals it, so `group` is both accurate and nameable, and it can carry the
                   field's aria-describedby the same way the link branch does.

                   The toggle's aria-label is CONSTANT (EffectiveShowValueButtonLabel, "Show {label}
                   value" by default -- folding the field's label in so two masked fields on one form
                   don't render two identically-named toggles, TXT-4) with aria-pressed carrying the
                   state. A toggle whose name AND pressed state both flip is ambiguous -- "Hide
                   value, pressed" reads as "hiding is already in effect" to some users and "press to
                   hide" to others. Name the action, let aria-pressed carry the state.

                   The live region announces only WHICH state the row is in, never the value itself:
                   a masked value is by definition something the page was asked not to show, and an
                   aria-live region holding it would have it read aloud on every toggle. *@
                <div class="edit-masked-value @CssClass"
                     id=@_id
                     data-test-id=@_id
                     role="group"
                     aria-labelledby="lbltext-@_id"
                     aria-describedby=@_describedBy>
                    <span class="edit-readonly-value">@(_showMaskedValue ? Value : GetMaskValue())</span>
                    <button type="button"
                            aria-label="@EffectiveShowValueButtonLabel"
                            aria-pressed=@(_showMaskedValue ? "true" : "false")
                            class=@(_showMaskedValue ? "edit-icon-eye" : "edit-icon-eye-invisible")
                            @onclick="ToggleMaskedValue">
                        @(_showMaskedValue ? EditIcons.Eye : EditIcons.EyeInvisible)
                    </button>
                    <span class="edit-sr-only" role="status">@(_showMaskedValue ? "Value shown" : "Value hidden")</span>
                </div>
            }
            else if (SafeUrl != null && !string.IsNullOrEmpty(Value))
            {
                @* aria-labelledby lists the label AND the link's own id. Naming a link with the
                   label alone OVERWRITES its text, so every URL field announced as just "Email" --
                   two same-labeled fields in a list were indistinguishable, and the destination the
                   user is about to navigate to was never spoken (2.4.4 / 2.5.3: the visible text
                   must be part of the name). Referencing the element's own id is legal ARIA and
                   concatenates the link text after the label. *@
                <a class="edit-string-link @CssClass"
                   id=@_id
                   data-test-id=@_id
                   aria-describedby=@_describedBy
                   aria-labelledby="lbltext-@_id @_id"
                   href=@SafeUrl
                   target=@UrlTarget
                   rel=@UrlRel>
                    @Value
                    @if (OpensInNewTab)
                    {
                        @* A link that swaps the browsing context out from under the user has to say
                           so before it is followed. Visually hidden -- sighted users get the
                           convention from the target itself -- and it rides inside the <a>, so the
                           self-reference above folds it into the accessible name for free. *@
                        <span class="edit-sr-only"> (opens in new tab)</span>
                    }
                </a>
            }
            else
            {
                <ReadOnlyValue Id=@_id CssClass=@CssClass Text=@Value AriaDescribedBy=@_describedBy />
            }
        }
        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />

        <BoundValueDisplay Text=@BoundValueText />
    </div>
}