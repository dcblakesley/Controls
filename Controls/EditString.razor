@inherits EditTextInputBase

@if (ShouldShowComponent())
{
    <div class="edit-control-wrapper @ContainerClass">

        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@ShowEditor />

        @if (ShowEditor)
        {
            <EditInputShell IsInvalid=@IsInvalid
                            IsDisabled=@IsDisabled
                            WrapperClass=@(EditInputShell.SizeClass(Size))
                            Prefix=@Prefix
                            Suffix=@Suffix
                            AllowClear=@AllowClear
                            IsClearable=@IsClearable
                            OnClear=@Clear
                            CountText=@CountText
                            ShowPasswordToggle=@EffectiveIsPassword
                            IsPasswordRevealed=@_passwordRevealed
                            OnTogglePassword=@TogglePasswordVisibility>
                <input @bind-value="CurrentValue"
                       @bind-value:event="@UpdateEventName"
                       @ref="_editorRef"
                       disabled=@IsDisabled
                       id=@_id
                       data-test-id=@_id
                       class=@InputClass
                       placeholder=@EffectivePlaceholder
                       maxlength=@EffectiveMaxLength
                       type=@(EffectiveIsPassword ? (_passwordRevealed ? "text" : "password") : null)
                       aria-invalid=@(IsInvalid ? "true" : null)
                       aria-required=@_isRequired
                       aria-describedby=@_describedBy
                       aria-errormessage=@(IsInvalid ? _errorMsgId : null)
                       autocomplete=@EffectiveAutocomplete />
            </EditInputShell>
        }
        else
        {
            <!-- Read-Only Views -->
            @* IsNullOrEmpty, not IsNullOrWhiteSpace: an all-whitespace MaskText is still a mask the
               consumer asked for. Skipping the masked branch for one printed the raw value instead --
               a silent disclosure -- and disagreed with GetMaskValue's own IsNullOrEmpty guard. *@
            @if (!string.IsNullOrEmpty(MaskText))
            {
                <!-- Masks with eye icons to show/hide masked text in EditMode  -->
                @if (!_showMaskedValue)
                {
                    @MaskedValueRow(GetMaskValue(), "Show value", "edit-icon-eye-invisible", EditIcons.EyeInvisible)
                }
                else
                {
                    @MaskedValueRow(Value, "Hide value", "edit-icon-eye", EditIcons.Eye)
                }
            }
            else
            {
                @if (SafeUrl != null)
                {
                    <a class="edit-string-link @CssClass"
                       id=@_id
                       data-test-id=@_id
                       aria-describedby=@_describedBy
                       aria-labelledby="lbl-@_id"
                       href=@SafeUrl
                       target=@UrlTarget
                       rel=@UrlRel>
                        @Value
                    </a>
                }
                else
                {

                    <ReadOnlyValue Id=@_id CssClass=@CssClass Text=@Value />
                }
            }
        }
        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />

        <BoundValueDisplay Text=@CurrentValueAsString />
    </div>
}

@code {
    // Shared by both masked-value read-only rows above -- identical markup, differing only in which
    // text shows and the eye-toggle button's label/class/icon (revealed vs. hidden).
    RenderFragment MaskedValueRow(string? text, string toggleAriaLabel, string iconClass, MarkupString icon) =>
        @<div class="edit-masked-value" id=@_id data-test-id=@_id aria-labelledby="lbl-@_id">
            <span class="edit-readonly-value">@text</span>
            <button type="button" aria-label="@toggleAriaLabel" class="@iconClass" @onclick=@(() => _showMaskedValue = !_showMaskedValue)>
                @icon
            </button>
        </div>;
}