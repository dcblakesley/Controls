@* Shared wrapper around a single editor element (<input>/<textarea>/<InputDate>) for EditString,
   EditNumber, EditTextArea, and EditDateNative. Renders one of two structures:

   - Legacy mode (no affix content requested): today's plain markup —
     <div class="edit-input-with-icon">ChildContent<InvalidIcon /></div>. The host keeps its own
     inline `padding-inline-end: 2rem` on the editor in this mode.
   - Affix mode (Prefix/Suffix/AllowClear/CountText/ShowPasswordToggle in use): the AntD-style
     affix wrapper, with the clear button, count, custom suffix, password toggle, and InvalidIcon
     inside a single trailing <span class="edit-input-suffix"> in that locked order. The host drops
     its inline padding and adds the `edit-affix-input` class to the editor in this mode (see
     <see cref="UsesAffixLayout"/>). When <see cref="CountBelow"/> is also set (EditTextArea), the
     count instead renders as a second, trailing <span class="edit-textarea-count"> sibling of the
     suffix span — its own line under the editor, matching AntD TextArea's showCount placement —
     and is omitted from inside <span class="edit-input-suffix">.

   Slice S4 additions (opt-in `.edit-theme`, Size): the affix wrapper also carries
   `edit-input-affix-disabled` while <see cref="IsDisabled"/> is set, and whatever
   <see cref="WrapperClass"/> the host passes (its Size token) -- both no-ops unthemed, styled only
   under `.edit-theme` (see edit-controls.css's opt-in theme section).

   See CLAUDE.md's CSS section and edit-controls.css's "Input + InvalidIcon wrapper" comment for the
   structural contract this markup must not silently drift from. *@

@if (UseAffixLayout)
{
    <div class="edit-input-affix-wrapper @(IsInvalid ? "edit-input-affix-invalid" : null) @(IsDisabled ? "edit-input-affix-disabled" : null) @WrapperClass">
        @if (Prefix is not null)
        {
            <span class="edit-input-prefix">@Prefix</span>
        }
        @ChildContent
        <span class="edit-input-suffix">
            @if (IsClearable)
            {
                <button type="button" class="edit-input-clear" aria-label="@(ClearButtonLabel ?? "Clear")" @onclick="OnClear">
                    @EditIcons.ClearCircle
                </button>
            }
            @if (CountText is not null && !CountBelow)
            {
                <span class="edit-input-count" aria-hidden="true">@CountText</span>
            }
            @if (Suffix is not null)
            {
                @Suffix
            }
            @if (ShowPasswordToggle)
            {
                @* disabled, not hidden: the button keeps its place so the field's chrome doesn't
                   reflow when a form disables it, but a disabled field's secret must not be
                   revealable -- and native `disabled` also drops the button out of the tab order,
                   so AT no longer offers a control inside a field it announces as unavailable.

                   The aria-label is CONSTANT and names the action; aria-pressed carries the state.
                   A toggle whose name and pressed state both flip is ambiguous -- "Hide value,
                   pressed" reads as "hiding is already in effect" to some users and "press to hide"
                   to others. Same rule as EditString's masked-row eye toggle. *@
                <button type="button" class="edit-input-password-toggle"
                        disabled="@IsDisabled"
                        aria-label="@(ShowPasswordButtonLabel ?? "Show password")"
                        aria-pressed="@(IsPasswordRevealed ? "true" : "false")"
                        @onclick="OnTogglePassword">
                    @(IsPasswordRevealed ? EditIcons.Eye : EditIcons.EyeInvisible)
                </button>
            }
            <InvalidIcon IsInvalid=@IsInvalid />
        </span>
        @if (CountText is not null && CountBelow)
        {
            <span class="edit-textarea-count" aria-hidden="true">@CountText</span>
        }
        @if (CountText is not null && CountId is not null)
        {
            @* The counter's assistive-tech half, in ONE place regardless of which visible placement
               above is in use: both spans are visually hidden and out of flow, so their position in
               the wrapper is irrelevant, and aria-describedby is a reference, not a reading-order
               claim. The visible span is aria-hidden because "12 / 100" is read as "twelve slash one
               hundred" (or just "twelve one hundred") and, worse, was never part of the field's
               description at all -- audible as orphan noise in browse mode, absent on focus.

               The status region renders whenever the counter does, even while it has nothing to say:
               a live region has to be in the DOM before its content changes, or the first
               announcement -- the one that matters, at the limit -- is the one that gets missed. *@
            <span class="edit-sr-only" id="@CountId">@CountAccessibleText</span>
            <span class="edit-sr-only" role="status">@CountLimitStatus</span>
        }
    </div>
}
else
{
    <div class="edit-input-with-icon">
        @ChildContent
        <InvalidIcon IsInvalid=@IsInvalid />
    </div>
}
