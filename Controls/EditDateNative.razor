@typeparam T
@inherits EditTextControlBase<T>

@if (ShouldShowComponent())
{
    @* The consumer's `style` lands on the wrapper (one rule for every control -- see EditControlBase's
       unmatched-attribute remarks); the remaining unmatched attributes go on the <input> below, whose
       own inline style is the control's (the calendar-icon padding reserve). *@
    <div class="edit-control-wrapper @ContainerClass"
         style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">
        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@ShowEditor />

        @if (ShowEditor)
        {
            <EditInputShell IsInvalid=@IsInvalid
                            IsDisabled=@IsDisabled
                            WrapperClass=@(EditInputShell.SizeClass(Size))>
                @* Splat first so every explicit attribute below wins.

                   aria-labelledby points at FormLabel's lbltext-{id} naming anchor rather than
                   relying on the label[for] association alone: the <label> also contains the tooltip
                   TRIGGER, whose own accessible name is concatenated into the field's name by the
                   label[for] path ("Birth Date More information about Birth Date"). The anchor holds
                   the label text only. It never dangles -- FormLabel renders it in every mode,
                   visually hidden alongside a hidden label. *@
                <input @attributes="AttributeSplat.Rest(AdditionalAttributes)"
                       type=@HtmlInputType
                       @ref="_editorRef"
                       @bind-value=@CurrentValueAsString
                       @bind-value:event="@UpdateEventName"
                       class=@InputClass
                       style="padding-inline-end: 2rem"
                       id=@_id
                       data-test-id=@_id
                       min=@MinAttribute
                       max=@MaxAttribute
                       disabled=@IsDisabled
                       aria-labelledby="lbltext-@_id"
                       aria-required=@_isRequired
                       aria-invalid=@(IsInvalid ? "true" : null)
                       aria-describedby=@EffectiveDescribedBy
                       aria-errormessage=@(IsInvalid ? _errorMsgId : null) />
            </EditInputShell>

            @* Type="Month"'s typed-entry format, for AT only (see FormatHintLabel's remarks for why
               only that type gets one): a browser without native month support renders a plain text
               box here, with no affordance for the strict invariant yyyy-MM the parse demands.
               Outside the shell so the shell's own layout is untouched -- the span is
               position:absolute anyway (.edit-sr-only). *@
            @if (FormatHintText is { Length: > 0 } formatHint)
            {
                <span class="edit-sr-only" id="@FormatHintId">@formatHint</span>
            }
        }
        else
        {
            <ReadOnlyValue Id=@_id CssClass=@CssClass Text=@GetDisplayValue() />
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
        <BoundValueDisplay Text=@CurrentValueAsString />
    </div>
}

@code {
    string HtmlInputType => EffectiveType switch
    {
        InputDateType.Date => "date",
        InputDateType.DateTimeLocal => "datetime-local",
        InputDateType.Month => "month",
        InputDateType.Time => "time",
        _ => "date"
    };
}
