<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- No GeneratePackageOnBuild: it conflicts with `dotnet pack` on a multi-targeted Razor class
         library (NU5026/NU5019 from clean) and the documented publish uses `dotnet pack -o ./nupkg`
         then `nuget push nupkg/...`, which never reads the bin/Release package anyway. -->
    <Title>Blazor Controls</Title>
    <PackageId>WssBlazorControls</PackageId>
	  <AssemblyVersion>10.6.8</AssemblyVersion>
	  <FileVersion>$(AssemblyVersion)</FileVersion>
	  <Version>$(AssemblyVersion)</Version>

    <!-- Build hygiene: the changelog promises 0 warnings — enforce it. CS1591 excepted: the public
         surface is heavily XML-documented but not exhaustively, and missing-comment noise would
         drown real warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Ship the XML docs so consumers get IntelliSense from the package. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Debuggability + reproducibility: SourceLink is built into the .NET 8+ SDK; publish the
         repo URL, ship a .snupkg symbol package, and make CI builds deterministic. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Catches binary/source breaking changes against the previous published version at pack time. -->
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- Trimming / WASM AOT support. IsAotCompatible turns on IsTrimmable (the assembly-level
         [AssemblyMetadata("IsTrimmable","True")] that lets a consumer's trimmed publish actually trim
         this library) plus the trim/AOT/single-file Roslyn analyzers. With TreatWarningsAsErrors
         above, any new IL2xxx/IL3xxx regression fails the build. The reflection the library does
         (attribute reads via Field expressions, enum member lookups) is annotated or provably
         rooted — see EnumHelpers/FieldValidationDisplay for the reasoning. -->
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Package Metadata -->
    <PackageDescription>A comprehensive library of form controls for Blazor applications, providing consistent, feature-rich input components with built-in validation, accessibility support, and flexible styling options.</PackageDescription>
    <PackageProjectUrl>https://github.com/dcblakesley/Controls</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- SPDX expression (was PackageLicenseFile) so NuGet.org indexes/filters the license properly. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/dcblakesley/Controls</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor;controls;forms;validation;accessibility;ui;components;webassembly;server</PackageTags>
    <PackageReleaseNotes>10.6.8 - New (Edit Controls): UpdateTrigger enum + UpdateOn parameter (plus FormDefaults.UpdateOn) to choose commit-on-keystroke vs. commit-on-blur/Enter for EditString/EditTextArea/EditNumber/EditDate/the Radio "Other" box; [Placeholder("...")] model attribute (with [Display(Prompt)] fallback) honored by EditString/EditTextArea/EditNumber/EditDatePicker/EditDateRange/EditSelectSearch/EditMultiSelect/EditSelectEnum/EditSelectString. New (UI Kit): Select.AriaErrorMessage, forwarded by EditSelectSearch/EditMultiSelect, plus aria-errormessage on EditFile. Changed: default checkbox/radio label spacing now matches AntD's 8px flex-row gap for every EditBool/EditCheckedStringList/EditCheckedEnumList/EditRadioString/EditRadioEnum/EditRadio label, not just the UseStyledCheckbox variant — a visible default-rendering change for every consumer; EditSelectSearch.Placeholder/EditMultiSelect.Placeholder are now string? (previously string, defaulted to "Please select"). Fixed: the new flex checkbox/radio labels are hardened against a consumer's own input flex/margin resets; EditSelectEnum ports EditSelectString's no-JS selected-option fallback for prerender/no-JS rendering; the Select engine's value-to-label lookup is unified across Select/EditSelectSearch/EditMultiSelect, fixing label drift on a duplicate-valued option list; SearchInput's clear/search buttons no longer collapse under a consumer's button height reset; the JS overlay positioning helpers are consolidated, fixing inconsistent dropdown/panel flip-to-fit behavior. Internal refactors (shared bases/components, CSS/JS/icon dedup, hoisted e2e scaffolding) and dependency/test-infra bumps (ASP.NET Core Components, bUnit, Playwright) with no consumer-facing API change. See the README changelog for details.</PackageReleaseNotes>
    <Authors>dcblakesley</Authors>
    <Company>WSS</Company>
    <Copyright>Copyright (c) 2025 WssBlazorControls</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include README and the package icon (license is declared via PackageLicenseExpression) -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
  </ItemGroup>

</Project>
