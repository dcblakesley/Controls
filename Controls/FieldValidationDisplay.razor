@* GetValidationMessages is a lazy yield-return iterator over EditContext's internal field-state
   dictionary — enumerating it separately for the sr-only region below and the visible region
   further down would rescan that dictionary twice per render. Materialized once instead so both
   regions enumerate the same in-memory list. *@
@{ List<string> messages = EditContext?.GetValidationMessages(FieldIdentifier).ToList() ?? []; }
<!-- Screen readers -->
<div class="edit-validation-message edit-sr-only"
     id="error-msg-@Id"
     data-test-id="error-msg-@Id"
     aria-live="polite"
     aria-atomic="true">
    @* Enumerate this field's messages directly — the empty case renders nothing, so no guard is
       needed, and the no-arg GetValidationMessages() (a whole-form scan) is avoided. A null
       EditContext (control used outside an EditForm) simply has no messages. *@
    @* One element per message — adjacent text nodes ran together ("RequiredMust be between…"). *@
    @foreach (var x in messages)
    {
        <div>@GetValidationMessage(x, true)</div>
    }
</div>

<!-- non-screen readers -->
@* aria-hidden because the sr-only region above already carries every one of these messages, in a
   fuller (field-named) form. Without it a screen reader in browse mode walked straight through both
   copies and read every validation error twice. Safe to hide: this container holds text only -- no
   focusable content, which is the one thing aria-hidden must never swallow. *@
<div class="edit-validation-message" aria-hidden="true">
    @foreach (var x in messages)
    {
        <div>@GetValidationMessage(x)</div>
    }
</div>
