@namespace Controls
@inherits PopupOverlayBase

<span @attributes="AttributeSplat.Rest(AdditionalAttributes)"
      class="wss-popover-wrap @AttributeSplat.ConsumerClass(AdditionalAttributes)"
      style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">
    @* The consumer's ChildContent normally holds the interactive trigger (e.g. a <button>): its
       native activation bubbles here as a click, so this wrapper carries no button semantics of its
       own (it used to be role="button", nesting a button inside a button — two tab stops, invalid
       ARIA). wss-overlay.js mirrors the popup ARIA onto that child, or promotes this span to the
       button role when the content has nothing focusable. While open, keydown must not bubble
       further (an Escape meant for this popover would also close an enclosing Modal/Drawer);
       while closed it bubbles normally. *@
    <span class="wss-popover-trigger" @ref="_triggerRef"
          @onclick="ToggleAsync" @onkeydown="OnTriggerKeyDownAsync" @onkeydown:stopPropagation="@_open">@ChildContent</span>
    @if (_open)
    {
        @* tabindex="-1": iOS-class WebKit only synthesizes a click from a tap on a focusable/
           interactive target chain — without it a backdrop tap never reaches @onclick on touch. *@
        <div class="wss-popover-backdrop" tabindex="-1" @onclick="CloseAsync"></div>
        <div class="wss-popover wss-popover-@(_resolvedPlacement ?? PlacementName) @(_positioned ? null : "wss-measuring")"
             @ref="_panelRef" id="@PanelId" role="dialog" tabindex="-1"
             aria-labelledby="@(HasTitle ? $"{_id}-title" : null)"
             aria-label="@(HasTitle ? null : AriaLabel ?? "Popover")"
             aria-describedby="@($"{_id}-content")"
             @onkeydown="OnPanelKeyDown"
             @onkeydown:stopPropagation="true"
             @onclick:stopPropagation="true">
            <div class="wss-popover-inner">
                @if (HasTitle)
                {
                    <div class="wss-popover-title" id="@($"{_id}-title")">@(TitleContent ?? (RenderFragment)(b => b.AddContent(0, Title)))</div>
                }
                <div class="wss-popover-content" id="@($"{_id}-content")">@Content</div>
            </div>
            <span class="wss-popover-arrow"></span>
        </div>
    }
</span>

@code {
    /// <summary>Plain-text popover title.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Rich popover title; overrides <see cref="Title"/> when set.</summary>
    [Parameter] public RenderFragment? TitleContent { get; set; }
    /// <summary>The popover body.</summary>
    [Parameter] public RenderFragment? Content { get; set; }
    /// <summary>The trigger element.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Preferred side of the trigger for the panel; flips/shifts to stay within the viewport. Defaults to <see cref="PopupPlacement.Top"/>.</summary>
    [Parameter] public PopupPlacement Placement { get; set; } = PopupPlacement.Top;
    /// <summary>
    /// Controls the popover's open state (two-way bindable via <c>@bind-Visible</c>). While
    /// <see cref="VisibleChanged"/> has a delegate, this becomes the source of truth: an external
    /// change routes through the same open/close path as user interaction (JS placement/focus still
    /// run), and every open/close (external or internal) raises <see cref="VisibleChanged"/> back. An
    /// echo of a value this component just raised is recognized and ignored. With no delegate on
    /// <see cref="VisibleChanged"/> (the default, uncontrolled case), this parameter is inert.
    /// Unlike <see cref="Popconfirm"/>, <c>Popover</c> has no <c>Disabled</c> parameter, so a
    /// controlled <see cref="Visible"/> has no disabled-state guard to respect.
    /// </summary>
    [Parameter] public bool Visible { get; set; }
    /// <summary>Raised on every open/close (external or internal). Supports <c>@bind-Visible</c>; see <see cref="Visible"/>.</summary>
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    /// <summary>
    /// Accessible name used when no <see cref="Title"/>/<see cref="TitleContent"/> is supplied.
    /// Defaults to "Popover" — a <c>role="dialog"</c> must never be nameless (axe
    /// <c>aria-dialog-name</c>), so set this whenever an untitled popover needs a meaningful name.
    /// Ignored when a title is present (the title labels the dialog instead).
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>
    /// Unmatched attributes (e.g. a consumer's <c>class</c>, <c>style</c>, or <c>data-*</c>),
    /// applied to the outer wrapper (<c>.wss-popover-wrap</c>) — never the floating panel, whose
    /// inline placement (z-index, <c>--wss-shift</c>) is JS-owned. <c>class</c> and <c>style</c>
    /// merge with the component's own; the rest are splatted verbatim.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    readonly string _id = $"wss-popover-{Guid.NewGuid():N}";

    /// <inheritdoc/>
    protected override string PanelId => $"{_id}-panel";

    protected override string PlacementName => Placement.ToString().ToLowerInvariant();
    protected override string PanelClassPrefix => "wss-popover";
    protected override bool TriggerDisabled => false; // Popover has no Disabled parameter
    protected override Task InvokeVisibleChangedAsync(bool open) =>
        VisibleChanged.HasDelegate ? VisibleChanged.InvokeAsync(open) : Task.CompletedTask;
    protected override async Task FocusPanelAsync()
    {
        try { await _panelRef.FocusAsync(); } catch { /* not focusable yet (prerender/tests) */ }
    }

    bool HasTitle => TitleContent != null || !string.IsNullOrEmpty(Title);

    // Escape must also work once focus has moved into the panel — the panel is a sibling of the
    // trigger, so a keydown there never bubbles to the trigger's handler.
    async Task OnPanelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseAsync();
    }

    // Controlled Visible/VisibleChanged, mirroring Select's controlled Open/OpenChanged design (see
    // SelectControlledOpenTests). Popover has no Disabled parameter, so — unlike Popconfirm — there
    // is no disabled-state invariant to enforce here.
    protected override async Task OnParametersSetAsync()
    {
        if (!VisibleChanged.HasDelegate)
        {
            // Uncontrolled (the default): Visible is inert. Reset so a consumer that later wires
            // VisibleChanged starts a fresh controlled session instead of comparing against a stale value.
            _lastVisibleParam = null;
            return;
        }

        if (_lastVisibleParam == Visible) return; // unchanged since we last observed/raised it (includes our own echo)
        _lastVisibleParam = Visible;

        if (Visible == _open) return; // already in the requested state
        await SetOpenAsync(Visible);
    }
}
