@namespace Controls

@if (!_closed)
{
<div @attributes="AttributeSplat.Rest(AdditionalAttributes)"
     class="wss-alert wss-alert-@TypeName @(HasDescription ? "wss-alert-with-description" : null) @(Banner ? "wss-alert-banner" : null) @AttributeSplat.ConsumerClass(AdditionalAttributes)"
     style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)"
     role="@(Live ? (EffectiveType == AlertType.Error ? "alert" : "status") : "group")"
     aria-live="@(Live ? (EffectiveType == AlertType.Error ? "assertive" : "polite") : null)">
    @if (ShowIcon)
    {
        <span class="wss-alert-icon">@Icon</span>
    }
    <div class="wss-alert-content">
        <div class="wss-alert-message"><span class="wss-sr-only">@SeverityAnnouncement</span>@(MessageContent ?? (RenderFragment)(b => b.AddContent(0, Message)))</div>
        @if (HasDescription)
        {
            <div class="wss-alert-description">@Description</div>
        }
    </div>
    @if (Action is not null)
    {
        <div class="wss-alert-actions">
            <span class="wss-alert-action">@Action</span>
            @if (Closable)
            {
                <button type="button" class="wss-alert-close" aria-label="@CloseButtonLabel" @onclick="OnCloseClicked">
                    @UiKitIcons.CloseCross
                </button>
            }
        </div>
    }
    else if (Closable)
    {
        <button type="button" class="wss-alert-close" aria-label="@CloseButtonLabel" @onclick="OnCloseClicked">
            @UiKitIcons.CloseCross
        </button>
    }
</div>
}

@code {
    /// <summary>
    /// Severity of the alert (colors, icon, and screen-reader politeness — <see cref="AlertType.Error"/>
    /// announces assertively). Defaults to <see cref="AlertType.Info"/> — except in <see cref="Banner"/>
    /// mode, where a Type left unset resolves to <see cref="AlertType.Warning"/> instead (see
    /// <see cref="EffectiveType"/>), matching AntD's banner default; a Type set explicitly (even to
    /// <see cref="AlertType.Info"/>) is always honored.
    /// </summary>
    [Parameter] public AlertType Type { get; set; } = AlertType.Info;
    /// <summary>Plain-text message line.</summary>
    [Parameter] public string? Message { get; set; }
    /// <summary>Optional rich message content; overrides <see cref="Message"/> when set.</summary>
    [Parameter] public RenderFragment? MessageContent { get; set; }
    /// <summary>Optional detail text rendered below the message (switches to the larger "with description" layout).</summary>
    [Parameter] public string? Description { get; set; }
    /// <summary>Shows the severity icon. Defaults to true.</summary>
    [Parameter] public bool ShowIcon { get; set; } = true;
    /// <summary>Shows a close button that hides the alert.</summary>
    [Parameter] public bool Closable { get; set; }
    /// <summary>Raised after the close button hides the alert (a notification — the alert hides itself regardless).</summary>
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Full-width, borderless/no-radius banner mode (AntD's <c>Alert banner</c>). See
    /// <see cref="Type"/> for how the default severity resolves while this is true.</summary>
    [Parameter] public bool Banner { get; set; }
    /// <summary>Optional trailing action slot rendered before the close button — grouped with it in a
    /// <c>wss-alert-actions</c> wrapper only when set (unset markup is unchanged).</summary>
    [Parameter] public RenderFragment? Action { get; set; }

    /// <summary>
    /// Whether the alert announces itself as a live region on mount: <c>role="status"</c>/
    /// <c>"alert"</c> (per <see cref="EffectiveType"/>) plus a matching <c>aria-live</c>. Defaults to
    /// true, matching the toast/notification convention. Set false for an alert that renders once and
    /// then sits on the page for a long time (a persistent banner, an inline validation summary that
    /// mounts before the user has done anything) — with <c>Live</c> true, assistive tech re-announces
    /// the whole thing on every mount (e.g. a route change that re-creates this component), which for
    /// content the user hasn't just triggered is noise rather than a notification. False renders
    /// <c>role="group"</c> instead (still its own landmark for the icon/message/description) and omits
    /// <c>aria-live</c> entirely.
    /// </summary>
    [Parameter] public bool Live { get; set; } = true;

    /// <summary>Accessible name of the close button. Override to localize.</summary>
    [Parameter] public string CloseButtonLabel { get; set; } = "Close";

    /// <summary>
    /// Overrides the sr-only severity word prepended to the message (see
    /// <see cref="SeverityAnnouncement"/>). Null (default) keeps the built-in English word for
    /// <see cref="EffectiveType"/> ("Success", "Info", "Warning", "Error"). Set to localize --
    /// pass just the word; the component still appends the trailing ": " separator.
    /// </summary>
    [Parameter] public string? SeverityLabel { get; set; }

    /// <summary>
    /// Unmatched attributes (e.g. a consumer's <c>class</c>, <c>style</c>, or <c>data-*</c>),
    /// applied to the component's root element. <c>class</c> and <c>style</c> merge with the
    /// component's own; the rest are splatted verbatim.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    // Component parameters must stay plain auto-properties (BL0007), so the "was Type explicitly
    // passed" check lives here instead of in Type's own setter: SetParametersAsync sees the raw
    // incoming ParameterView (keyed by the consumer's actual markup) before base assigns Type, so
    // this is only true when the CURRENT render's parent markup includes Type="...".
    bool _typeSet;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        _typeSet = parameters.TryGetValue<AlertType>(nameof(Type), out _);
        // Standard Blazor semantics only assign parameters present in the incoming ParameterView --
        // an omitted Type otherwise leaves the backing property holding whatever a PRIOR render set
        // it to, so a non-Banner alert that stops passing Type would keep rendering a stale severity
        // forever. Reset to the documented default here; base.SetParametersAsync below overwrites it
        // right back if Type IS present this render.
        if (!_typeSet) Type = AlertType.Info;
        return base.SetParametersAsync(parameters);
    }

    /// <summary>The severity actually used for styling/icon/ARIA — see <see cref="Type"/>.</summary>
    AlertType EffectiveType => !_typeSet && Banner ? AlertType.Warning : Type;

    bool HasDescription => !string.IsNullOrEmpty(Description);
    string TypeName => EffectiveType.ToString().ToLowerInvariant();

    // The icon is aria-hidden (see UiKitIcons), and role/aria-live alone only splits error from
    // everything else -- so this sr-only word is the only signal that distinguishes Success/Info/
    // Warning from one another for a screen reader (see .wss-sr-only, wss-controls.css).
    // SeverityLabel overrides just the word (localizable, like CloseButtonLabel) -- the trailing
    // ": " separator is always this component's own, not the caller's.
    string SeverityAnnouncement => $"{SeverityLabel ?? DefaultSeverityWord}: ";

    string DefaultSeverityWord => EffectiveType switch
    {
        AlertType.Success => "Success",
        AlertType.Warning => "Warning",
        AlertType.Error => "Error",
        _ => "Info",
    };

    // Same glyphs (and the same <svg> wrapper) the toast/notification severity icons use — see
    // UiKitIcons.
    MarkupString Icon => EffectiveType switch
    {
        AlertType.Success => UiKitIcons.ToastSuccess,
        AlertType.Warning => UiKitIcons.ToastWarning,
        AlertType.Error => UiKitIcons.ToastError,
        _ => UiKitIcons.ToastInfo,
    };

    bool _closed;

    // Closing hides the alert itself (matching AntD) — OnClose is a notification, not a
    // requirement, so a Closable alert without a handler no longer renders a dead button.
    async Task OnCloseClicked()
    {
        _closed = true;
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }
}
