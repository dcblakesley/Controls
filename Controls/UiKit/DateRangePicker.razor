@namespace Controls
@inherits PickerBase

@* Backdrop: closes the dropdown on any outside click without needing JS interop. Rendered as the
   wrapper's previous sibling so placePanel can stack it just under the raised wrapper (the same
   contract as Select). tabindex="-1": iOS-class WebKit only synthesizes a click from a tap when
   the target chain contains a focusable element; -1 keeps it out of the Tab order. *@
@if (_open)
{
    <div class="wss-picker-backdrop" tabindex="-1" @onclick="CloseAsync"></div>
}

<div @attributes="AttributeSplat.Rest(AdditionalAttributes)"
     class="@WrapperClass @AttributeSplat.ConsumerClass(AdditionalAttributes)"
     style="@AttributeSplat.MergeStyle(WrapperStyle, AdditionalAttributes)"
     @ref="_wrapperRef"
     @onkeydown="OnWrapperKeyDownAsync" @onkeydown:stopPropagation="@_open">

    @* tabindex="-1": a click on the field's non-input chrome (separator, padding) then focuses
       the field itself instead of <body>, so Escape still bubbles through the wrapper's keydown
       and the focus-out close wiring sees focus as inside. (Same pattern as Select's wrapper;
       also iOS tap-to-click synthesis.) *@
    <div class="wss-picker-input" tabindex="-1" @onclick="OnFieldClickAsync">
        <span class="wss-picker-input-slot @(_open && _activeInput == 0 ? "wss-picker-slot-active" : null)">
            <input @ref="_startInputRef"
                   class="wss-picker-input-start"
                   id="@Id"
                   data-test-id="@Id"
                   type="text"
                   autocomplete="off"
                   aria-label="@StartInputLabel"
                   aria-haspopup="dialog"
                   aria-expanded="@(_open ? "true" : "false")"
                   aria-controls="@(_open ? PanelId : null)"
                   aria-required="@StartAriaRequired"
                   aria-invalid="@(StartAriaInvalid ? "true" : null)"
                   aria-describedby="@EffectiveStartAriaDescribedBy"
                   aria-errormessage="@StartAriaErrorMessage"
                   placeholder="@(StartPlaceholder ?? DefaultPlaceholder)"
                   disabled="@Disabled"
                   value="@StartDisplay"
                   @oninput="@(e => _startEdit = e.Value?.ToString() ?? string.Empty)"
                   @onchange="CommitStartTextAsync"
                   @onfocus="@(() => OnInputFocus(0))" />
        </span>
        <span class="wss-picker-separator" aria-hidden="true">@PickerIcons.SwapRightIcon</span>
        <span class="wss-picker-input-slot @(_open && _activeInput == 1 ? "wss-picker-slot-active" : null)">
            <input @ref="_endInputRef"
                   class="wss-picker-input-end"
                   id="@EndId"
                   data-test-id="@EndId"
                   type="text"
                   autocomplete="off"
                   aria-label="@EndInputLabel"
                   aria-haspopup="dialog"
                   aria-expanded="@(_open ? "true" : "false")"
                   aria-controls="@(_open ? PanelId : null)"
                   aria-required="@EndAriaRequired"
                   aria-invalid="@(EndAriaInvalid ? "true" : null)"
                   aria-describedby="@EffectiveEndAriaDescribedBy"
                   aria-errormessage="@EndAriaErrorMessage"
                   placeholder="@(EndPlaceholder ?? DefaultPlaceholder)"
                   disabled="@Disabled"
                   value="@EndDisplay"
                   @oninput="@(e => _endEdit = e.Value?.ToString() ?? string.Empty)"
                   @onchange="CommitEndTextAsync"
                   @onfocus="@(() => OnInputFocus(1))" />
        </span>
        <span class="wss-picker-suffix">@PickerIcons.CalendarIcon</span>
        @if (ShowClear)
        {
            <button type="button" class="wss-picker-clear" aria-label="@ClearLabel"
                    @onclick="ClearAsync" @onclick:stopPropagation>@UiKitIcons.CloseCross</button>
        }
    </div>

    @* One visually-hidden format hint for BOTH inputs (they share a single Format), referenced from
       each one's aria-describedby -- see EffectiveStartAriaDescribedBy. Deliberately not folded into
       the placeholders, which stay the uppercased-format strings this control already documents.
       Outside the `@if (_open)` block: aria-describedby has to resolve whether the panel is open or
       not. *@
    @if (FormatHintText is { Length: > 0 } formatHint)
    {
        <span class="wss-sr-only" id="@FormatHintId">@formatHint</span>
    }

    @if (_open)
    {
        @* role="dialog" with focus DELIBERATELY left on whichever input is active, rather than moved
           into the panel on open: both fields are type-ahead first (typing commits an endpoint), so
           stealing focus would swallow the user's keystrokes. The contract the combobox-like model
           needs is already honored -- the panel is in the tab order right after the fields, Escape
           closes it from anywhere inside the wrapper (discarding the in-progress pick), and every
           panel-originated close hands focus back to the active input (see PickerBase's
           _pendingInputFocus). See the a11y audit's PKR-5. *@
        <div class="wss-picker-dropdown @(IsSessionMode ? "wss-picker-dropdown-single" : null) @(_positioned ? null : "wss-measuring")" @ref="_panelRef"
             id="@PanelId" role="dialog" aria-label="@DialogLabel" tabindex="-1">
            @* What the panel currently shows -- both months/years/decades in the dual-panel modes, the
               lone session month otherwise -- announced on every navigation (nav buttons, header
               selects, a keyboard move that crosses out of the view). One per panel, present from
               first render (an aria-live region injected WITH its content is not reliably announced). *@
            <div class="wss-sr-only" aria-live="polite" aria-atomic="true">@ViewLabel</div>
            @if (Presets is { Count: > 0 })
            {
                <ul class="wss-picker-presets" aria-label="@PresetsLabel">
                    @foreach (var preset in Presets)
                    {
                        var p = preset;
                        <li>
                            <button type="button" class="wss-picker-preset"
                                    @onclick="@(() => OnPresetClickAsync(p))">@p.Label</button>
                        </li>
                    }
                </ul>
            }
            @if (IsSessionMode)
            {
                <div class="wss-picker-month">
                    @if (Mode == DatePickerMode.DateTime)
                    {
                        @* The pick session's lone panel takes the same single-panel header
                           DatePicker's own day calendar does -- prev/next both live on it, unlike
                           the dual-panel layout below, which splits them across its two panels.
                           SessionPrev/NextMonthDisabled (not the dual-panel pair) for exactly that
                           reason -- see their own comments. *@
                        <PickerMonthHeader PrevLabel="@PrevMonthLabel" PrevDisabled="@SessionPrevMonthDisabled" OnPrev="PrevMonth"
                                           NextLabel="@NextMonthLabel" NextDisabled="@SessionNextMonthDisabled" OnNext="NextMonth"
                                           MonthSelectLabel="@MonthSelectLabel" Month="@_viewMonth.Month"
                                           OnMonthChanged="@(e => OnMonthSelectChanged(0, e))"
                                           YearSelectLabel="@YearSelectLabel" Year="@_viewMonth.Year"
                                           YearRange="@YearRange(_viewMonth.Year)"
                                           OnYearChanged="@(e => OnYearSelectChanged(0, e))"
                                           Culture="@PickerCulture" />
                        <PickerWeekdayHeader ShowWeekNumberColumn="@ShowWeekRows" Names="@WeekdayHeaders" />
                        @if (ShowWeekRows)
                        {
                            <div class="wss-picker-grid-rows" role="grid" aria-label="@SessionViewLabel" @ref="_gridRefs[0]" @onkeydown="OnSessionGridKeyDown">
                                @foreach (var row in GridWeekRows(_viewMonth))
                                {
                                    var weekStart = row[0];
                                    <div class="wss-picker-week-row" role="row">
                                        <div class="wss-picker-week-no" aria-hidden="true">@WeekNumberOf(weekStart).ToString(PickerCulture)</div>
                                        @foreach (var day in row)
                                        {
                                            <div class="@SessionCellClass(day)" role="gridcell" aria-selected="@(IsSessionEndpoint(day) ? "true" : null)">@SessionDayButtonFragment(day)</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="wss-picker-grid" role="grid" aria-label="@SessionViewLabel" @ref="_gridRefs[0]" @onkeydown="OnSessionGridKeyDown">
                                @foreach (var row in GridWeekRows(_viewMonth))
                                {
                                    <div class="wss-picker-row" role="row">
                                        @foreach (var day in row)
                                        {
                                            <div class="@SessionCellClass(day)" role="gridcell" aria-selected="@(IsSessionEndpoint(day) ? "true" : null)">@SessionDayButtonFragment(day)</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    @* The Time/DateTime pick session's time row -- the same PickerTimeRow DatePicker's own
                       Time/DateTime panel renders, through the one shared PickerTimeRowSlot invocation
                       (see that component, and PickerTimeRow itself for the markup and the three
                       render-time invariants it owns). Each select's change writes to the ACTIVE
                       endpoint's pending session value via PickerBase's shared handlers ->
                       ApplyTimePartAsync (this class's override) instead of committing immediately -- OK
                       is this session's commit signal, not the select change itself. *@
                    <PickerTimeRowSlot Picker="this" />
                    @if (ExtraFooter is not null)
                    {
                        <div class="wss-picker-extra-footer">@ExtraFooter</div>
                    }
                    @* OK renders DISABLED (never a silent no-op) whenever confirming the current
                       pending pair would be rejected -- nothing resolved yet, an active value that
                       can't advance, or a pair the commit guards reject. See SessionOkDisabled, the
                       single predicate OnSessionOkAsync itself gates on, so the attribute and the
                       handler can never disagree. *@
                    <div class="wss-picker-footer">
                        <button type="button" class="wss-picker-ok" disabled="@SessionOkDisabled"
                                aria-disabled="@(SessionOkDisabled ? "true" : null)"
                                @onclick="OnSessionOkAsync">@OkText</button>
                    </div>
                </div>
            }
            else
            {
                @* Every date-only mode's existing dual-panel layout, unchanged (not reindented under
                   this new `else` -- deliberately, to keep this diff reviewable as "wrapped, not
                   rewritten"). *@
            <div class="wss-picker-panels">
                @for (var i = 0; i < 2; i++)
                {
                    var panel = i;
                    @if (EffectiveMode == DatePickerMode.Month || EffectiveMode == DatePickerMode.Quarter)
                    {
                        var year = panel == 0 ? LeftYear : RightYear;
                        var (fromYear, toYear) = YearRange(year);
                        <div class="wss-picker-month">
                            <div class="wss-picker-month-header">
                                @if (panel == 0)
                                {
                                    <button type="button" class="wss-picker-nav" aria-label="@PrevYearLabel"
                                            disabled="@PrevYearDisabled" @onclick="PrevYear">@PickerIcons.PrevIcon</button>
                                }
                                else
                                {
                                    <span class="wss-picker-nav wss-picker-nav-placeholder" aria-hidden="true"></span>
                                }
                                <div class="wss-picker-month-selects">
                                    <span class="wss-picker-select">
                                        <select aria-label="@YearSelectLabel" value="@year"
                                                @onchange="@(e => OnRangeYearSelectChanged(panel, e))">
                                            @for (var y = fromYear; y <= toYear; y++)
                                            {
                                                <option value="@y" selected="@(y == year)">@y.ToString(PickerCulture)</option>
                                            }
                                        </select>
                                        @PickerIcons.DownIcon
                                    </span>
                                </div>
                                @if (panel == 1)
                                {
                                    <button type="button" class="wss-picker-nav" aria-label="@NextYearLabel"
                                            disabled="@NextYearDisabled" @onclick="NextYear">@PickerIcons.NextIcon</button>
                                }
                                else
                                {
                                    <span class="wss-picker-nav wss-picker-nav-placeholder" aria-hidden="true"></span>
                                }
                            </div>
                            @if (EffectiveMode == DatePickerMode.Month)
                            {
                                <div class="wss-picker-month-grid" role="grid" aria-label="@year.ToString(PickerCulture)" @ref="_gridRefs[panel]"
                                     @onkeydown="OnMonthGridKeyDown"
                                     @onpointerleave="@(_selecting ? EventCallback.Factory.Create<PointerEventArgs>(this, OnGridPointerLeave) : default)">
                                    @foreach (var unitRow in UnitRows(MonthUnits(year), MonthGridColumns))
                                    {
                                        <div class="wss-picker-row" role="row">
                                            @foreach (var month in unitRow)
                                            {
                                                <div class="wss-picker-cell-unit" role="gridcell"
                                                     aria-selected="@(IsUnitAriaSelected(month) ? "true" : null)">
                                                    <button type="button" class="@UnitBtnClass(month)"
                                                            aria-disabled="@(IsMonthDisabled(month) ? "true" : null)"
                                                            tabindex="@(IsMonthFocusStop(month) ? "0" : "-1")"
                                                            data-date="@month.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                                            aria-label="@month.ToString("MMMM yyyy", PickerCulture)"
                                                            aria-current="@(month == FirstOfMonth(DateTime.Today) ? "date" : null)"
                                                            @onclick="@(() => OnUnitClickAsync(month))"
                                                            @onpointerenter="@(_selecting ? EventCallback.Factory.Create<PointerEventArgs>(this, () => OnUnitPointerEnter(month)) : default)">@MonthName(month.Month)</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="wss-picker-quarter-grid" role="grid" aria-label="@year.ToString(PickerCulture)" @ref="_gridRefs[panel]"
                                     @onkeydown="OnQuarterGridKeyDown"
                                     @onpointerleave="@(_selecting ? EventCallback.Factory.Create<PointerEventArgs>(this, OnGridPointerLeave) : default)">
                                    @foreach (var unitRow in UnitRows(QuarterUnits(year), QuarterGridColumns))
                                    {
                                        <div class="wss-picker-row" role="row">
                                            @foreach (var quarterStart in unitRow)
                                            {
                                                var quarter = QuarterOf(quarterStart);
                                                <div class="wss-picker-cell-unit" role="gridcell"
                                                     aria-selected="@(IsUnitAriaSelected(quarterStart) ? "true" : null)">
                                                    <button type="button" class="@UnitBtnClass(quarterStart)"
                                                            aria-disabled="@(IsQuarterDisabled(quarterStart) ? "true" : null)"
                                                            tabindex="@(IsQuarterFocusStop(year, quarter) ? "0" : "-1")"
                                                            data-date="@quarterStart.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                                            aria-label="@($"Q{quarter.ToString(PickerCulture)} {year.ToString(PickerCulture)}")"
                                                            aria-current="@(year == DateTime.Today.Year && quarter == QuarterOf(DateTime.Today) ? "date" : null)"
                                                            @onclick="@(() => OnUnitClickAsync(quarterStart))"
                                                            @onpointerenter="@(_selecting ? EventCallback.Factory.Create<PointerEventArgs>(this, () => OnUnitPointerEnter(quarterStart)) : default)">Q@(quarter.ToString(PickerCulture))</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (EffectiveMode == DatePickerMode.Year)
                    {
                        var decadeStart = panel == 0 ? LeftDecadeStart : RightDecadeStart;
                        <div class="wss-picker-month">
                            <div class="wss-picker-month-header">
                                @if (panel == 0)
                                {
                                    <button type="button" class="wss-picker-nav" aria-label="@PrevDecadeLabel"
                                            disabled="@PrevDecadeDisabled" @onclick="PrevDecade">@PickerIcons.PrevIcon</button>
                                }
                                else
                                {
                                    <span class="wss-picker-nav wss-picker-nav-placeholder" aria-hidden="true"></span>
                                }
                                <div class="wss-picker-month-selects">
                                    <span class="wss-picker-decade-label">@DecadeLabelFor(decadeStart)</span>
                                </div>
                                @if (panel == 1)
                                {
                                    <button type="button" class="wss-picker-nav" aria-label="@NextDecadeLabel"
                                            disabled="@NextDecadeDisabled" @onclick="NextDecade">@PickerIcons.NextIcon</button>
                                }
                                else
                                {
                                    <span class="wss-picker-nav wss-picker-nav-placeholder" aria-hidden="true"></span>
                                }
                            </div>
                            <div class="wss-picker-month-grid" role="grid" aria-label="@DecadeLabelFor(decadeStart)" @ref="_gridRefs[panel]"
                                 @onkeydown="OnYearGridKeyDown"
                                 @onpointerleave="@(_selecting ? EventCallback.Factory.Create<PointerEventArgs>(this, OnGridPointerLeave) : default)">
                                @foreach (var unitRow in UnitRows(YearUnits(decadeStart), MonthGridColumns))
                                {
                                    <div class="wss-picker-row" role="row">
                                        @foreach (var yearStart in unitRow)
                                        {
                                            var yr = yearStart.Year;
                                            var outside = yr < decadeStart || yr > decadeStart + 9;
                                            <div class="wss-picker-cell-unit" role="gridcell"
                                                 aria-selected="@(IsUnitAriaSelected(yearStart) ? "true" : null)">
                                                <button type="button" class="@UnitBtnClass(yearStart, outside)"
                                                        aria-disabled="@(IsYearDisabled(yearStart) ? "true" : null)"
                                                        tabindex="@(IsYearFocusStop(yr, outside) ? "0" : "-1")"
                                                        data-date="@yearStart.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                                        aria-label="@yr.ToString(PickerCulture)"
                                                        aria-current="@(yr == DateTime.Today.Year ? "date" : null)"
                                                        @onclick="@(() => OnUnitClickAsync(yearStart))"
                                                        @onpointerenter="@(_selecting ? EventCallback.Factory.Create<PointerEventArgs>(this, () => OnUnitPointerEnter(yearStart)) : default)">@yr.ToString(PickerCulture)</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        var month = _viewMonth.AddMonths(panel);
                        var (fromYear, toYear) = YearRange(month.Year);
                        <div class="wss-picker-month">
                            @* NOT PickerMonthHeader (which the session panel above and DatePicker's own
                               day calendar share): this dual-panel header renders each nav button only on
                               the panel that owns it and an invisible placeholder span on the other -- a
                               structural difference (a <span>, not a <button>), and the one thing about
                               this header that isn't just a different parameter value. Folding it in would
                               need show-prev/show-next switches on the shared component; left inline
                               deliberately rather than pretending the difference away. *@
                            <div class="wss-picker-month-header">
                                @if (panel == 0)
                                {
                                    <button type="button" class="wss-picker-nav" aria-label="@PrevMonthLabel"
                                            disabled="@PrevMonthDisabled" @onclick="PrevMonth">@PickerIcons.PrevIcon</button>
                                }
                                else
                                {
                                    @* Invisible stand-in for the nav button this panel doesn't render (prev lives on
                                       the left panel, next on the right), so every header keeps three flex children
                                       and space-between centers the selects instead of shoving them at the divider. *@
                                    <span class="wss-picker-nav wss-picker-nav-placeholder" aria-hidden="true"></span>
                                }
                                <div class="wss-picker-month-selects">
                                    <span class="wss-picker-select">
                                        <select aria-label="@MonthSelectLabel" value="@month.Month"
                                                @onchange="@(e => OnMonthSelectChanged(panel, e))">
                                            @for (var m = 1; m <= 12; m++)
                                            {
                                                <option value="@m" selected="@(m == month.Month)">@MonthName(m)</option>
                                            }
                                        </select>
                                        @PickerIcons.DownIcon
                                    </span>
                                    <span class="wss-picker-select">
                                        <select aria-label="@YearSelectLabel" value="@month.Year"
                                                @onchange="@(e => OnYearSelectChanged(panel, e))">
                                            @for (var y = fromYear; y <= toYear; y++)
                                            {
                                                <option value="@y" selected="@(y == month.Year)">@y.ToString(PickerCulture)</option>
                                            }
                                        </select>
                                        @PickerIcons.DownIcon
                                    </span>
                                </div>
                                @if (panel == 1)
                                {
                                    <button type="button" class="wss-picker-nav" aria-label="@NextMonthLabel"
                                            disabled="@NextMonthDisabled" @onclick="NextMonth">@PickerIcons.NextIcon</button>
                                }
                                else
                                {
                                    <span class="wss-picker-nav wss-picker-nav-placeholder" aria-hidden="true"></span>
                                }
                            </div>
                            <PickerWeekdayHeader ShowWeekNumberColumn="@ShowWeekRows" Names="@WeekdayHeaders" />
                            @* The pointer handlers only exist while a range pick is in progress: wiring them
                               unconditionally would re-render the component (a SignalR round trip per cell on
                               Blazor Server) for every cell the idle pointer crosses. An EventCallback without
                               a delegate is omitted from the render tree entirely. *@
                            @if (ShowWeekRows)
                            {
                                @* wss-picker-grid-week scopes Week mode's row-wide hover affordance
                                   (the row, not the day, is the selection unit there) -- the same
                                   conditional DatePicker's own week-rows grid emits. ShowWeekNumbers
                                   in Date mode renders these same rows with no row-level selection,
                                   so it deliberately doesn't get the class. *@
                                <div class="@(EffectiveMode == DatePickerMode.Week ? "wss-picker-grid-rows wss-picker-grid-week" : "wss-picker-grid-rows")" role="grid" aria-label="@month.ToString("MMMM yyyy", PickerCulture)" @ref="_gridRefs[panel]"
                                     @onkeydown="OnGridKeyDown"
                                     @onpointerleave="@(_selecting ? EventCallback.Factory.Create<PointerEventArgs>(this, OnGridPointerLeave) : default)">
                                    @foreach (var row in GridWeekRows(month))
                                    {
                                        var weekStart = row[0];
                                        <div class="@WeekRowClass(weekStart)" role="row">
                                            <div class="wss-picker-week-no" aria-hidden="true">@WeekNumberOf(weekStart).ToString(PickerCulture)</div>
                                            @foreach (var day in row)
                                            {
                                                @* Week mode's aria-selected is the ROW's answer, not the day's -- the row is the
                                                   selection unit there (see IsWeekRowEndpoint). Every other mode, and the flat
                                                   grid below (never reached in Week mode), asks per day. *@
                                                var selected = EffectiveMode == DatePickerMode.Week ? IsWeekAriaSelected(weekStart) : IsUnitAriaSelected(day);
                                                <div class="@CellClass(day)" role="gridcell" aria-selected="@(selected ? "true" : null)">@RangeDayButtonFragment((day, month))</div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                @* The flat 42-cell grid still groups its days into 6 role="row" wrappers: an ARIA
                                   grid's cells must sit inside rows, and .wss-picker-row's `display: contents`
                                   keeps the day cells the real 7-column grid items. The rows layout above needs no
                                   such wrapper -- its .wss-picker-week-row IS the row. *@
                                <div class="wss-picker-grid" role="grid" aria-label="@month.ToString("MMMM yyyy", PickerCulture)" @ref="_gridRefs[panel]"
                                     @onkeydown="OnGridKeyDown"
                                     @onpointerleave="@(_selecting ? EventCallback.Factory.Create<PointerEventArgs>(this, OnGridPointerLeave) : default)">
                                    @foreach (var row in GridWeekRows(month))
                                    {
                                        <div class="wss-picker-row" role="row">
                                            @foreach (var day in row)
                                            {
                                                <div class="@CellClass(day)" role="gridcell" aria-selected="@(IsUnitAriaSelected(day) ? "true" : null)">@RangeDayButtonFragment((day, month))</div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
            @if (ExtraFooter is not null)
            {
                <div class="wss-picker-extra-footer">@ExtraFooter</div>
            }
            }
        </div>
    }
</div>

@code {
    // One day cell's button for the DUAL-PANEL modes (Date, and its Week/ShowWeekNumbers rows
    // layout), rendered identically by both of those layouts. The context carries the panel's own
    // month (the day grid shows two, and both the outside-month class and the roving-tabindex check
    // need to know which one is rendering) -- everything else is derived here so the two layouts
    // can't drift. The selection state is NOT here: it lives as aria-selected on the enclosing
    // role="gridcell" wrapper (which is where ARIA allows it), and Week mode's own row-vs-day
    // resolution happens at that call site. Mirrors DatePicker's own DayButtonFragment.
    //
    // aria-disabled, NOT the native `disabled` attribute -- see DatePicker.DayButtonFragment for the
    // full rationale (a rejected day has to stay focusable so the roving tabindex, the grid's single
    // tab stop, and the month-crossing focus follow all keep working). OnGridDayClickAsync guards the
    // same predicate, so a click -- or an Enter/Space on a focused disabled cell -- no-ops.
    RenderFragment<(DateTime Day, DateTime Month)> RangeDayButtonFragment => ctx => @<button type="button" class="@DayClass(ctx.Day, ctx.Month)"
                                                                                             aria-disabled="@(IsDayDisabled(ctx.Day) ? "true" : null)"
                                                                                             tabindex="@(IsFocusStop(ctx.Day, ctx.Month) ? "0" : "-1")"
                                                                                             data-date="@ctx.Day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                                                                             aria-label="@ctx.Day.ToString("D", PickerCulture)"
                                                                                             aria-current="@(IsToday(ctx.Day) ? "date" : null)"
                                                                                             @onclick="@(() => OnGridDayClickAsync(ctx.Day))"
                                                                                             @onpointerenter="@(_selecting ? EventCallback.Factory.Create<PointerEventArgs>(this, () => OnGridDayPointerEnter(ctx.Day)) : default)">@ctx.Day.Day.ToString("00", CultureInfo.CurrentCulture)</button>;

    // The Time/DateTime pick session's own day button, rendered identically by that session's two
    // day-grid layouts. A single panel (so no month context) whose classing/focus state and click all
    // route through the session's own members instead of the dual-panel ones, and which needs no
    // pointer-enter hover preview (the session has no drag-to-select pick -- see SessionCellClass).
    // Same aria-disabled contract as the dual-panel fragment above.
    RenderFragment<DateTime> SessionDayButtonFragment => d => @<button type="button" class="@SessionDayClass(d)"
                                                                      aria-disabled="@(IsDayDisabled(d) ? "true" : null)"
                                                                      tabindex="@(IsSessionFocusStop(d) ? "0" : "-1")"
                                                                      data-date="@d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                                                      aria-label="@d.ToString("D", PickerCulture)"
                                                                      aria-current="@(IsToday(d) ? "date" : null)"
                                                                      @onclick="@(() => OnSessionDayClickAsync(d))">@d.Day.ToString("00", CultureInfo.CurrentCulture)</button>;
}
