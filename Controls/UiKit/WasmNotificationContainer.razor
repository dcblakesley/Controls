@namespace Controls
@implements IDisposable

@* WASM-only host: reads the static WasmNotificationService. For Blazor Server use NotificationContainer. *@
<NotificationListView Items="WasmNotificationService.Items" OnRemove="@(id => WasmNotificationService.Remove(id))" Placement="Placement" />

@code {
    /// <summary>
    /// Which corner of the viewport the stack anchors to. Defaults to <see cref="NotificationPlacement.TopRight"/>.
    /// Set per container instance (render-tree-scoped) — not on the static service.
    /// </summary>
    [Parameter] public NotificationPlacement Placement { get; set; } = NotificationPlacement.TopRight;

    protected override void OnInitialized() => WasmNotificationService.OnChange += HandleChange;

    /// <summary>
    /// Fails fast when this WASM-only container is hosted anywhere else. <see cref="WasmNotificationService"/>
    /// keeps its state in process-wide statics, so on Blazor Server one process serves every circuit
    /// and user A's notifications render on user B's screen -- a silent cross-user leak that only shows
    /// up under real multi-user load, never in single-user dev. Asserted here rather than in
    /// <c>OnInitialized</c>: a WASM app's own server-side prerender pass runs with
    /// <c>IsBrowser() == false</c> and would false-positive, while <c>OnAfterRender</c> only runs once
    /// the component is live on the render host it will actually stay on.
    /// </summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !OperatingSystem.IsBrowser())
        {
            throw new InvalidOperationException(
                "WasmNotificationContainer (and WasmNotificationService) are WebAssembly-only: their " +
                "state is process-static, which on Blazor Server is shared by every circuit, so one " +
                "user's notifications would render for all of them. Register the scoped services with " +
                "builder.Services.AddWssControlsToasts(), inject INotificationService, and use " +
                "<NotificationContainer /> instead.");
        }
    }

    void HandleChange() => InvokeAsync(StateHasChanged);

    public void Dispose() => WasmNotificationService.OnChange -= HandleChange;
}
