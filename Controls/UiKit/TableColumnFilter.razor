@namespace Controls
@typeparam TItem
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Column filtering (Column.FilterOptions/OnFilter): a funnel-icon button in the header cell that
   opens a checkbox/radio dropdown. Outside-click-to-close is a full-screen invisible backdrop --
   the same JS-free pattern Popover/Select already use -- so open/close/apply/reset all work with
   no JS runtime at all (server prerender, unit tests). JS is opt-in and only ever used to escape a
   ScrollY wrapper's overflow clip and keep the escaped dropdown tracking its trigger across page
   scroll/resize while it stays open (see OnAfterRenderAsync), and to move focus into/out of the
   panel. *@
@if (Column.Filter is { } filter)
{
    @* aria-haspopup="dialog" matches what this button actually opens (the panel below is a
       role="dialog"), and matches every other popup trigger in the kit -- DatePicker/DateRangePicker
       declare it statically, Popover/Popconfirm get it from wss-overlay.js. *@
    <button type="button" @ref="_buttonRef"
            class="wss-table-filter-trigger @(filter.IsActive ? "wss-table-filter-active" : null)"
            aria-label="@FilterAriaLabel" aria-haspopup="dialog" aria-expanded="@(filter.IsOpen ? "true" : "false")"
            disabled="@Disabled"
            @onclick="ToggleOpen" @onclick:stopPropagation="true">
        @FilterIcon
    </button>
    @if (filter.IsOpen)
    {
        @* tabindex="-1": see .wss-select-backdrop -- iOS-class WebKit only synthesizes a click from a
           tap on a focusable/interactive target chain, so a bare div would never receive the tap. *@
        <div class="wss-table-filter-backdrop" tabindex="-1" @onclick="Close"></div>
        <div class="wss-table-filter-dropdown" @ref="_panelRef" role="dialog" aria-label="@FilterAriaLabel"
             tabindex="-1" @onkeydown="OnKeyDown" @onkeydown:stopPropagation="true" @onclick:stopPropagation="true">
            @* The kind-specific editor (checkbox/radio list for Options) edits the column's PENDING
               state; the footer below is what commits (OK) or clears (Reset) it. *@
            <TableFilterEditor TItem="TItem"
                               Column="Column"
                               Table="Table"
                               Placement="TableFilterPlacement.Dropdown" />
            <div class="wss-table-filter-footer">
                <button type="button" class="wss-table-filter-reset" @onclick="Reset">@ResetLabel</button>
                <button type="button" class="wss-table-filter-ok" @onclick="Apply">@OkLabel</button>
            </div>
        </div>
    }
}

@code {
    /// <summary>The column this control filters. Required.</summary>
    [Parameter, EditorRequired] public Column<TItem> Column { get; set; } = default!;

    /// <summary>Accessible-name format for the filter button; <c>{0}</c> is the column's header
    /// text. Forwarded from <see cref="Table{TItem}.FilterButtonLabelFormat"/>.</summary>
    [Parameter] public string FilterButtonLabelFormat { get; set; } = "Filter {0}";

    /// <summary>Accessible-name format used instead of <see cref="FilterButtonLabelFormat"/> while
    /// this column has a filter applied. Forwarded from
    /// <see cref="Table{TItem}.FilterAppliedButtonLabelFormat"/>.</summary>
    [Parameter] public string FilterAppliedButtonLabelFormat { get; set; } = "Filter {0} (filter applied)";

    /// <summary>Accessible name for a headerless column's filter button while a filter is applied.
    /// Forwarded from <see cref="Table{TItem}.FilterAppliedLabel"/>.</summary>
    [Parameter] public string FilterAppliedLabel { get; set; } = "Filter (filter applied)";

    /// <summary>
    /// Renders the funnel button natively <c>disabled</c> (the Table forwards its own
    /// <see cref="Table{TItem}.Loading"/>), so a masked table is inert to the keyboard as well as to
    /// the pointer. Scoped to the trigger only: a dropdown that was already open when loading
    /// started keeps working, since the mask never covered it either.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Label of the dropdown's clear-this-column button. Forwarded from
    /// <see cref="Table{TItem}.FilterResetLabel"/>.</summary>
    [Parameter] public string ResetLabel { get; set; } = "Reset";

    /// <summary>Label of the dropdown's apply button. Forwarded from
    /// <see cref="Table{TItem}.FilterOkLabel"/>.</summary>
    [Parameter] public string OkLabel { get; set; } = "OK";

    /// <summary>Accessible-name fallback for the filter button when the column has no header text
    /// to name it. Forwarded from <see cref="Table{TItem}.FilterLabel"/>.</summary>
    [Parameter] public string FilterLabel { get; set; } = "Filter";

    // Explicit parameter, not [CascadingParameter]: Table's own `<CascadingValue Value="this">`
    // wraps only its ChildContent (where Column<TItem> instances self-register) -- the <thead>
    // markup that instantiates this component is a sibling of that CascadingValue in Table's render
    // tree, not a descendant of it, so it would never resolve here.
    [Parameter, EditorRequired] public Table<TItem> Table { get; set; } = default!;

    [CascadingParameter] FormDefaults? FormDefaults { get; set; }

    ElementReference _buttonRef;
    ElementReference _panelRef;
    // JsModule owns the once-only import, the dispose-raced-the-import guard, and the no-JS degrade
    // (a null return, which reads the same as the import throwing did). JsHandle owns
    // activateFixedDropdown's returned handle: the sequence token (this file used to re-check "still
    // open" after the await but had NO token, so a close->reopen across the in-flight round trip
    // orphaned one handle and leaked its window scroll/resize listeners for the circuit's life), the
    // two-step release, and the no-JS degrade.
    readonly JsModule _module = new("wss-overlay.js");
    readonly JsHandle _scrollHandle = new();
    bool _pendingFocus;
    bool _wasOpen;
    bool _fixedPositioned;
    bool _disposed;

    // Null-safe reads of the column's filter state for the code paths that run whether or not the
    // markup above rendered: OnAfterRenderAsync still runs for the one render in which a column has
    // just lost its filter (Column.Filter null) before the Table's re-render removes this component.
    bool IsOpen => Column.IsFilterOpen;
    bool IsActive => Column.Filter is { IsActive: true };

    // AntD "FilterFilled" -- a solid funnel. Recolored (not reshaped) for the active state, the same
    // technique the sort carets already use (.wss-table-sorter-up/-down + wss-table-sorter-active).
    static readonly MarkupString FilterIcon = new(
        "<svg viewBox=\"64 64 896 896\" width=\"1em\" height=\"1em\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M880.1 154H143.9c-24.5 0-39.8 26.7-27.5 48L349 597.4V838c0 17.7 14.2 32 31.8 32h262.4c17.6 0 31.8-14.3 31.8-32V597.4L907.7 202c12.2-21.3-3.1-48-27.6-48z\"/></svg>");

    // Mirrors Column.SortButtonLabel's title-less fallback -- a headerless column's filter button
    // still needs an accessible name, from FilterLabel (forwarded from Table.FilterLabel) rather
    // than a hardcoded literal, so a localized table doesn't announce this one button in English.
    //
    // The applied/unapplied fork is the same pair one level up: an applied filter is otherwise
    // signalled only by recoloring the funnel glyph, which no screen reader (and no user who can't
    // distinguish the two blues) can perceive. Both the trigger and the panel below read this, so
    // the open dialog reports the state it is about to edit.
    string FilterAriaLabel =>
        IsActive
            ? (string.IsNullOrEmpty(Column.HeaderText)
                ? FilterAppliedLabel
                : string.Format(FilterAppliedButtonLabelFormat, Column.HeaderText))
            : (string.IsNullOrEmpty(Column.HeaderText)
                ? FilterLabel
                : string.Format(FilterButtonLabelFormat, Column.HeaderText));

    void ToggleOpen()
    {
        // A disabled <button> cannot be clicked in a browser; this guards the programmatic paths
        // (tests, a synthetic dispatch) so "inert while Loading" holds there too.
        if (Disabled) return;
        if (IsOpen)
        {
            Close();
            return;
        }
        Table.OpenColumnFilter(Column);
        _pendingFocus = true;
    }

    void Close() => Table.CloseColumnFilter(Column);

    async Task Apply() => await Table.ApplyColumnFilterAsync(Column);

    async Task Reset() => await Table.ResetColumnFilterAsync(Column);

    void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    // Focus management (mirrors Popover): move focus into the panel once it opens, and back to the
    // trigger once it closes -- unless another column's filter is what closed this one, see the close
    // branch. The fixed-positioning escape only runs under Table.ScrollY -- the default (unset) case
    // never touches JS, matching the "JS-free by default" contract above.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;

        if (IsOpen)
        {
            _wasOpen = true;
            if (_pendingFocus)
            {
                _pendingFocus = false;
                try { await _panelRef.FocusAsync(); } catch { /* not focusable yet (prerender/tests) */ }
            }

            if (Table.ScrollY is not null && !_fixedPositioned)
            {
                // Null = no JS runtime / module, or disposed while the import was in flight (the
                // holder cleaned up its own late-arriving reference). Nothing to escape the overflow
                // clip with, so the CSS-anchored fallback below stands.
                var module = await _module.GetAsync(JS, FormDefaults);
                if (module is null) return;
                // activateFixedDropdown does the initial placement AND wires scroll/resize listeners
                // that keep the dropdown tracking the trigger for as long as it stays open (a PAGE
                // scroll moves the sticky trigger's rect even though the table's own ScrollY wrapper
                // keeps it visually pinned within the wrapper) -- see that function's own comment in
                // wss-overlay.js. False = no JS runtime/module, or the dropdown closed (or closed and
                // reopened, or this component was disposed) while the call was in flight: JsHandle
                // released the late-arriving handle, the CSS-anchored absolute position stays (it may
                // clip under a ScrollY wrapper's overflow -- the documented no-JS fallback), and
                // leaving _fixedPositioned false lets a later render retry while still open.
                _fixedPositioned = await _scrollHandle.ActivateAsync(
                    module, "activateFixedDropdown", [_buttonRef, _panelRef, 4], () => IsOpen);
            }
        }
        else if (_wasOpen)
        {
            _wasOpen = false;
            _fixedPositioned = false; // the dropdown node is destroyed on close; a fresh one re-measures next open
            // Focus first, release second. Releasing is up to two JS round trips under ScrollY, and
            // awaiting it first meant that when clicking column B's funnel closed column A's dropdown
            // (Table.OpenColumnFilter closes the other one), A's late focus restore landed AFTER B's
            // panel had focused itself -- B then never saw Escape or any other key. Skipped entirely
            // while another column's filter is open, which is that same race from the other side:
            // nothing here may pull focus out of the panel that just opened. A plain close (Escape,
            // outside click, OK/Reset) leaves no filter open and still returns focus to the funnel.
            if (!Table.AnyColumnFilterOpen)
            {
                try { await _buttonRef.FocusAsync(); } catch { /* not focusable / gone */ }
            }
            await _scrollHandle.ReleaseAsync(); // also invalidates any activation still in flight
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _scrollHandle.DisposeAsync();
        await _module.DisposeAsync();
    }
}
