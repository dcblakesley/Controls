@namespace Controls
@implements IDisposable

@* WASM-only host: reads the static WasmMessageService. For Blazor Server use MessageContainer. *@
<MessageListView Items="WasmMessageService.Items" />

@code {
    protected override void OnInitialized() => WasmMessageService.OnChange += HandleChange;

    /// <summary>
    /// Fails fast when this container is hosted on Blazor Server. <see cref="WasmMessageService"/>
    /// keeps its state in process-wide statics, so on Server one process serves every circuit and
    /// user A's toasts render on user B's screen -- a silent cross-user leak that only shows up under
    /// real multi-user load, never in single-user dev. The check is
    /// <see cref="WasmToastHost.IsSharedServerHost"/>, not "am I in the browser": Blazor Hybrid also
    /// runs outside the browser but serves exactly one user per process, which is what makes the
    /// static safe. Asserted here rather than in <c>OnInitialized</c> because a WASM app's own
    /// server-side prerender pass would false-positive, while <c>OnAfterRender</c> only runs once the
    /// component is live on the render host it will actually stay on.
    /// </summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && WasmToastHost.IsSharedServerHost(RendererInfo))
        {
            throw new InvalidOperationException(
                "WasmMessageContainer (and WasmMessageService) cannot run on Blazor Server: their " +
                "state is process-static, which on Server is shared by every circuit, so one user's " +
                "messages would render for all of them. This also covers the server phase of an " +
                "InteractiveAuto component, where the same sharing applies and the failure is " +
                "nondeterministic (the first load runs on Server and throws, a later one runs on " +
                "WebAssembly and succeeds). Register the scoped services with " +
                "builder.Services.AddWssControlsToasts(), inject IMessageService, and use " +
                "<MessageContainer /> instead. WebAssembly and WebView (Blazor Hybrid) hosts are " +
                "supported as-is.");
        }
    }

    void HandleChange() => InvokeAsync(StateHasChanged);

    public void Dispose() => WasmMessageService.OnChange -= HandleChange;
}
