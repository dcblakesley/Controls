@namespace Controls
@typeparam TItem
@implements IAsyncDisposable
@inject IJSRuntime JS

@* The editor for one column's filter, rendered from the column's Filter state (Column.Filter):
   one component per filter kind and placement, so a kind's editor exists exactly once whether it
   sits inside TableColumnFilter's dropdown panel (Placement = Dropdown: edits PENDING only, the
   panel's own OK/Reset commit or clear) or in the header filter row (Placement = Row: edits PENDING
   and commits it as it goes -- a selection at once, typed text after Table.FilterDebounceMilliseconds
   of quiet). Every commit, in either placement, is Table.ApplyColumnFilterAsync, so the row editors
   get the same "real change only" page reset and OnFilterChanged rule the OK button has.

   The Options kind in Dropdown placement is the checkbox/radio list that used to live inline in
   TableColumnFilter -- byte-identical DOM, no wrapper element of its own, unless the column opted
   into one of the two extras (Column.FilterSearch's box above the list, Column.FilterCheckAll's row
   inside it). Renders nothing for a kind/placement it has no editor for, so the surrounding panel
   still gets its footer. Adding a kind means one branch in each placement below (Row branches must
   call CommitRowAsync -- directly for a discrete pick, via the debounce for free typing). *@
@if (Placement == TableFilterPlacement.Dropdown)
{
    @if (Column.Filter is OptionsFilterState<TItem> options)
    {
        var visible = VisibleOptions(options);
        if (ShowSearch)
        {
            @* Column.FilterSearch: narrows the list below as it is typed into, and nothing else --
               the query is this component's own UI state, so it starts empty on every open (the
               panel, and therefore this component, is created fresh each time) and never touches
               what is staged. Placeholder AND aria-label from the same string: a placeholder is not
               an accessible name, and this box has no visible label of its own. *@
            <div class="wss-table-filter-search">
                <input type="search"
                       class="wss-table-filter-input"
                       @ref="_searchRef"
                       autocomplete="off"
                       placeholder="@Table.FilterSearchPlaceholder"
                       aria-label="@Table.FilterSearchPlaceholder"
                       value="@_searchQuery"
                       @oninput="@(e => _searchQuery = e.Value as string ?? "")" />
            </div>
        }
        <ul class="wss-table-filter-list">
            @if (ShowCheckAll(options) && visible.Count > 0)
            {
                @* Column.FilterCheckAll: an option row in every respect but what it toggles -- the
                   VISIBLE options, so it means "all of these" rather than "all of them" under a
                   search query. Its mixed state is a DOM property only, mirrored from
                   OnAfterRenderAsync. Not rendered with nothing visible: there is nothing to select,
                   and the empty row below says so instead. *@
                <li class="wss-table-filter-checkall">
                    <label class="wss-table-filter-option-label">
                        <input type="checkbox"
                               class="wss-table-filter-checkbox"
                               @ref="_checkAllRef"
                               checked="@(CheckAllState(options, visible) is true)"
                               @onchange="@(e => ToggleCheckAll(options, visible, e.Value is true))" />
                        <span>@Table.FilterCheckAllLabel</span>
                    </label>
                </li>
            }
            @foreach (var opt in visible)
            {
                <li class="wss-table-filter-item">
                    <label class="wss-table-filter-option-label">
                        @if (options.Multiple)
                        {
                            <input type="checkbox"
                                   class="wss-table-filter-checkbox"
                                   checked="@options.IsPending(opt.Value)"
                                   @onchange="@(e => options.TogglePending(opt.Value, e.Value is true))" />
                        }
                        else
                        {
                            <input type="radio"
                                   class="wss-table-filter-radio"
                                   name="@_radioGroupName"
                                   checked="@options.IsPending(opt.Value)"
                                   @onchange="@(() => options.SelectPending(opt.Value))" />
                        }
                        <span>@opt.Text</span>
                    </label>
                </li>
            }
            @if (ShowSearch && visible.Count == 0)
            {
                @* Only ever under a search box: a column whose options list is simply empty renders
                   the same empty <ul> it always has. *@
                <li class="wss-table-filter-empty">@Table.FilterEmptyText</li>
            }
        </ul>
    }
    else if (Column.Filter is TextFilterState<TItem> text)
    {
        @* Text kind: a search box bound to the PENDING text on every keystroke (Enter is the OK
           button's keyboard twin; the panel's own Escape handling is one level up and still fires,
           since keydown bubbles). Named after the column's filter exactly as the trigger and the
           dialog are, so a screen-reader user hears which column they are typing a filter for. The
           wrapper gives the box its gutter inside the panel and anchors the clear button, which
           clears the STAGED text only -- OK (or Enter) is still what applies. *@
        <div class="wss-table-filter-text">
            <input type="search"
                   class="wss-table-filter-input"
                   @ref="_inputRef"
                   autocomplete="off"
                   aria-label="@Table.FilterAccessibleName(Column)"
                   value="@text.PendingText"
                   @oninput="@(e => text.PendingText = e.Value as string)"
                   @onkeydown="OnEditorKeyDown" />
            @if (!string.IsNullOrEmpty(text.PendingText))
            {
                <button type="button"
                        class="wss-table-filter-input-clear"
                        aria-label="@Table.FilterClearLabel"
                        @onclick="@(() => ClearPendingTextAsync(text))">
                    @EditIcons.ClearCircle
                </button>
            }
        </div>
    }
    else if (Column.Filter is NumberRangeFilterState<TItem> range)
    {
        @* The typed kinds are one control rather than a list, so they get the same padded slot the
           Text box does -- the panel itself stays unpadded for the option list and the footer. *@
        <div class="wss-table-filter-pane">
            @NumberRangeInputs(range)
        </div>
    }
    else if (Column.Filter is DateRangeFilterState<TItem> dates)
    {
        <div class="wss-table-filter-pane">
            @DateRangeEditor(dates)
        </div>
    }
    else if (Column.Filter is BoolFilterState<TItem> flag)
    {
        <div class="wss-table-filter-pane">
            @BoolEditor(flag)
        </div>
    }
}
else
{
    @* Row placement. One wrapper for every kind: the flex/width contract the filter-row cell's CSS
       relies on (.wss-table-filter-editor), and the containing block for the Text kind's clear
       button. Everything renders natively disabled while the Table is Loading -- the same inertness
       contract the funnel button has, since the mask covers this row too. *@
    <div class="wss-table-filter-editor">
        @if (Column.Filter is OptionsFilterState<TItem> options)
        {
            @* The kit's own Select stands in for the dropdown's checkbox/radio list: Multiple mirrors
               FilterMultiple, its selection IS the pending set (PendingValues out, TryRestore in), and
               every change commits on the spot -- there is no OK in this placement. Options are mapped
               once per options snapshot, see SelectOptionsFor. *@
            <Select TValue="string"
                    Mode="@(options.Multiple ? SelectMode.Multiple : SelectMode.Single)"
                    Options="@SelectOptionsFor(options)"
                    Value="@SinglePendingValue(options)"
                    ValueChanged="@(v => OnRowSingleSelectionChangedAsync(options, v))"
                    Values="@(options.Multiple ? options.PendingValues : null)"
                    ValuesChanged="@(vs => OnRowSelectionChangedAsync(options, vs))"
                    AllowClear="true"
                    Size="SelectSize.Small"
                    Placeholder="@Table.FilterSelectPlaceholder"
                    EmptyText="@Table.FilterEmptyText"
                    InputLabel="@Table.FilterRowLabel(Column)"
                    Disabled="@Table.Loading" />
        }
        else if (Column.Filter is TextFilterState<TItem> text)
        {
            @* The same search box + clear button as the dropdown, minus the panel gutter wrapper.
               Typing updates PENDING and arms the debounce; Enter and the clear button commit at
               once (cancelling any debounce in flight). *@
            <input type="search"
                   class="wss-table-filter-input"
                   @ref="_inputRef"
                   autocomplete="off"
                   aria-label="@Table.FilterRowLabel(Column)"
                   value="@text.PendingText"
                   disabled="@Table.Loading"
                   @oninput="@(e => OnRowTextInputAsync(text, e))"
                   @onkeydown="OnEditorKeyDown" />
            @if (!string.IsNullOrEmpty(text.PendingText))
            {
                <button type="button"
                        class="wss-table-filter-input-clear"
                        aria-label="@Table.FilterClearLabel"
                        disabled="@Table.Loading"
                        @onclick="@(() => ClearPendingTextAsync(text))">
                    @EditIcons.ClearCircle
                </button>
            }
        }
        else if (Column.Filter is NumberRangeFilterState<TItem> range)
        {
            @* Identical markup to the dropdown's, minus that placement's padded slot -- the row cell
               supplies the gutter. Typing arms the shared debounce; Enter flushes it. *@
            @NumberRangeInputs(range)
        }
        else if (Column.Filter is DateRangeFilterState<TItem> dates)
        {
            @DateRangeEditor(dates)
        }
        else if (Column.Filter is BoolFilterState<TItem> flag)
        {
            @BoolEditor(flag)
        }
        else if (Column.Filter is CustomFilterState<TItem> custom && Column.FilterDropdown is { } template)
        {
            @* The consumer's template renders in the cell with the same context the dropdown hands
               it: SetSelectedValues stages, ConfirmAsync applies (closeDropdown is moot here), and
               Close/IsOpen are inert -- nothing is ever open in this placement. *@
            @template(new TableFilterContext<TItem>(Table, Column, custom))
        }
    </div>
}

@code {
    /// <summary>The column whose filter this edits. Required; its <c>Filter</c> state decides the
    /// editor kind.</summary>
    [Parameter, EditorRequired] public Column<TItem> Column { get; set; } = default!;

    /// <summary>The owning table -- the source of every label an editor needs (read directly, not
    /// forwarded parameter-by-parameter). Required. An explicit parameter for the same reason
    /// <see cref="TableColumnFilter{TItem}.Table"/> is: this component renders outside the Table's
    /// <c>CascadingValue</c>, which wraps only its column-declaring ChildContent.</summary>
    [Parameter, EditorRequired] public Table<TItem> Table { get; set; } = default!;

    /// <summary>Whether this editor sits in a dropdown panel (stages edits for the panel's OK) or a
    /// header filter row (applies as it edits). Default Dropdown.</summary>
    [Parameter] public TableFilterPlacement Placement { get; set; } = TableFilterPlacement.Dropdown;

    [CascadingParameter] FormDefaults? FormDefaults { get; set; }

    // One radio group per editor instance: the dropdown is re-created on every open, so a fresh
    // name each time, and two open editors (never, today -- Table allows one open dropdown) could
    // not steal each other's checked state.
    readonly string _radioGroupName = $"wss-table-filter-{Guid.NewGuid():N}";

    ElementReference _inputRef;
    ElementReference _maxRef;
    ElementReference _searchRef;
    ElementReference _checkAllRef;
    // The kit components the DateRange/Bool editors render, for the open-focus hand-off below (they
    // own their own input, so an ElementReference of ours would have nothing to point at).
    DateRangePicker? _datePicker;
    Select<string>? _boolSelect;

    // Row placement, free typing (Text and the two NumberRange boxes): the in-flight debounce (null
    // between keystrokes). Owned and cancelled
    // here so a commit can never land after this editor left the tree -- the column may have been
    // removed, or the placement switched back to Dropdown, in the meantime.
    CancellationTokenSource? _debounceCts;
    bool _disposed;

    // Column.FilterSearch's query. Deliberately a plain field on THIS component and not part of the
    // filter state: TableColumnFilter renders the panel (and therefore this editor) only while the
    // dropdown is open, so the field is born empty on every open -- which is the specified "reset on
    // every open" with nothing to reset.
    string _searchQuery = "";

    // Column.FilterCheckAll's mixed state needs the same JS mirror the table's own select-all uses
    // (indeterminate is a DOM property with no HTML attribute), so this editor imports the same
    // module and degrades the same way: no JS runtime, no mixed glyph, a plain checked/unchecked box.
    readonly JsModule _module = new("wss-table.js");
    bool? _lastCheckAllIndeterminate;

    // Select treats Options as immutable-by-reference (a new instance costs it an O(n) lookup and
    // filter rebuild), so the TableFilterOption -> SelectOption mapping is cached against the column's
    // own options snapshot, which is itself only replaced when the options actually changed.
    IReadOnlyList<TableFilterOption>? _selectOptionsSource;
    List<SelectOption<string>> _selectOptions = [];

    IEnumerable<SelectOption<string>> SelectOptionsFor(OptionsFilterState<TItem> options)
    {
        if (!ReferenceEquals(options.Options, _selectOptionsSource))
        {
            _selectOptionsSource = options.Options;
            _selectOptions = options.Options.Select(o => new SelectOption<string>(o.Value, o.Text)).ToList();
        }
        return _selectOptions;
    }

    // Single-mode Select value: the one pending key, or Select's own "nothing selected" default
    // (null -- Select<string>.Value is declared non-nullable but defaults to default!, exactly this).
    static string SinglePendingValue(KeyedFilterState<TItem> keyed) =>
        keyed.PendingValues is [var first, ..] ? first : null!;

    // The accessible name of whatever this editor renders, from the Table's own label rules: the
    // applied/unapplied dropdown name inside a panel, the row format in a filter-row cell. One lookup
    // for every kind, so a new editor names itself by construction.
    string EditorLabel => Placement == TableFilterPlacement.Row
        ? Table.FilterRowLabel(Column)
        : Table.FilterAccessibleName(Column);

    // A sub-control's name, qualified by the column's: two range columns in one table would otherwise
    // both announce a bare "Minimum" with nothing to tell them apart.
    string BoundLabel(string bound) => $"{EditorLabel}: {bound}";

    // Loading makes the ROW editors inert (the mask covers that row), and only them: a dropdown that
    // was already open when loading started keeps working, exactly as TableColumnFilter.Disabled
    // scopes the same rule to the funnel and not the panel.
    bool RowDisabled => Placement == TableFilterPlacement.Row && Table.Loading;

    /// <summary>
    /// Moves focus into whatever this editor's own primary control is -- the text box, the first
    /// range bound, the picker, the select -- and reports whether it did, so the panel that hosts it
    /// focuses itself instead when this returns false (the Options list and a consumer template do
    /// their own). Keyed off the column's current kind, not the element reference: the host keeps a
    /// reference to this component across opens, and a reference left over from a previous kind must
    /// not be trusted.
    /// </summary>
    internal async ValueTask<bool> TryFocusAsync()
    {
        if (Placement != TableFilterPlacement.Dropdown) return false;
        switch (Column.Filter)
        {
            // A search box is the reason the user opened THIS dropdown, exactly as the Text kind's is
            // -- without it the Options panel has no text entry and the dialog focuses itself.
            case OptionsFilterState<TItem> when ShowSearch:
                try { await _searchRef.FocusAsync(); } catch { /* not focusable yet (prerender/tests) */ }
                return true;
            case TextFilterState<TItem>:
            case NumberRangeFilterState<TItem>:
                try { await _inputRef.FocusAsync(); } catch { /* not focusable yet (prerender/tests) */ }
                return true;
            case DateRangeFilterState<TItem> when _datePicker is not null:
                // Note this opens the picker's own panel in a browser (it opens on input focus) --
                // which is what a user who just opened a date filter is asking for.
                try { await _datePicker.FocusAsync(); } catch { /* not focusable yet */ }
                return true;
            case BoolFilterState<TItem> when _boolSelect is not null:
                try { await _boolSelect.FocusAsync(); } catch { /* not focusable yet */ }
                return true;
            default:
                return false;
        }
    }

    // ----- Options kind, Dropdown placement: FilterSearch / FilterCheckAll -----

    // Both extras are Dropdown-only by design: a Row-placement Options editor is a Select, which has
    // its own search box and its own "clear" and would gain nothing from a second one.
    bool ShowSearch =>
        Placement == TableFilterPlacement.Dropdown && Column.FilterSearch
        && Column.Filter is OptionsFilterState<TItem>;

    // Multiple only -- with radios there is no "all" to select (AntD's own select-all is likewise a
    // multiple-selection affordance).
    bool ShowCheckAll(OptionsFilterState<TItem> options) =>
        Placement == TableFilterPlacement.Dropdown && Column.FilterCheckAll && options.Multiple;

    // The options the list is currently rendering: all of them, or -- with something typed into the
    // search box -- the ones whose TEXT contains it, OrdinalIgnoreCase (the comparison every other
    // text match in the filter stack uses). The full list is handed back by reference when there is
    // no query, so the untouched case allocates nothing.
    IReadOnlyList<TableFilterOption> VisibleOptions(OptionsFilterState<TItem> options) =>
        ShowSearch && !string.IsNullOrEmpty(_searchQuery)
            ? options.Options.Where(o => o.Text.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)).ToList()
            : options.Options;

    // The check-all box's tri-state over the VISIBLE options: true = every one staged, false = none,
    // null = some, which is the native "mixed" state (see OnAfterRenderAsync).
    static bool? CheckAllState(OptionsFilterState<TItem> options, IReadOnlyList<TableFilterOption> visible)
    {
        var staged = 0;
        foreach (var o in visible)
        {
            if (options.IsPending(o.Value)) staged++;
        }
        return staged == 0 ? false : staged == visible.Count ? true : null;
    }

    // Stages (or un-stages) exactly what is on screen. Options a search query hides keep whatever they
    // had -- OK commits the union, so ticking "all" under one query and then another does what it says.
    static void ToggleCheckAll(OptionsFilterState<TItem> options, IReadOnlyList<TableFilterOption> visible, bool on)
    {
        foreach (var o in visible) options.TogglePending(o.Value, on);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        await SuppressEnterSubmitAsync();
        await MirrorCheckAllIndeterminateAsync();
    }

    // Every raw <input> above applies its filter from OnEditorKeyDown, but Blazor has no per-key
    // preventDefault, so inside an <EditForm> Enter would ALSO implicitly submit the form. Only JS can
    // stop that (wss-table.js's suppressEnterSubmit); with no JS runtime the filter still applies and
    // the form still submits with it. Ids of the elements already wired -- an ElementReference's id
    // lives as long as its element, so a re-render costs nothing and a replaced element (a kind
    // switch, a first render that had no box yet) wires itself on its next pass.
    readonly HashSet<string> _enterSuppressed = [];

    async Task SuppressEnterSubmitAsync()
    {
        // Only what the CURRENT markup rendered: a leftover reference from a previous kind points at
        // a detached element the interop call could not resolve. Options in Row placement is a Select,
        // and the DateRange/Bool editors are kit components -- all three suppress their own Enter.
        List<ElementReference> refs = Column.Filter switch
        {
            OptionsFilterState<TItem> when ShowSearch => [_searchRef],
            TextFilterState<TItem> => [_inputRef],
            NumberRangeFilterState<TItem> => [_inputRef, _maxRef],
            _ => [],
        };

        IJSObjectReference? module = null;
        foreach (var element in refs)
        {
            if (string.IsNullOrEmpty(element.Id) || !_enterSuppressed.Add(element.Id)) continue;
            module ??= await _module.GetAsync(JS, FormDefaults);
            if (module is null) return;
            try
            {
                await module.InvokeVoidAsync("suppressEnterSubmit", element);
            }
            catch
            {
                // Element gone / circuit dropped mid-call -- retry on the next render.
                _enterSuppressed.Remove(element.Id);
            }
        }
    }

    // The mixed-state mirror, same shape (and same module function) as Table's own header select-all:
    // only when it actually changed, and silently doing nothing when there is no JS runtime -- the box
    // then reads checked or unchecked, which is what a screen reader hears too.
    async Task MirrorCheckAllIndeterminateAsync()
    {
        // No row rendered (wrong kind/placement, single-select, or a query hiding everything) means
        // no element to mirror onto -- and a freshly created one comes back indeterminate == false,
        // so forget the mirror rather than short-circuiting against a value from a box that is gone.
        if (Column.Filter is not OptionsFilterState<TItem> options || !ShowCheckAll(options)
            || VisibleOptions(options) is not { Count: > 0 } visible)
        {
            _lastCheckAllIndeterminate = null;
            return;
        }

        var mixed = CheckAllState(options, visible) is null;
        if (_lastCheckAllIndeterminate == mixed) return;
        var module = await _module.GetAsync(JS, FormDefaults);
        if (module is null) return;
        try
        {
            await module.InvokeVoidAsync("setIndeterminate", _checkAllRef, mixed);
            _lastCheckAllIndeterminate = mixed;
        }
        catch
        {
            // Element gone / circuit dropped mid-call -- same fallback, and a later render retries.
        }
    }

    // ----- Editors shared by both placements -----

    // NumberRange: two native number inputs side by side. type="number" gives the platform's own
    // numeric keypad and spinners; inputmode="decimal" is what actually picks the decimal keypad on
    // iOS. Each box binds its own PENDING bound and leaves parsing to the state -- a half-typed "1e"
    // is simply not a bound yet, so the rows never flicker mid-number. The min box carries the
    // @ref because TryFocusAsync lands there.
    RenderFragment NumberRangeInputs(NumberRangeFilterState<TItem> range) =>
        @<div class="wss-table-filter-range">
            <input type="number"
                   inputmode="decimal"
                   class="wss-table-filter-input"
                   @ref="_inputRef"
                   autocomplete="off"
                   aria-label="@BoundLabel(Table.FilterMinLabel)"
                   value="@range.MinText"
                   disabled="@RowDisabled"
                   @oninput="@(e => OnNumberInputAsync(range, true, e))"
                   @onkeydown="OnEditorKeyDown" />
            <input type="number"
                   inputmode="decimal"
                   class="wss-table-filter-input"
                   @ref="_maxRef"
                   autocomplete="off"
                   aria-label="@BoundLabel(Table.FilterMaxLabel)"
                   value="@range.MaxText"
                   disabled="@RowDisabled"
                   @oninput="@(e => OnNumberInputAsync(range, false, e))"
                   @onkeydown="OnEditorKeyDown" />
        </div>;

    // DateRange: the kit's own range picker, named as one field through its group label. Either
    // endpoint changing is a discrete pick, so the row placement commits on the spot -- no debounce
    // (the picker's own text entry only raises these once it parses).
    RenderFragment DateRangeEditor(DateRangeFilterState<TItem> dates) =>
        @<DateRangePicker @ref="_datePicker"
                          Start="@dates.Start"
                          StartChanged="@(v => OnDateChangedAsync(dates, true, v))"
                          End="@dates.End"
                          EndChanged="@(v => OnDateChangedAsync(dates, false, v))"
                          Size="SelectSize.Small"
                          AllowClear="true"
                          Disabled="@RowDisabled"
                          StartInputLabel="@Table.FilterDateStartLabel"
                          EndInputLabel="@Table.FilterDateEndLabel"
                          GroupLabel="@EditorLabel" />;

    // Bool: a single Select over the two literal keys the state serializes ("true"/"false"), with
    // AllowClear + the placeholder standing in for "any" -- there is no third option to select, since
    // "no filter" is the absence of one.
    RenderFragment BoolEditor(BoolFilterState<TItem> flag) =>
        @<Select TValue="string"
                 @ref="_boolSelect"
                 Options="@BoolOptions()"
                 Value="@BoolSelectValue(flag)"
                 ValueChanged="@(v => OnBoolChangedAsync(flag, v))"
                 AllowClear="true"
                 Placeholder="@Table.FilterBoolAnyText"
                 Size="SelectSize.Small"
                 InputLabel="@EditorLabel"
                 Disabled="@RowDisabled" />;

    // Same reference-stability contract as SelectOptionsFor: rebuilt only when the Table's own
    // wording changes, so Select isn't handed a fresh Options instance on every render.
    List<SelectOption<string>> _boolOptions = [];
    (string True, string False)? _boolOptionsLabels;

    IEnumerable<SelectOption<string>> BoolOptions()
    {
        if (_boolOptionsLabels != (Table.FilterBoolTrueText, Table.FilterBoolFalseText))
        {
            _boolOptionsLabels = (Table.FilterBoolTrueText, Table.FilterBoolFalseText);
            _boolOptions = [new("true", Table.FilterBoolTrueText), new("false", Table.FilterBoolFalseText)];
        }
        return _boolOptions;
    }

    // Select's "nothing selected" is null (Value is declared non-nullable but defaults to default!),
    // which is exactly the state's own "any".
    static string BoolSelectValue(BoolFilterState<TItem> flag) =>
        flag.PendingValue is { } value ? (value ? "true" : "false") : null!;

    // Enter applies, exactly as the OK button does. In the dropdown that also closes the panel; in
    // the row there is nothing to close, and any debounce still counting down is superseded (it
    // would otherwise re-commit the same value a moment later -- harmless, but a wasted recompute).
    // Every other key just edits the staged value via @oninput.
    async Task OnEditorKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        CancelDebounce();
        await Table.ApplyColumnFilterAsync(Column, closeDropdown: Placement == TableFilterPlacement.Dropdown);
    }

    // The clear button removes itself from the DOM the moment the text is empty, which would drop
    // focus to <body>; hand it back to the input so the user can keep typing. Dropdown: the STAGED
    // text only (OK still applies). Row: applied at once, like every other row edit.
    async Task ClearPendingTextAsync(TextFilterState<TItem> text)
    {
        CancelDebounce();
        text.PendingText = null;
        if (Placement == TableFilterPlacement.Row) await CommitRowAsync();
        try { await _inputRef.FocusAsync(); } catch { /* not focusable (prerender/tests) */ }
    }

    // ----- Row placement: auto-commit -----

    // The one commit call every Row editor makes. closeDropdown: false only for the sake of a custom
    // template that happens to be open in another column -- nothing this editor owns is ever open.
    Task CommitRowAsync() => Table.ApplyColumnFilterAsync(Column, closeDropdown: false);

    // Options kind (Select): the new selection replaces the pending set and commits immediately.
    async Task OnRowSelectionChangedAsync(KeyedFilterState<TItem> keyed, IEnumerable<string>? values)
    {
        keyed.TryRestore(values as IReadOnlyList<string> ?? values?.ToList() ?? []);
        await CommitRowAsync();
    }

    Task OnRowSingleSelectionChangedAsync(KeyedFilterState<TItem> keyed, string? value) =>
        OnRowSelectionChangedAsync(keyed, value is null ? [] : [value]);

    // DateRange: either endpoint is a discrete pick, so the row placement applies it at once (the
    // dropdown just stages it for OK, like every other kind).
    async Task OnDateChangedAsync(DateRangeFilterState<TItem> dates, bool isStart, DateTime? value)
    {
        if (isStart) dates.Start = value;
        else dates.End = value;
        if (Placement == TableFilterPlacement.Row) await CommitRowAsync();
    }

    // Bool: the select's two literal keys map straight back onto the state's tri-state; clearing
    // (AllowClear) hands back null, which is "any".
    async Task OnBoolChangedAsync(BoolFilterState<TItem> flag, string? value)
    {
        flag.PendingValue = value switch { "true" => true, "false" => false, _ => (bool?)null };
        if (Placement == TableFilterPlacement.Row) await CommitRowAsync();
    }

    // Text kind: pending follows every keystroke (so the box never fights the user); the commit is
    // debounced -- see ScheduleRowCommitAsync.
    async Task OnRowTextInputAsync(TextFilterState<TItem> text, ChangeEventArgs e)
    {
        text.PendingText = e.Value as string;
        await ScheduleRowCommitAsync();
    }

    // NumberRange: same shape as the text box, one bound at a time. Free typing, so it debounces too
    // -- and the state ignores a bound that isn't a number yet, so an in-progress "-" or "1e" commits
    // as "no bound" rather than emptying the table.
    async Task OnNumberInputAsync(NumberRangeFilterState<TItem> range, bool isMin, ChangeEventArgs e)
    {
        var text = e.Value as string;
        if (isMin) range.MinText = text;
        else range.MaxText = text;
        if (Placement == TableFilterPlacement.Row) await ScheduleRowCommitAsync();
    }

    // The one debounce every freely-typed row editor shares (Text, and each NumberRange bound): the
    // caller writes its own pending value first, then the commit waits for
    // Table.FilterDebounceMilliseconds of quiet -- each keystroke cancels the previous countdown and
    // starts its own, so only the last one lands, whichever box it came from (one CTS per editor, so
    // typing a max supersedes a min still counting down and the pair commits once). 0 commits
    // synchronously per input. The same CTS + Task.Delay shape Select uses for its search debounce.
    async Task ScheduleRowCommitAsync()
    {
        var delay = Table.FilterDebounceMilliseconds;
        if (delay <= 0)
        {
            await CommitRowAsync();
            return;
        }

        CancelDebounce();
        var cts = _debounceCts = new CancellationTokenSource();
        var token = cts.Token;
        try
        {
            await Task.Delay(delay, token);
        }
        catch (OperationCanceledException)
        {
            return; // superseded by a newer keystroke, flushed by Enter/clear, or disposed
        }
        // The delay can complete in the same tick a cancel/dispose arrives; a stale continuation must
        // not commit against a column this editor no longer represents.
        if (token.IsCancellationRequested || _disposed) return;

        await InvokeAsync(CommitRowAsync);
    }

    void CancelDebounce()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        CancelDebounce();
        await _module.DisposeAsync();
    }
}
