@namespace Controls
@implements IDisposable
@inject IMessageService Service

@* Scoped (Server-safe) host. Requires builder.Services.AddWssControlsToasts() and an injected
   IMessageService. Drop one at the app root; call IMessageService from your components. *@
<MessageListView Items="Service.Items" OnRemove="@(id => Service.Remove(id))" OnPause="@(id => Service.Pause(id))" OnResume="@(id => Service.Resume(id))"
                 CloseButtonLabel="@CloseButtonLabel" SeverityLabel="SeverityLabel" />

@code {
    /// <summary>Accessible name of every toast's close button. Override to localize. Forwarded to
    /// <see cref="MessageListView.CloseButtonLabel"/> -- set per container instance
    /// (render-tree-scoped, MFE-safe), not on the service.</summary>
    [Parameter] public string CloseButtonLabel { get; set; } = "Close";

    /// <summary>Overrides the sr-only severity word each toast announces ahead of its content. Null
    /// (default) keeps the built-in English words. Forwarded to
    /// <see cref="MessageListView.SeverityLabel"/> -- see its doc for the exact contract.</summary>
    [Parameter] public Func<MessageType, string>? SeverityLabel { get; set; }

    protected override void OnInitialized() => Service.OnChange += HandleChange;

    void HandleChange() => InvokeAsync(StateHasChanged);

    public void Dispose() => Service.OnChange -= HandleChange;
}
