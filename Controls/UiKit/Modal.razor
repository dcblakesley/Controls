@namespace Controls
@inherits OverlayActivationBase

@if (Visible)
{
    @* tabindex="-1": iOS-class WebKit only synthesizes a click from a tap on a focusable/interactive
       target chain, so without it a mask tap never reaches @onclick (mask-close dead on touch). The
       JS focus trap preventDefaults outside mousedown, so the wrap can't actually steal focus. *@
    <div class="wss-modal-wrap @(Centered ? "wss-modal-wrap-centered" : null)" tabindex="-1" @onmousedown="OnMaskMouseDown" @onmouseup="OnMaskMouseUp" @onclick="OnMaskClickAsync">
        @* onkeydown/onmousedown are withheld from the splat and CHAINED from the two handlers below:
           they collide with this element's own, and a duplicate attribute name deletes the consumer's
           outright rather than merging (see PanelAttributes / ConsumerEvent). onmouseup/onclick carry
           only a :stopPropagation directive here — no handler, so no collision, and a splatted one
           still runs (and still stops at the panel). *@
        <div @attributes="PanelAttributes"
             class="wss-modal @AttributeSplat.ConsumerClass(AdditionalAttributes)"
             style="@AttributeSplat.MergeStyle($"width:{Width}", AdditionalAttributes)" role="dialog" aria-modal="true"
             aria-labelledby="@(HasTitle ? _titleId : null)" aria-label="@(HasTitle ? null : AriaLabel ?? "Dialog")" tabindex="-1"
             @ref="_panelRef" @onkeydown="OnKeyDownAsync" @onkeydown:stopPropagation="true"
             @onmousedown="OnPanelMouseDownAsync" @onmousedown:stopPropagation="true"
             @onmouseup:stopPropagation="true" @onclick:stopPropagation="true">
            @if (HasTitle || Closable)
            {
                <div class="wss-modal-header">
                    <div class="wss-modal-title" id="@_titleId">@(TitleContent ?? (RenderFragment)(b => b.AddContent(0, Title)))</div>
                    @if (Closable)
                    {
                        <button type="button" class="wss-modal-close" aria-label="Close" @onclick="CancelAsync">
                            @UiKitIcons.CloseCross
                        </button>
                    }
                </div>
            }
            <div class="wss-modal-body">@ChildContent</div>
            @if (!HideFooter)
            {
                <div class="wss-modal-footer">
                    @if (Footer != null)
                    {
                        @Footer
                    }
                    else
                    {
                        <button type="button" class="wss-dialog-btn" @onclick="CancelAsync">@CancelText</button>
                        <button type="button" class="wss-dialog-btn wss-dialog-btn-primary" disabled="@ConfirmLoading" @onclick="OkAsync">@OkText</button>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>Whether the modal is shown. Use <c>@bind-Visible</c> — the parent owns the state.</summary>
    [Parameter] public bool Visible { get; set; }
    /// <summary>Raised with <c>false</c> when the modal requests close (Cancel button, close icon, mask click, or Escape).</summary>
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    /// <summary>Plain-text header title. Omit both title parameters to render a header-less modal.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Rich header title; overrides <see cref="Title"/> when set.</summary>
    [Parameter] public RenderFragment? TitleContent { get; set; }
    /// <summary>The modal body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Custom footer content; replaces the default Cancel/OK buttons when set.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }
    /// <summary>Suppresses the footer entirely (no default buttons and no <see cref="Footer"/>).</summary>
    [Parameter] public bool HideFooter { get; set; }
    /// <summary>Text of the default OK button. Defaults to "OK".</summary>
    [Parameter] public string OkText { get; set; } = "OK";
    /// <summary>Text of the default Cancel button. Defaults to "Cancel".</summary>
    [Parameter] public string CancelText { get; set; } = "Cancel";
    /// <summary>Raised when the default OK button is clicked. Does not auto-close — the caller decides when to set <see cref="Visible"/> false (e.g. after validation or async work).</summary>
    [Parameter] public EventCallback OnOk { get; set; }
    /// <summary>Raised after any cancel-style dismissal (Cancel button, close icon, mask click, or Escape).</summary>
    [Parameter] public EventCallback OnCancel { get; set; }
    /// <summary>Dialog width as a CSS length (e.g. "520px", "60%"). Defaults to "520px".</summary>
    [Parameter] public string Width { get; set; } = "520px";
    /// <summary>Shows the header close icon. Defaults to true. Escape-to-close is governed
    /// independently by <see cref="Keyboard"/> — matching AntD, where <c>closable</c> only controls
    /// the X button.</summary>
    [Parameter] public bool Closable { get; set; } = true;
    /// <summary>When true (default), clicking the mask outside the dialog cancels/closes it.</summary>
    [Parameter] public bool MaskClosable { get; set; } = true;
    /// <summary>When true (default), pressing Escape cancels/closes the dialog. Independent of
    /// <see cref="Closable"/> (which only shows/hides the header X) — matching AntD's
    /// <c>keyboard</c> prop.</summary>
    [Parameter] public bool Keyboard { get; set; } = true;
    /// <summary>Vertically centers the dialog in the viewport instead of the default fixed
    /// 100px-from-top offset.</summary>
    [Parameter] public bool Centered { get; set; }
    /// <summary>Disables the default OK button while true (e.g. during async confirm work).</summary>
    [Parameter] public bool ConfirmLoading { get; set; }
    /// <summary>Accessible name used when no <see cref="Title"/>/<see cref="TitleContent"/> is supplied.</summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>
    /// Unmatched attributes (e.g. a consumer's <c>class</c>, <c>style</c>, or <c>data-*</c>),
    /// applied to the dialog panel (<c>.wss-modal</c>) — not the mask wrapper, whose inline z-index
    /// is JS-owned. <c>class</c> and <c>style</c> merge with the component's own; the rest are
    /// splatted verbatim, except a same-named <c>onkeydown</c>/<c>onmousedown</c>, which are chained
    /// from this component's own handlers (see <see cref="PanelAttributes"/>).
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The panel's <c>@attributes</c> splat: the consumer's unmatched attributes minus the two events
    /// the same element binds explicitly (<see cref="OnKeyDownAsync"/>,
    /// <see cref="OnPanelMouseDownAsync"/>), which are chained from those handlers rather than
    /// splatted — Blazor's last-wins duplicate-attribute rule would otherwise delete the consumer's
    /// handlers outright. See <see cref="ConsumerEvent"/> for the ordering contract.
    /// </summary>
    IReadOnlyDictionary<string, object>? PanelAttributes =>
        AttributeSplat.RestExcept(AdditionalAttributes, "onkeydown", "onmousedown");

    readonly string _titleId = $"wss-modal-title-{Guid.NewGuid():N}";

    protected override bool IsVisible => Visible;

    bool HasTitle => TitleContent != null || !string.IsNullOrEmpty(Title);

    async Task CloseAsync()
    {
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(false);
    }

    async Task CancelAsync()
    {
        await CloseAsync();
        if (OnCancel.HasDelegate) await OnCancel.InvokeAsync();
    }

    // OK does not auto-close: the caller decides (e.g. after async work / validation).
    async Task OkAsync()
    {
        if (OnOk.HasDelegate) await OnOk.InvokeAsync();
    }

    bool _maskMouseDown;
    bool _maskMouseUp;

    // Close only when a click both STARTS and ENDS on the mask. A cross-boundary drag (press on the
    // mask, release in the panel — or the reverse) is a "changed my mind" gesture that AntD keeps
    // open; its composed click dispatches to the wrap (the mousedown/mouseup common ancestor), so the
    // click handler alone can't tell where the gesture began or ended. The panel stops mousedown AND
    // mouseup propagation, so these wrap handlers only ever fire for events on the mask itself.
    void OnMaskMouseDown() { _maskMouseDown = true; _maskMouseUp = false; }
    void OnMaskMouseUp() => _maskMouseUp = true;

    // A fresh press inside the panel starts a new gesture that can't close — and also clears a STALE
    // mask-down flag from a press that released outside the window (which fires no click to reset it).
    // A consumer's own splatted onmousedown is chained afterwards (see PanelAttributes).
    Task OnPanelMouseDownAsync(MouseEventArgs e)
    {
        OnPanelMouseDown();
        return ConsumerEvent.InvokeAsync(AdditionalAttributes, "onmousedown", e);
    }

    void OnPanelMouseDown() { _maskMouseDown = false; _maskMouseUp = false; }

    async Task OnMaskClickAsync()
    {
        var closeOnMask = _maskMouseDown && _maskMouseUp;
        _maskMouseDown = _maskMouseUp = false;
        if (MaskClosable && closeOnMask) await CancelAsync();
    }

    // The consumer's own splatted onkeydown runs after this component's Escape handling, and
    // unconditionally: every key reaches them, and Keyboard="false" suppresses only the close, never
    // their listener. See PanelAttributes.
    async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && Keyboard) await CancelAsync();
        await ConsumerEvent.InvokeAsync(AdditionalAttributes, "onkeydown", e);
    }
}
