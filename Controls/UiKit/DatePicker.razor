@namespace Controls
@inherits PickerBase

@* Backdrop: closes the dropdown on any outside click without needing JS interop. Rendered as the
   wrapper's previous sibling so placePanel can stack it just under the raised wrapper (the same
   contract as DateRangePicker/Select). tabindex="-1": iOS-class WebKit only synthesizes a click
   from a tap when the target chain contains a focusable element; -1 keeps it out of the Tab order. *@
@if (_open)
{
    <div class="wss-picker-backdrop" tabindex="-1" @onclick="CloseAsync"></div>
}

<div @attributes="AttributeSplat.Rest(AdditionalAttributes)"
     class="@WrapperClass @AttributeSplat.ConsumerClass(AdditionalAttributes)"
     style="@AttributeSplat.MergeStyle(WrapperStyle, AdditionalAttributes)"
     @ref="_wrapperRef"
     @onkeydown="OnWrapperKeyDownAsync" @onkeydown:stopPropagation="@_open">

    @* tabindex="-1": a click on the field's non-input chrome then focuses the field itself instead
       of <body>, so Escape still bubbles through the wrapper's keydown and the focus-out close
       wiring sees focus as inside. (Same pattern as DateRangePicker.) *@
    <div class="wss-picker-input" tabindex="-1" @onclick="OnFieldClickAsync">
        <span class="wss-picker-input-slot">
            <input @ref="_inputRef"
                   class="wss-picker-input-date"
                   id="@Id"
                   data-test-id="@Id"
                   type="text"
                   autocomplete="off"
                   aria-label="@InputLabel"
                   aria-haspopup="dialog"
                   aria-expanded="@(_open ? "true" : "false")"
                   aria-controls="@(_open ? PanelId : null)"
                   aria-required="@AriaRequired"
                   aria-invalid="@(AriaInvalid ? "true" : null)"
                   aria-describedby="@EffectiveAriaDescribedBy"
                   aria-errormessage="@AriaErrorMessage"
                   placeholder="@EffectivePlaceholder"
                   disabled="@Disabled"
                   value="@Display"
                   @oninput="@(e => _edit = e.Value?.ToString() ?? string.Empty)"
                   @onchange="@(() => CommitTextAsync())"
                   @onkeydown="OnInputKeyDownAsync"
                   @onfocus="OnInputFocus" />
        </span>
        <span class="wss-picker-suffix">@PickerIcons.CalendarIcon</span>
        @if (ShowClear)
        {
            <button type="button" class="wss-picker-clear" aria-label="@ClearLabel"
                    @onclick="ClearAsync" @onclick:stopPropagation>@UiKitIcons.CloseCross</button>
        }
    </div>

    @* The typed-text format, for AT only -- merged into the input's aria-describedby (see
       EffectiveAriaDescribedBy). Deliberately NOT folded into the placeholder: that string is the
       Figma spec's own ("Select date"), a documented parameter default, and pinned by a visual
       baseline. Rendered outside the `@if (_open)` block because aria-describedby has to resolve
       whether or not the panel is open, and suppressed entirely when FormatHintLabel is blanked. *@
    @if (FormatHintText is { Length: > 0 } formatHint)
    {
        <span class="wss-sr-only" id="@FormatHintId">@formatHint</span>
    }

    @if (_open)
    {
        @* role="dialog" with focus DELIBERATELY left on the text input, rather than moved into the
           panel on open: this field is type-ahead first (typing filters/commits a date), so stealing
           focus would swallow the user's keystrokes. The contract the combobox-like model needs is
           already honored -- the panel is in the tab order right after the field, Escape closes it
           from anywhere inside the wrapper, and every panel-originated close hands focus back to the
           input (see PickerBase's _pendingInputFocus). See the a11y audit's PKR-5. *@
        <div class="wss-picker-dropdown wss-picker-dropdown-single @(_positioned ? null : "wss-measuring")" @ref="_panelRef"
             id="@PanelId" role="dialog" aria-label="@DialogLabel" tabindex="-1">
            @* The month/year (or decade) the panel currently shows, announced on every navigation --
               prev/next, the header selects, and any keyboard move that crosses out of the view. One
               per panel, present from first render (an aria-live region injected WITH its content is
               not reliably announced). *@
            <div class="wss-sr-only" aria-live="polite" aria-atomic="true">@ViewLabel</div>
            @if (Presets is { Count: > 0 })
            {
                <ul class="wss-picker-presets" aria-label="@PresetsLabel">
                    @foreach (var preset in Presets)
                    {
                        var p = preset;
                        <li>
                            <button type="button" class="wss-picker-preset"
                                    @onclick="@(() => OnPresetClickAsync(p))">@p.Label</button>
                        </li>
                    }
                </ul>
            }
            @if (Mode == DatePickerMode.Month)
            {
                <div class="wss-picker-month">
                    @YearHeaderFragment
                    <div class="wss-picker-month-grid" role="grid" aria-label="@ViewLabel" @ref="_gridRef" @onkeydown="OnMonthGridKeyDown">
                        @foreach (var row in UnitRows(MonthUnits, MonthGridColumns))
                        {
                            <div class="wss-picker-row" role="row">
                                @foreach (var month in row)
                                {
                                    <div class="wss-picker-cell-unit" role="gridcell"
                                         aria-selected="@(IsSelectedMonth(month) ? "true" : null)">
                                        <button type="button" class="@MonthButtonClass(month)"
                                                aria-disabled="@(IsMonthDisabled(month) ? "true" : null)"
                                                tabindex="@(IsMonthFocusStop(month) ? "0" : "-1")"
                                                data-date="@month.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                                aria-label="@month.ToString("MMMM yyyy", PickerCulture)"
                                                aria-current="@(IsCurrentMonth(month) ? "date" : null)"
                                                @onclick="@(() => OnMonthClickAsync(month))">@MonthName(month.Month)</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @ExtraFooterFragment
                    @TodayFooterFragment
                </div>
            }
            else if (Mode == DatePickerMode.Year)
            {
                <div class="wss-picker-month">
                    <div class="wss-picker-month-header">
                        <button type="button" class="wss-picker-nav" aria-label="@PrevDecadeLabel"
                                disabled="@PrevDecadeDisabled" @onclick="PrevDecade">@PickerIcons.PrevIcon</button>
                        <div class="wss-picker-month-selects">
                            <span class="wss-picker-decade-label">@DecadeLabel</span>
                        </div>
                        <button type="button" class="wss-picker-nav" aria-label="@NextDecadeLabel"
                                disabled="@NextDecadeDisabled" @onclick="NextDecade">@PickerIcons.NextIcon</button>
                    </div>
                    <div class="wss-picker-month-grid" role="grid" aria-label="@ViewLabel" @ref="_gridRef" @onkeydown="OnYearGridKeyDown">
                        @foreach (var row in UnitRows(YearUnits, MonthGridColumns))
                        {
                            <div class="wss-picker-row" role="row">
                                @foreach (var yearStart in row)
                                {
                                    var year = yearStart.Year;
                                    <div class="wss-picker-cell-unit" role="gridcell"
                                         aria-selected="@(IsSelectedYear(year) ? "true" : null)">
                                        <button type="button" class="@YearButtonClass(year)"
                                                aria-disabled="@(IsYearDisabled(yearStart) ? "true" : null)"
                                                tabindex="@(IsYearFocusStop(year) ? "0" : "-1")"
                                                data-date="@yearStart.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                                aria-label="@year.ToString(PickerCulture)"
                                                aria-current="@(IsCurrentYear(year) ? "date" : null)"
                                                @onclick="@(() => OnYearClickAsync(year))">@year.ToString(PickerCulture)</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @ExtraFooterFragment
                    @TodayFooterFragment
                </div>
            }
            else if (Mode == DatePickerMode.Quarter)
            {
                <div class="wss-picker-month">
                    @YearHeaderFragment
                    <div class="wss-picker-quarter-grid" role="grid" aria-label="@ViewLabel" @ref="_gridRef" @onkeydown="OnQuarterGridKeyDown">
                        @foreach (var row in UnitRows(QuarterUnits, QuarterGridColumns))
                        {
                            <div class="wss-picker-row" role="row">
                                @foreach (var quarterStart in row)
                                {
                                    var quarter = QuarterOf(quarterStart);
                                    <div class="wss-picker-cell-unit" role="gridcell"
                                         aria-selected="@(IsSelectedQuarter(_viewMonth.Year, quarter) ? "true" : null)">
                                        <button type="button" class="@QuarterButtonClass(_viewMonth.Year, quarter)"
                                                aria-disabled="@(IsQuarterDisabled(quarterStart) ? "true" : null)"
                                                tabindex="@(IsQuarterFocusStop(_viewMonth.Year, quarter) ? "0" : "-1")"
                                                data-date="@quarterStart.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                                aria-label="@($"Q{quarter.ToString(PickerCulture)} {_viewMonth.Year.ToString(PickerCulture)}")"
                                                aria-current="@(IsCurrentQuarter(_viewMonth.Year, quarter) ? "date" : null)"
                                                @onclick="@(() => OnQuarterClickAsync(_viewMonth.Year, quarter))">Q@(quarter.ToString(PickerCulture))</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @ExtraFooterFragment
                    @TodayFooterFragment
                </div>
            }
            else if (Mode == DatePickerMode.Time)
            {
                <div class="wss-picker-month">
                    <PickerTimeRowSlot Picker="this" />
                    @ExtraFooterFragment
                    @TimeFooterFragment
                </div>
            }
            else
            {
                <div class="wss-picker-month">
                    <PickerMonthHeader PrevLabel="@PrevMonthLabel" PrevDisabled="@PrevMonthDisabled" OnPrev="PrevMonth"
                                       NextLabel="@NextMonthLabel" NextDisabled="@NextMonthDisabled" OnNext="NextMonth"
                                       MonthSelectLabel="@MonthSelectLabel" Month="@_viewMonth.Month"
                                       OnMonthChanged="OnMonthSelectChanged"
                                       YearSelectLabel="@YearSelectLabel" Year="@_viewMonth.Year"
                                       YearRange="@YearRange(_viewMonth.Year)" OnYearChanged="OnYearSelectChanged"
                                       Culture="@PickerCulture" />
                    <PickerWeekdayHeader ShowWeekNumberColumn="@ShowWeekRows" Names="@WeekdayHeaders" />
                    @if (ShowWeekRows)
                    {
                        <div class="@(Mode == DatePickerMode.Week ? "wss-picker-grid-rows wss-picker-grid-week" : "wss-picker-grid-rows")" role="grid" aria-label="@ViewLabel" @ref="_gridRef" @onkeydown="OnGridKeyDown">
                            @foreach (var row in GridWeekRows(_viewMonth))
                            {
                                var weekStart = row[0];
                                <div class="@WeekRowClass(weekStart)" role="row">
                                    <div class="wss-picker-week-no" aria-hidden="true">@WeekNumberOf(weekStart).ToString(PickerCulture)</div>
                                    @foreach (var day in row)
                                    {
                                        <div class="wss-picker-cell" role="gridcell" aria-selected="@(IsDaySelected(day) ? "true" : null)">@DayButtonFragment(day)</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @* The flat 42-cell grid still groups its days into 6 role="row" wrappers: an
                           ARIA grid's cells must sit inside rows, and the visual 7-column layout is
                           preserved by .wss-picker-row's `display: contents` (the day cells stay the
                           real grid items). The rows layout above needs no such wrapper -- its
                           .wss-picker-week-row IS the row. *@
                        <div class="wss-picker-grid" role="grid" aria-label="@ViewLabel" @ref="_gridRef" @onkeydown="OnGridKeyDown">
                            @foreach (var row in GridWeekRows(_viewMonth))
                            {
                                <div class="wss-picker-row" role="row">
                                    @foreach (var day in row)
                                    {
                                        <div class="wss-picker-cell" role="gridcell" aria-selected="@(IsDaySelected(day) ? "true" : null)">@DayButtonFragment(day)</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @* DateTime mode appends the same time row + OK footer below the calendar --
                       Mode="Time" (above) renders it alone, this is the only other place it's used.
                       Date/Week mode's ExtraFooter/ShowToday footer (the else branch) has no time
                       row -- ShowToday doesn't apply to DateTime (see ShowTodayLink), only ShowNow. *@
                    @if (Mode == DatePickerMode.DateTime)
                    {
                        <PickerTimeRowSlot Picker="this" />
                        @ExtraFooterFragment
                        @TimeFooterFragment
                    }
                    else
                    {
                        @ExtraFooterFragment
                        @TodayFooterFragment
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    // One day cell's button, rendered identically by BOTH day-grid layouts (the flat 42-cell grid and
    // the week-number rows) -- nine interdependent bits of per-day state (class, aria-disabled, the
    // roving tabindex, the data-date JS focus hook, the full-date accessible name, aria-current, the
    // click, the zero-padded text) that must never diverge between them. Kept as a fragment for the
    // same reason the footer fragments below are. The selection state is NOT here: it lives as
    // aria-selected on the enclosing role="gridcell" wrapper, which is where ARIA allows it (see the
    // grids above).
    //
    // aria-disabled, NOT the native `disabled` attribute: a Min/Max/DisabledDate-rejected day must
    // stay FOCUSABLE. The roving tabindex parks on whichever day arrow navigation last targeted, and
    // a `disabled` button both refuses .focus() (so the focus ring stalls mid-run) and drops out of
    // the tab order entirely (so a grid whose sole tabindex="0" landed on one had no tab stop at all,
    // and a month-crossing re-render onto one blurred focus to <body>, out of reach of the picker's
    // own Escape/arrow handlers). Every commit path guards the same predicate instead -- see
    // OnDayClickAsync and friends -- so a click, or an Enter/Space on a focused disabled cell, no-ops.
    RenderFragment<DateTime> DayButtonFragment => d => @<button type="button" class="@DayClass(d)"
                                                               aria-disabled="@(IsDayDisabled(d) ? "true" : null)"
                                                               tabindex="@(IsFocusStop(d) ? "0" : "-1")"
                                                               data-date="@d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                                               aria-label="@d.ToString("D", PickerCulture)"
                                                               aria-current="@(IsToday(d) ? "date" : null)"
                                                               @onclick="@(() => OnDayClickAsync(d))">@d.Day.ToString("00", CultureInfo.CurrentCulture)</button>;

    // Month mode's header (prev-year nav / year select / next-year nav), shared verbatim with
    // Quarter mode -- the 4-quarter grid still needs to know which year it's showing, and that's
    // exactly what this header already picks. See DatePicker.razor.cs's "Month mode: grid + year
    // navigation" section for PrevYear/NextYear/YearRange/OnYearSelectChanged.
    RenderFragment YearHeaderFragment => @<div class="wss-picker-month-header">
        <button type="button" class="wss-picker-nav" aria-label="@PrevYearLabel"
                disabled="@PrevYearDisabled" @onclick="PrevYear">@PickerIcons.PrevIcon</button>
        <div class="wss-picker-month-selects">
            <span class="wss-picker-select">
                <select aria-label="@YearSelectLabel" value="@_viewMonth.Year"
                        @onchange="OnYearSelectChanged">
                    @{ var (fromYear, toYear) = YearRange(_viewMonth.Year); }
                    @for (var y = fromYear; y <= toYear; y++)
                    {
                        <option value="@y" selected="@(y == _viewMonth.Year)">@y.ToString(PickerCulture)</option>
                    }
                </select>
                @PickerIcons.DownIcon
            </span>
        </div>
        <button type="button" class="wss-picker-nav" aria-label="@NextYearLabel"
                disabled="@NextYearDisabled" @onclick="NextYear">@PickerIcons.NextIcon</button>
    </div>;

    // AntD's renderExtraFooter strip, which every one of the six panel shapes below the grid renders
    // identically (and always in the same place: below the grid/time row, above whatever footer the
    // mode has of its own). The null check lives INSIDE the fragment so no call site can forget it.
    RenderFragment ExtraFooterFragment => @<text>@if (ExtraFooter is not null)
        {
            <div class="wss-picker-extra-footer">@ExtraFooter</div>
        }</text>;

    // ShowToday's footer, rendered by Date/Month/Quarter/Year/Week -- every mode that isn't
    // Time/DateTime (see ShowTodayLink, which is what makes this a no-op in those two). The button
    // renders DISABLED, not hidden, when the normalized today is rejected -- same "show the dead end"
    // convention every rejected calendar cell follows. Natively `disabled` here, unlike those cells:
    // a footer link is not part of a roving-tabindex grid, so nothing needs it to stay focusable.
    RenderFragment TodayFooterFragment => @<text>@if (ShowTodayLink)
        {
            <div class="wss-picker-footer wss-picker-footer-split">
                <button type="button" class="wss-picker-today-btn"
                        disabled="@IsDisabledForCommit(TodayForCommit)"
                        @onclick="OnTodayClickAsync">@TodayText</button>
            </div>
        }</text>;

    // Time/DateTime's own footer: the optional ShowNow link (left) plus OK (right, always) -- those
    // two modes commit incrementally, so OK is their close signal rather than a commit. Unlike the
    // Today footer above, the row itself always renders; TimeFooterClass switches it to
    // space-between only when the Now link actually renders alongside OK.
    RenderFragment TimeFooterFragment => @<div class="@TimeFooterClass">
        @if (ShowNowLink)
        {
            <button type="button" class="wss-picker-today-btn"
                    disabled="@IsDisabledForCommit(NowForCommit)"
                    @onclick="OnNowClickAsync">@NowText</button>
        }
        <button type="button" class="wss-picker-ok" @onclick="OnPickerOkAsync">@OkText</button>
    </div>;
}
