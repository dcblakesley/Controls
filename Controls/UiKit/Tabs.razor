@namespace Controls

@* Every live Tab is marked dirty before this pass' markup is built: a Tab renders its own nav
   button, and strip-level state (which tab is active, whether a panel exists, BaseId) is invisible
   to Blazor's parameter diff, so nothing else would re-render a button whose own parameters are
   unchanged. They render later in this same batch and read the settled state. *@
@{ BeginPass(); }

<div @attributes="AttributeSplat.Rest(AdditionalAttributes)"
     class="wss-tabs @(Type == TabsType.Card ? "wss-tabs-card" : null) @AttributeSplat.ConsumerClass(AdditionalAttributes)"
     style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">

    @if (TabBarExtraContent is not null)
    {
        <div class="wss-tabs-nav-wrapper">
            @NavFragment
            <div class="wss-tabs-nav-extra">@TabBarExtraContent</div>
        </div>
    }
    else
    {
        @NavFragment
    }

    @if (HasPanel)
    {
        @* One panel, re-labelled per active tab — its content swaps with the selection. *@
        <div class="wss-tabs-panel" role="tabpanel" id="@($"{BaseId}-panel")"
             aria-labelledby="@($"{BaseId}-tab-{ActiveTab!.Key}")">
            @ActiveTab!.ChildContent
        </div>
    }
</div>

@code {
    // Factored out of the markup above so TabBarExtraContent's wrapping div is only ever present
    // when it's actually set (see the @if/@else above) without duplicating this block verbatim.
    RenderFragment NavFragment =>
        @<div class="wss-tabs-nav @(Centered ? "wss-tabs-nav-centered" : null)" role="tablist" aria-label="@TablistLabel">
            @* ChildContent renders HERE, and each Tab emits its own nav button (see Tab.razor), so
               the strip's button order IS the ChildContent's document order -- placed by the
               render-tree diff, which is the only thing that knows where a conditionally rendered
               tab was declared. Nothing this component tracks can move a BUTTON.

               The tab LIST behind the arrow keys and the first-enabled fallback is a separate thing,
               rebuilt from child registrations, and a parameter-skipped Tab never registers. @key is
               how that list is made exact: on the rare pass whose registrations could not place a
               newcomer, BeginPass bumps _generation, the diff drops this subtree and builds it again,
               and every Tab constructs and registers in document order. Only Tab instances are inside
               it (the pane below the nav renders ActiveTab.ChildContent from the strip's OWN tree, so
               a consumer's pane component is never re-created) -- see Tabs.ResolveOrder.

               IsFixed: a Tab's owning strip never changes, so no subscription bookkeeping -- and
               dropping it would not recover declaration order anyway, only subscription order. *@
            <CascadingValue Value="this" IsFixed="true" @key="_generation">
                @ChildContent
            </CascadingValue>
        </div>;
}
