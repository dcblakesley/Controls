@namespace Controls

@* Shared presentational view for toast messages. Rendered by both WasmMessageContainer (static)
   and MessageContainer (scoped) so the two paths produce identical DOM. *@
@* Two always-present live regions (a polite one for normal severities, an assertive one for
   errors) rather than a single region whose politeness flips when an error arrives — screen
   readers latch a region's politeness when it first appears and don't reliably re-evaluate a
   later aria-live change, so the flip could swallow the very error it was meant to escalate.
   The regions are display:contents, so the .wss-msg items keep the container's flex/gap layout
   unchanged (errors group below the polite toasts). *@
<div class="wss-msg-container">
    <div class="wss-msg-region" role="status" aria-live="polite" aria-atomic="false">
        @foreach (var m in Items)
        {
            @if (m.Type != MessageType.Error)
            {
                @Row(m)
            }
        }
    </div>
    <div class="wss-msg-region" role="alert" aria-live="assertive" aria-atomic="false">
        @foreach (var m in Items)
        {
            @if (m.Type == MessageType.Error)
            {
                @Row(m)
            }
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<MessageItem> Items { get; set; } = Array.Empty<MessageItem>();

    /// <summary>Invoked with the item id when its close button is clicked.</summary>
    [Parameter] public EventCallback<Guid> OnRemove { get; set; }

    /// <summary>
    /// Invoked with the item id when the pointer enters or keyboard focus lands inside the toast, so
    /// a container can pause its auto-dismiss countdown (WCAG 2.2.1). See
    /// <see cref="ToastQueue{TItem}.Pause"/>.
    /// </summary>
    [Parameter] public EventCallback<Guid> OnPause { get; set; }

    /// <summary>
    /// Invoked with the item id when the pointer leaves or keyboard focus moves out of the toast, so
    /// a container can restart its auto-dismiss countdown. See <see cref="ToastQueue{TItem}.Resume"/>
    /// -- hover and focus leaving separately (and each firing this) is expected and harmless.
    /// </summary>
    [Parameter] public EventCallback<Guid> OnResume { get; set; }

    // One item template for both regions (mirrors NotificationListView.Row) — the assertive region
    // only ever receives Error items, so the computed severity class is the same "error" it used to
    // hardcode, with no second copy of the markup to drift.
    RenderFragment Row(MessageItem m) => @<div class="wss-msg" @key="m.Id"
        @onmouseenter="() => OnPause.InvokeAsync(m.Id)" @onmouseleave="() => OnResume.InvokeAsync(m.Id)"
        @onfocusin="() => OnPause.InvokeAsync(m.Id)" @onfocusout="() => OnResume.InvokeAsync(m.Id)">
        <span class="wss-msg-icon wss-msg-icon-@m.Type.ToString().ToLowerInvariant()">@Icon(m.Type)</span>
        <span class="wss-sr-only">@SeverityLabel(m.Type)</span>
        <span class="wss-msg-content">@m.Content</span>
        <button type="button" class="wss-msg-close" aria-label="Close" @onclick="() => OnRemove.InvokeAsync(m.Id)">
            @UiKitIcons.CloseCross
        </button>
    </div>;

    // The spin comes from .wss-msg-icon-loading on the surrounding span (wss-controls.css), which is
    // why the shared LoadingSpinner glyph — deliberately animation-free — drops straight in here.
    static MarkupString Icon(MessageType type) => type switch
    {
        MessageType.Success => UiKitIcons.ToastSuccess,
        MessageType.Warning => UiKitIcons.ToastWarning,
        MessageType.Error => UiKitIcons.ToastError,
        MessageType.Loading => EditIcons.LoadingSpinner,
        _ => UiKitIcons.ToastInfo,
    };

    // Sighted users tell severity apart by the icon's shape (never just color -- WCAG 1.4.1); the
    // icon is aria-hidden, so assistive tech needs the word instead. Hardcoded English, matching the
    // kit's existing unlocalized "Close" convention -- see the accessibility audit for the i18n
    // limitation this carries forward.
    static string SeverityLabel(MessageType type) => type switch
    {
        MessageType.Success => "Success: ",
        MessageType.Warning => "Warning: ",
        MessageType.Error => "Error: ",
        MessageType.Loading => "Loading: ",
        _ => "Info: ",
    };
}
