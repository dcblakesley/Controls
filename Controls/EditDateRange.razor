@namespace Controls
@inherits EditControlParametersBase

@if (ShouldShowComponent())
{
    @* Each of these walks the EditContext's message list, and the markup below needs the pair five
       times between them (twice each for the picker's aria-* arguments, plus IsEndInvalid again
       inside FieldCssClass). Captured into locals rather than fields: validation state changes
       outside the parameter lifecycle, so a field would go stale. *@
    var startInvalid = IsStartInvalid;
    var endInvalid = IsEndInvalid;
    var fieldCssClass = FieldCssClass(endInvalid);

    <div class="edit-control-wrapper @ContainerClass">
        <FormLabel Id=@_id FieldIdentifier=@_startFieldIdentifier Attributes=@_attributes Label=@Label LabelContent=@LabelContent IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@ShowEditor />

        @if (ShowEditor)
        {
            <DateRangePicker @ref="_picker"
                             Start="Start"
                             StartChanged="OnStartChanged"
                             End="End"
                             EndChanged="OnEndChanged"
                             OnStartParseError="OnStartParseErrorAsync"
                             OnEndParseError="OnEndParseErrorAsync"
                             OnStartRangeError="OnStartRangeErrorAsync"
                             OnEndRangeError="OnEndRangeErrorAsync"
                             OnValidCommit="OnPickerValidCommit"
                             Id="@_id"
                             EndId="@_endId"
                             StartAutocomplete="@EffectiveStartAutocomplete"
                             EndAutocomplete="@EffectiveEndAutocomplete"
                             Mode="@Mode"
                             Presets="Presets"
                             Min="@EffectiveMin"
                             Max="@EffectiveMax"
                             DisabledDate="@DisabledDate"
                             StartDisabledTime="@StartDisabledTime"
                             EndDisabledTime="@EndDisabledTime"
                             Format="@EffectiveFormat"
                             StartPlaceholder="@EffectiveStartPlaceholder"
                             EndPlaceholder="@EffectiveEndPlaceholder"
                             AllowClear="@AllowClear"
                             Disabled="@IsDisabled"
                             Width="@Width"
                             Size="@Size"
                             FirstDayOfWeek="@FirstDayOfWeek"
                             ShowWeekNumbers="@ShowWeekNumbers"
                             ShowSeconds="@ShowSeconds"
                             HourStep="@HourStep"
                             MinuteStep="@MinuteStep"
                             SecondStep="@SecondStep"
                             Use12Hours="@Use12Hours"
                             HideDisabledTimeOptions="@HideDisabledTimeOptions"
                             OkText="@OkText"
                             ExtraFooter="@ExtraFooter"
                             DefaultViewDate="@DefaultViewDate"
                             StartInputLabel="@EffectiveStartInputLabel"
                             EndInputLabel="@EffectiveEndInputLabel"
                             GroupLabelledBy="@GroupLabelledBy"
                             DialogLabel="@EffectiveDialogLabel"
                             MonthSelectLabel="@MonthSelectLabel"
                             YearSelectLabel="@YearSelectLabel"
                             ClearLabel="@ClearLabel"
                             PresetsLabel="@PresetsLabel"
                             PrevMonthLabel="@PrevMonthLabel"
                             NextMonthLabel="@NextMonthLabel"
                             PrevYearLabel="@PrevYearLabel"
                             NextYearLabel="@NextYearLabel"
                             PrevDecadeLabel="@PrevDecadeLabel"
                             NextDecadeLabel="@NextDecadeLabel"
                             HourSelectLabel="@HourSelectLabel"
                             MinuteSelectLabel="@MinuteSelectLabel"
                             SecondSelectLabel="@SecondSelectLabel"
                             PeriodSelectLabel="@PeriodSelectLabel"
                             WeekLabel="@WeekLabel"
                             FormatHintLabel="@FormatHintLabel"
                             RangeHintMinLabel="@RangeHintMinLabel"
                             RangeHintMaxLabel="@RangeHintMaxLabel"
                             StartAriaRequired="@_isRequired"
                             StartAriaInvalid="@startInvalid"
                             StartAriaDescribedBy="@_describedBy"
                             StartAriaErrorMessage="@(startInvalid ? _errorMsgId : null)"
                             EndAriaRequired="@_endIsRequired"
                             EndAriaInvalid="@endInvalid"
                             EndAriaDescribedBy="@_endDescribedBy"
                             EndAriaErrorMessage="@(endInvalid ? _endErrorMsgId : null)"
                             @attributes="PickerAttributes(fieldCssClass)" />
        }
        else
        {
            <ReadOnlyValue Id=@_id CssClass=@fieldCssClass Text=@GetDisplayValue() />
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=_startFieldIdentifier Attributes=_attributes Label=@Label />
        <FieldValidationDisplay Id=@_endId FieldIdentifier=_endFieldIdentifier Attributes=_endAttributes Label=@EndLabel />

        <BoundValueDisplay Text=@GetDisplayValue() />
    </div>
}
