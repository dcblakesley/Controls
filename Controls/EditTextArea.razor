@inherits EditTextInputBase

@if (ShouldShowComponent())
{
    @* The consumer's `style` lands on the wrapper (one rule for every control -- see EditControlBase's
       unmatched-attribute remarks), which for this control is also the only safe home for it: the
       <textarea>'s own inline style is JS-owned while AutoSize is on (see AutoSizeAsync). *@
    <div class="edit-control-wrapper @ContainerClass"
         style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">
        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label LabelContent=@LabelContent IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@ShowEditor />

        @if (ShowEditor)
        {
            <EditInputShell IsInvalid=@IsInvalid
                            IsDisabled=@IsDisabled
                            WrapperClass=@(EditInputShell.SizeClass(Size))
                            AllowClear=@AllowClear
                            IsClearable=@IsClearable
                            OnClear=@Clear
                            ClearButtonLabel=@EffectiveClearButtonLabel
                            CountText=@CountText
                            CountId=@CountId
                            CountAccessibleText=@CountAccessibleText
                            CountLimitStatus=@CountLimitStatus
                            CountBelow="true">
                @* One @attributes per element, so the consumer's unmatched attributes, this control's
                   own oninput handler (live text + the AutoSize re-measure) and its state attributes
                   (disabled/aria-*) are all merged into EditorAttributes -- the control's own win --
                   and the splat is FIRST, so every explicitly-written attribute below, including the
                   ones @bind-value emits, wins over a consumer's. `class` travels CssClass and `style`
                   the wrapper, so AttributeSplat withholds both; a null merge emits no frames at all.

                   The CONDITIONAL attributes ride the merged dictionary rather than being written
                   explicitly below, deliberately -- see EditControlBase.EditorStateAttributes: an
                   explicit frame wins outright over an earlier same-named one even when its own value
                   is null, so writing them here would DELETE a consumer's splatted
                   `disabled`/`aria-*` rather than merely decline to override it. *@
                <textarea @attributes="EditorAttributes"
                          @bind-value=@CurrentValue
                          @bind-value:event="@UpdateEventName"
                          @bind-value:after="OnValueCommittedAsync"
                          @ref="_editorRef"
                          id=@_id
                          data-test-id=@_id
                          class=@InputClass
                          rows=@EffectiveRows
                          maxlength=@EffectiveMaxLength
                          placeholder=@EffectivePlaceholder
                          aria-labelledby="lbltext-@_id"
                          aria-describedby=@_describedBy></textarea>
            </EditInputShell>
        }
        else
        {
            <ReadOnlyValue Id=@_id CssClass=@CssClass Text=@Value AriaDescribedBy=@_describedBy />
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
        <BoundValueDisplay Text=@CurrentValueAsString />
    </div>
}