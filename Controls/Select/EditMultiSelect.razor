@namespace Controls
@typeparam TValue
@inherits EditControlListBase<TValue>

@if (ShouldShowComponent())
{
    @* Unmatched attributes (style, data-*, title, ...) land on the wrapper — splatted FIRST so the
       explicit attributes below win. `class` is deliberately NOT re-emitted here: AttributeSplat.Rest
       withholds it and FieldCssClass already carries the consumer's class (merged with the field-state
       classes) through to the engine's own wrapper, which must stay the single channel for it. The
       engine's wrapper is also why the splat can't go there — its inline style is JS-owned (the
       open-order z-index). *@
    <div @attributes="AttributeSplat.Rest(AdditionalAttributes)"
         class="edit-control-wrapper @ContainerClass"
         style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">
        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@ShowEditor />

        @if (ShowEditor)
        {
            <Select TValue="TValue"
                    Mode="Mode"
                    Values="Value"
                    ValuesChanged="OnValuesChanged"
                    Options="Options"
                    Placeholder="@EffectivePlaceholder"
                    Disabled="IsDisabled"
                    AllowClear="AllowClear"
                    ShowSearch="ShowSearch"
                    ShowArrow="ShowArrow"
                    Loading="Loading"
                    Size="Size"
                    Variant="Variant"
                    Prefix="Prefix"
                    Width="@Width"
                    MaxTagCount="MaxTagCount"
                    TagValueFactory="TagValueFactory"
                    EmptyText="@EmptyText"
                    EmptyContent="EmptyContent"
                    FilterOption="FilterOption"
                    DropdownFooter="DropdownFooter"
                    DebounceMilliseconds="DebounceMilliseconds"
                    OnSearch="OnSearch"
                    DefaultOpen="DefaultOpen"
                    Open="Open"
                    OpenChanged="OpenChanged"
                    Id="@_id"
                    CssClass="@FieldCssClass"
                    RemoveItemLabelFormat="@RemoveItemLabelFormat"
                    ClearSelectionsLabel="@ClearSelectionsLabel"
                    ListboxLabel="@ListboxLabel"
                    AriaRequired="@_isRequired"
                    AriaInvalid="@IsInvalid"
                    AriaDescribedBy="@_describedBy"
                    AriaErrorMessage="@(IsInvalid ? _errorMsgId : null)" />
        }
        else
        {
            <ReadOnlyValue Id=@_id CssClass=@FieldCssClass Text=@SelectedLabels />
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
        @if (FormOptions != null && FormOptions.ShowBoundValues)
        {
            <div class="bound-value">@string.Join(", ", Value ?? [])</div>
        }
    </div>
}
