@namespace Controls
@typeparam TValue
@inherits EditControlBase<TValue>

@if (ShouldShowComponent())
{
    @* The consumer's `style` lands on the wrapper (one rule for every control -- see EditControlBase's
       unmatched-attribute remarks), which for this control is also the only safe home for it: the
       engine's own wrapper carries a JS-owned inline z-index while its dropdown is open. Everything
       else is forwarded to the engine's AdditionalAttributes and splatted onto that wrapper -- the
       element that actually represents this field. The one exception is `aria-label`, which the engine
       lifts off that wrapper onto its role="combobox" input, the only element it can name. *@
    <div class="edit-control-wrapper @ContainerClass"
         style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">
        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@ShowEditor />

        @if (ShowEditor)
        {
            <Select TValue="TValue"
                    Value="CurrentValue"
                    ValueChanged="OnValueChanged"
                    Options="Options"
                    Mode="SelectMode.Single"
                    Placeholder="@EffectivePlaceholder"
                    Disabled="IsDisabled"
                    AllowClear="AllowClear"
                    ShowSearch="ShowSearch"
                    ShowArrow="ShowArrow"
                    Loading="Loading"
                    Size="Size"
                    Variant="Variant"
                    Prefix="Prefix"
                    Width="@Width"
                    EmptyText="@EmptyText"
                    EmptyContent="EmptyContent"
                    FilterOption="FilterOption"
                    DropdownFooter="DropdownFooter"
                    DebounceMilliseconds="DebounceMilliseconds"
                    OnSearch="OnSearch"
                    DefaultOpen="DefaultOpen"
                    Open="Open"
                    OpenChanged="OpenChanged"
                    Id="@_id"
                    CssClass="@CssClass"
                    ClearSelectionLabel="@ClearSelectionLabel"
                    ListboxLabel="@ListboxLabel"
                    ResultCountAnnouncementFormat="@ResultCountAnnouncementFormat"
                    SelectedAnnouncementFormat="@SelectedAnnouncementFormat"
                    SelectionClearedAnnouncement="@SelectionClearedAnnouncement"
                    LoadingAnnouncement="@LoadingAnnouncement"
                    AriaRequired="@_isRequired"
                    AriaInvalid="@IsInvalid"
                    AriaLabelledBy="@($"lbltext-{_id}")"
                    AriaDescribedBy="@_describedBy"
                    AriaErrorMessage="@(IsInvalid ? _errorMsgId : null)"
                    AdditionalAttributes="@AttributeSplat.Rest(AdditionalAttributes)" />
        }
        else
        {
            <ReadOnlyValue Id=@_id CssClass=@CssClass Text=@SelectedLabel />
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
        <BoundValueDisplay Text=@CurrentValueAsString />
    </div>
}
