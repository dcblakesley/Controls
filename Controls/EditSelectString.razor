@typeparam TValue
@inherits EditSelectBase<TValue>

@if (ShouldShowComponent())
{
    <div class="edit-control-wrapper @ContainerClass">
        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@ShowEditor />

        @if (ShowEditor)
        {
            <select @bind=@CurrentValueAsString
                    id=@_id
                    data-test-id=@_id
                    disabled=@IsDisabled
                    class=@($"edit-input edit-select-select {CssClass}")
                    aria-required=@_isRequired
                    aria-invalid=@(IsInvalid ? "true" : null)
                    aria-errormessage=@(IsInvalid ? _errorMsgId : null)
                    aria-describedby=@_describedBy>

                @* Options rendered by the shared SelectOptionList (see its source for why the leading
                   null option / unmatched-value placeholder exist): the leading null option is
                   suppressed when the consumer opts out (NullOptionText=null) or TValue can't be null
                   (non-nullable value type). The placeholder covers an unmatched current value (an
                   untouched default like 0, or a stale model value not in Options) when the null
                   option above isn't already showing blank. Coalesce to "" so the non-nullable
                   Options.Contains stays warning-clean; a value-type CurrentValueAsString is never
                   null, and a null on an opt-out reference type matches "" only if the consumer
                   authored a "" option, which correctly needs no placeholder. *@
                <SelectOptionList TItem="string"
                                  Options=@Options
                                  Id=@_id
                                  CssClass=@CssClass
                                  Tooltip=@_attributes.Tooltip()
                                  CurrentValueAsString=@CurrentValueAsString
                                  ShowNullOption=@ShowNullOption
                                  NullOptionText=@EffectiveNullOptionText
                                  ShowPlaceholder=@(!ShowNullOption && !Options.Contains(CurrentValueAsString ?? ""))
                                  PlaceholderText=@_attributes.Placeholder()
                                  DisplayText="@(o => o)"
                                  ValueString="@(o => o)" />
            </select>
        }
        else
        {
            <ReadOnlyValue Id=@_id CssClass=@CssClass Text=@CurrentValueAsString />
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
        @if (FormOptions != null && FormOptions.ShowBoundValues)
        {
            <div class="bound-value">@CurrentValueAsString</div>
        }
    </div>
}
