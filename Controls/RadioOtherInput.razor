@* Attribute order is deliberate and matches what EditRadioEnum rendered inline before this was
   extracted: the splat sits between `value` and the explicit attributes, so an explicit attribute
   always wins over a same-named splatted one (and the rendered attribute order is unchanged). *@
<input type="text"
       value="@Value"
       @attributes="CommitAttributes"
       disabled="@IsDisabled"
       class="edit-input edit-radio-other-input"
       aria-label="Custom text value input"
       placeholder="@Placeholder"
       id="@Id"
       data-test-id="@Id" />
