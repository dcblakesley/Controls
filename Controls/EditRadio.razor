@inherits InputRadioGroup<TValue>
@typeparam TValue

@if (ShouldShowComponent())
{
    <div class="edit-control-wrapper @ContainerClass">
        @* The id/data-test-id/role/aria-* block is shared with EditRadioEnum/EditRadioString via
           RadioAria (splatted first so the explicit class below wins). CssClass (InputBase: consumer
           class + field-state classes) goes on the fieldset — unlike those two this control doesn't
           render its own radio inputs (they come from ChildContent), so the group root is the only
           element it owns to carry the class. Edit mode only: the read-only branch already forwards
           CssClass to its ReadOnlyValue. *@
        <fieldset @attributes="RadioAria.Fieldset(ShowEditor, _id, _isRequired, IsInvalid, _describedBy, _errorMsgId)"
                  class="edit-radio-fieldset @(ShowEditor ? CssClass : null)">
       <FormLabel Id=@_id
                  FieldIdentifier=@_fieldIdentifier 
                  Attributes=@_attributes 
                  Label=@Label
                  IsRequired=@IsRequiredResolved
                  Description=@Description
                  Tooltip=@Tooltip 
                  IsLegend=true
                  IsLabelHidden=@ShouldHideLabel />

            @if (ShowEditor)
            {
                @* InputRadioGroup renders no HTML element, so a `disabled` attribute on it goes
                   nowhere — the nested fieldset natively disables every descendant radio instead.
                   ValueExpression is forwarded so the inner group notifies/styles the real model
                   field rather than a bogus FieldIdentifier("CurrentValue"). *@
                <InputRadioGroup TValue="TValue" Value=@CurrentValue ValueChanged=@OnGroupValueChanged ValueExpression=@ValueExpression>
                    <fieldset class="edit-radio-disable-scope" disabled=@IsDisabled>
                        <div class=@(IsHorizontal
                                              ? "edit-radio-buttons-container-horizontal"
                                              : "edit-radio-buttons-container-vertical")>
                            @ChildContent
                        </div>
                    </fieldset>
                </InputRadioGroup>
            }
            else
            {
                <ReadOnlyValue Id=@_id CssClass=@CssClass Text=@CurrentValueAsString />
            }

            <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
            <BoundValueDisplay Text=@CurrentValueAsString />
        </fieldset>
    </div>
}