@typeparam TEnum
@inherits EditControlBase<TEnum>

@if (ShouldShowComponent())
{
    @* The consumer's `style` lands on the wrapper (one rule for every control -- see EditControlBase's
       unmatched-attribute remarks); the remaining unmatched attributes go on the <select> below. *@
    <div class="edit-control-wrapper @ContainerClass"
         style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">
        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@ShowEditor />

        @if (ShowEditor)
        {
            @* Splat first so every explicit attribute below wins. *@
            <select @attributes="AttributeSplat.Rest(AdditionalAttributes)"
                    @bind=@CurrentValueAsString
                    disabled=@IsDisabled
                    class=@($"edit-input edit-select-select {CssClass}")
                    id=@_id
                    data-test-id=@_id
                    aria-required=@_isRequired
                    aria-invalid=@(IsInvalid ? "true" : null)
                    aria-errormessage=@(IsInvalid ? _errorMsgId : null)
                    aria-describedby=@_describedBy>

                @* Options rendered by the shared SelectOptionList (see its source for why the leading
                   null option / unmatched-value placeholder exist): the leading null option gates on
                   _isNullable, the placeholder on an unmatched value for a non-nullable enum (a
                   nullable enum's only "no match" case is null, already covered by the null option). *@
                <SelectOptionList Options=@GetOptions()
                                  Id=@_id
                                  CssClass=@CssClass
                                  Tooltip=@_attributes.Tooltip()
                                  CurrentValueAsString=@CurrentValueAsString
                                  ShowNullOption=@_isNullable
                                  NullOptionText=@EffectiveNullOptionText
                                  ShowPlaceholder=@(!_isNullable && !GetOptions().Any(o => Equals(o?.ToString(), CurrentValueAsString)))
                                  PlaceholderText=@_attributes.Placeholder()
                                  DisplayText="@(o => o?.GetName())"
                                  ValueString="@(o => o?.ToString())" />
            </select>
        }
        else
        {
            <ReadOnlyValue Id=@_id CssClass=@CssClass Text=@Value?.GetName() />
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
        <BoundValueDisplay Text=@CurrentValueAsString />
    </div>
}
