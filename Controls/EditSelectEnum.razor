@typeparam TEnum
@inherits EditControlBase<TEnum>

@if (ShouldShowComponent())
{
    <div class="edit-control-wrapper @ContainerClass">
        <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable=@ShowEditor />

        @if (ShowEditor)
        {
            <select @bind=@CurrentValueAsString
                    disabled=@IsDisabled
                    class=@($"edit-input edit-select-select {CssClass}")
                    id=@_id
                    data-test-id=@_id
                    aria-required=@_isRequired
                    aria-invalid=@(IsInvalid ? "true" : null)
                    aria-errormessage=@(IsInvalid ? _errorMsgId : null)
                    aria-describedby=@_describedBy>

                @* Nullable enum: a leading empty option so null is selectable and a null value shows
                   blank instead of silently displaying the first member. selected= is explicit so the
                   right option is already marked in the initial HTML -- without JS attached yet
                   (prerender/tests), the browser otherwise defaults to the first <option> regardless
                   of the bound value (mirrors EditSelectString's fix for the same gap). *@
                @if (_isNullable)
                {
                    <option class=@($"edit-select-option {CssClass}")
                            value=""
                            selected=@(string.IsNullOrEmpty(CurrentValueAsString))
                            id=@($"{_id}-option-none")
                            data-test-id=@($"{_id}-option-none")>
                        @NullOptionText
                    </option>
                }
                @* An unmatched current value (e.g. an underlying int with no defined enum member) must
                   still display blank -- otherwise the browser silently selects the first real option
                   while the model holds something else. Only reachable for a non-nullable enum; a
                   nullable enum's only "no match" case is null, already covered above. *@
                @if (!_isNullable && !GetOptions().Any(o => Equals(o?.ToString(), CurrentValueAsString)))
                {
                    <option class=@($"edit-select-option {CssClass}")
                            value=""
                            disabled
                            hidden
                            selected
                            id=@($"{_id}-option-placeholder")
                            data-test-id=@($"{_id}-option-placeholder")></option>
                }
                @foreach (var o in GetOptions())
                {
                    <option title=@_attributes.Tooltip()
                            class=@($"edit-select-option {CssClass}")
                            value=@o
                            selected=@(Equals(o?.ToString(), CurrentValueAsString))
                            id=@($"{_id}-option-{o.ToId()}")
                            data-test-id=@($"{_id}-option-{o.ToId()}")>

                        @o?.GetName()
                    </option>
                }
            </select>
        }
        else
        {
            <ReadOnlyValue Id=@_id IsLabelHidden=@ShouldHideLabel CssClass=@CssClass Text=@Value?.GetName() />
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
        @if (FormOptions != null && FormOptions.ShowBoundValues)
        {
            <div class="bound-value">@CurrentValueAsString</div>
        }
    </div>
}
