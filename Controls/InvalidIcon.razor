@* Renders the design-required red-X invalid indicator inside an input-positioned wrapper.
   Place inside a positioned ancestor — typically the per-control wrapper div around the
   <input>/<textarea>/<InputDate>. The host passes its resolved IsInvalid state (previously this
   substring-matched "invalid" in CssClass, which false-positived on consumer classes like
   "invalid-style-fix"). *@

@if (IsInvalid)
{
    @Glyph
}

@code {
    /// <summary> Whether the host field currently has a validation error. </summary>
    [Parameter] public bool IsInvalid { get; set; }

    // AntD CloseCircleFilled, from the single copy of the path in EditIcons — this wrapper's class
    // and viewBox differ from EditIcons.ClearCircle's, so only the path itself is shared. Kept a
    // MarkupString (not element markup with a bound `d`) so the glyph stays one static blob, the
    // same shape every other icon in the library renders as.
    static readonly MarkupString Glyph = new(
        $"<svg aria-hidden=\"true\" class=\"edit-icon-invalid\" focusable=\"false\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1024 1024\"><path d=\"{EditIcons.ClearCirclePath}\"></path></svg>");
}
