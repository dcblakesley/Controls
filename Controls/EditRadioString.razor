@inherits RadioGroupControlBase<string?>

@if (ShouldShowComponent())
{
    @* The consumer's `style` lands on the wrapper (one rule for every control -- see EditControlBase's
       unmatched-attribute remarks); the remaining unmatched attributes go on the radiogroup fieldset. *@
    <div class="edit-control-wrapper @ContainerClass"
         style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)">

        @* id/data-test-id/role/aria-* come from RadioAria, shared with EditRadio/EditRadioEnum;
           splatted first so the explicit class below wins, and merged with the consumer's own
           unmatched attributes (RadioAria's keys win; one element, one @attributes).
           RAD-7: the explicit role below drops it when the group would own no radios. It stays off in
           read-only mode too -- RadioAria.Fieldset already emits nothing there, and re-adding the role
           here would recreate the very aria-required-children violation this prevents (a radiogroup
           whose children are ReadOnlyValue divs). NOTE both comments live OUT here: a Razor comment
           placed between attributes INSIDE the tag silently corrupts the attributes that follow it. *@
        <fieldset @attributes="AttributeSplat.RestWith(AdditionalAttributes, RadioAria.Fieldset(ShowEditor, _id, _isRequired, IsInvalid, _describedBy, _errorMsgId, isHorizontal: IsHorizontal || OptionType == RadioOptionType.Button))"
                  role=@(ShowEditor && HasAnyOption ? "radiogroup" : null)
                  class="edit-radio-fieldset">
            <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label LabelContent=@LabelContent IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLegend=true IsLabelHidden=@ShouldHideLabel />

            @if (ShowEditor)
            {
                @* ValueExpression forwarded so the inner group notifies/styles the real model field;
                   `disabled` would be a no-op here (InputRadioGroup renders no element) — each
                   InputRadio below carries it individually. *@
                <InputRadioGroup Value=@SelectedOption ValueChanged=@((string? v) => SelectedOption = v) ValueExpression=@ValueExpression>

                    @if (OptionType == RadioOptionType.Button)
                    {
                        @* Button mode is inherently horizontal (AntD's segmented look) -- IsHorizontal
                           is ignored here rather than composed with it. Same InputRadio/keyboard
                           semantics as default mode, just styled as a visually-hidden input + sibling
                           label button (the established styled-checkbox technique). *@
                        <div class=@ButtonGroupClass>
                            @for (var i = 0; i < Options.Count; i++)
                            {
                                var option = Options[i];
                                <RadioOptionItem Value=@option IsButtonMode="true" IsDisabled=@IsOptionNativelyDisabledFor(option) IsLocked=@IsOptionLockedFor(option) Id=@_id IdSuffix=@(_optionIds[i]) CssClass=@CssClass LabelClass=@LabelClass Display=@option />
                            }
                            @if (HasOther)
                            {
                                <RadioOptionItem Value=@_otherName IsButtonMode="true" IsDisabled=@IsDisabled Id=@_id IdSuffix="other" CssClass=@CssClass LabelClass=@LabelClass Display="Other" />
                            }
                        </div>
                        @if (HasOther)
                        {
                            <div class="edit-radio-other-option-container">
                                <RadioOtherInput Id=@($"txt-{_id}-custom-value")
                                                 Value=@_otherText
                                                 IsDisabled=@(_selectedOption != _otherName || IsDisabled)
                                                 AriaLabel=@(OtherAriaLabel ?? RadioOtherInput.DefaultAriaLabel)
                                                 CommitAttributes=@OtherInputAttribute />
                            </div>
                        }
                    }
                    else
                    {
                        <div class=@(IsHorizontal
                                       ? "edit-radio-buttons-container-horizontal"
                                       : "edit-radio-buttons-container-vertical")>

                            @* .edit-radio-option is the per-option flex row edit-controls.css documents
                               as universal and EditRadioEnum puts around every option; this control
                               used to emit it only on its Other row, so its plain options rendered
                               without the shared wrapper. *@
                            @for (var i = 0; i < Options.Count; i++)
                            {
                                var option = Options[i];
                                <div class="edit-radio-option">
                                    <RadioOptionItem Value=@option IsButtonMode="false" IsDisabled=@IsOptionNativelyDisabledFor(option) IsLocked=@IsOptionLockedFor(option) Id=@_id IdSuffix=@(_optionIds[i]) CssClass=@CssClass LabelClass=@LabelClass Display=@option />
                                </div>
                            }

                            @* Other. Same wrapper, plus .edit-radio-other-option-container -- this
                               control's long-standing consumer hook for the Other block (and what
                               button mode above uses in both controls). *@
                            @if (HasOther)
                            {
                                <div class="edit-radio-option edit-radio-other-option-container">
                                    <RadioOptionItem Value=@_otherName IsButtonMode="false" IsDisabled=@IsDisabled Id=@_id IdSuffix="other" CssClass=@CssClass LabelClass=@LabelClass Display="Other" />
                                    <RadioOtherInput Id=@($"txt-{_id}-custom-value")
                                                     Value=@_otherText
                                                     IsDisabled=@(_selectedOption != _otherName || IsDisabled)
                                                     AriaLabel=@(OtherAriaLabel ?? RadioOtherInput.DefaultAriaLabel)
                                                     CommitAttributes=@OtherInputAttribute />
                                </div>
                            }
                        </div>
                    }

                </InputRadioGroup>
            }
            else
            {
                <ReadOnlyValue Id=@_id CssClass=@CssClass Text=@Value />
            }

            <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
            <BoundValueDisplay Text=@CurrentValueAsString />
        </fieldset>
    </div>
}
