@inherits EditControlBase<bool>
@implements IAsyncDisposable

@if (ShouldShowComponent())
{
    <div class="edit-control-wrapper @ContainerClass">

        @if (ShowEditor || RenderAsCheckboxWhenReadOnly)
        {
            @* Editable (or opt-in legacy read-only) — render the checkbox. A checkbox label has to wrap
               its own input, so the checkbox goes through FormLabel's NestedInput slot rather than
               sitting beside a FormLabel like every other control's input does. Everything else —
               label text, required star, description, tooltip, and the visually-hidden-label fallback
               when the label is hidden — is then FormLabel's, resolved identically to every other
               control. This branch used to re-implement all of it inline and silently omitted the
               required star, so a required checkbox announced aria-required with nothing visible to
               match it. *@
            <FormLabel Id=@_id
                       FieldIdentifier=@_fieldIdentifier
                       Attributes=@_attributes
                       Label=@Label
                       IsRequired=@IsRequiredResolved
                       Description=@Description
                       Tooltip=@Tooltip
                       IsLabelHidden=@ShouldHideLabel
                       LabelClass=@(EffectiveUseStyledCheckbox ? "edit-checkbox-label edit-checkbox-label-styled" : "edit-checkbox-label")
                       NestedInput=@(EffectiveUseStyledCheckbox ? StyledCheckboxFragment : CheckboxFragment) />
        }
        else
        {
            @* Read-only — use the same FormLabel + ReadOnlyValue pattern as the other controls *@
            <FormLabel Id=@_id FieldIdentifier=@_fieldIdentifier Attributes=@_attributes Label=@Label IsRequired=@IsRequiredResolved Description=@Description Tooltip=@Tooltip IsLabelHidden=@ShouldHideLabel IsForLabelable="false" />
            <ReadOnlyValue Id=@_id IsLabelHidden=@ShouldHideLabel CssClass=@CssClass Text=@(CurrentValue ? EffectiveTrueText : EffectiveFalseText) />
        }

        <FieldValidationDisplay Id=@_id FieldIdentifier=_fieldIdentifier Attributes=_attributes Label=@Label />
        @if (FormOptions != null && FormOptions.ShowBoundValues)
        {
            <div class="bound-value">@CurrentValueAsString</div>
        }
    </div>
}

@code {
    RenderFragment CheckboxFragment => @<input type="checkbox"
                                                value="@CurrentValue"
                                                @onchange="HandleCheckboxChange"
                                                @onclick:preventDefault="(!ShowEditor || IsDisabled) && AllowFocusWhenDisabled"
                                                class="edit-input @CssClass"
                                                id=@_id
                                                data-test-id=@_id
                                                checked=@CurrentValue
                                                tabindex="0"
                                                aria-disabled=@((!ShowEditor || IsDisabled) ? "true" : null)
                                                disabled=@((!ShowEditor || IsDisabled) && !AllowFocusWhenDisabled)
                                                aria-required=@_isRequired
                                                aria-invalid=@(IsInvalid ? "true" : null)
                                                aria-describedby=@_describedBy
                                                aria-errormessage=@(IsInvalid ? _errorMsgId : null) />;

    // Opt-in via UseStyledCheckbox — same attribute set as CheckboxFragment (nothing about the
    // binding/accessibility wiring changes), just wrapped so a sibling <span> can draw the box/fill/
    // checkmark/focus-ring in CSS. Native accent-color styling can't honor border-radius in any
    // current browser, so this is the only way to get a shaped checkbox.
    RenderFragment StyledCheckboxFragment => @<span class="edit-checkbox-wrap">
        <input type="checkbox"
               value="@CurrentValue"
               @onchange="HandleCheckboxChange"
               @onclick:preventDefault="(!ShowEditor || IsDisabled) && AllowFocusWhenDisabled"
               class="edit-input edit-checkbox-input-styled @CssClass"
               id=@_id
               data-test-id=@_id
               checked=@CurrentValue
               tabindex="0"
               aria-disabled=@((!ShowEditor || IsDisabled) ? "true" : null)
               disabled=@((!ShowEditor || IsDisabled) && !AllowFocusWhenDisabled)
               aria-required=@_isRequired
               aria-invalid=@(IsInvalid ? "true" : null)
               aria-describedby=@_describedBy
               aria-errormessage=@(IsInvalid ? _errorMsgId : null) />
        <span class="edit-checkbox-box" aria-hidden="true"></span>
    </span>;
}
