@if (IsLabelHidden)
{
    @* Even a hidden label must keep naming the control — a visually-hidden label/legend preserves
       the accessible name that used to be dropped entirely (an unnamed field to assistive tech). *@
    @if (IsLegend)
    {
        <legend class="edit-sr-only" id="lbl-@Id">
            <span id="lbltext-@Id">
                @LabelFor()
                @if (IsRequiredTextShown)
                {
                    <span class="edit-sr-only">&nbsp;(required)</span>
                }
            </span>
        </legend>
    }
    else
    {
        <label class="edit-sr-only" for=@(IsForLabelable ? Id : null) id="lbl-@Id"><span id="lbltext-@Id">@LabelFor()</span></label>
        @* NestedInput deliberately renders OUTSIDE this label, not within it: the label is
           visually hidden, so a control nested inside it would be hidden too. Renders nothing
           for every caller that doesn't supply it. *@
        @NestedInput
    }

    @* The description survives a hidden label, visually hidden alongside it. Hiding the label is a
       layout decision — the field sits under a column header, or its purpose is obvious in context —
       and it used to silently take the field's format instructions with it, for every user, sighted
       or not (3.3.2).

       The tooltip TRIGGER is still deliberately not resurrected: it is an interactive hover/focus
       widget with no visual affordance to reach in this mode, so EditControlInit keeps excluding
       tooltip- from aria-describedby. Its TEXT joins the description here instead — dropping the
       element used to drop the help text from the DOM and from aria-describedby entirely, so unlike
       the label and the description it reached nobody at all, sighted or not. *@
    @if (DisplayDescription() != null || DisplayHiddenTooltip() != null)
    {
        <p class="edit-sr-only" id="desc-@Id">
            @DisplayDescription()
            @if (DisplayHiddenTooltip() != null)
            {
                <span>@DisplayHiddenTooltip()</span>
            }
        </p>
    }
}
else
{
    @if (IsLegend)
    {
        <!-- Wrap only the 'label' within the legend -->
		<legend class="edit-label-legend" id="lbl-@Id">
			@if (_isRequired && !IsStarHidden)
			{
				<span class="edit-label-required-star" aria-hidden="true">*</span>
			}
			@* lbltext-{id} is the NAMING ANCHOR (see FormLabel.razor.cs) — the grouping element points
			   aria-labelledby here rather than at the whole legend, so the tooltip trigger's own
			   accessible name stays out of the group's name. The star is excluded too (it is
			   aria-hidden, so it never contributed anyway); the sr-only "(required)" is deliberately
			   INSIDE, because for a role="group" fieldset that text is the only way requiredness
			   reaches assistive tech at all — ARIA 1.2 forbids aria-required there. *@
			<span id="lbltext-@Id">
				@LabelFor()
				@* After the label text so it reads "Colors, required", not "required Colors". The
				   leading &nbsp; is a real, non-collapsible character: accessible-name computation
				   concatenates descendant text, and without it the name runs together as
				   "Colors(required)". *@
				@if (IsRequiredTextShown)
				{
					<span class="edit-sr-only">&nbsp;(required)</span>
				}
			</span>

            <LabelTooltip Id=@Id Tooltip=@Tooltip Attributes=@Attributes TriggerLabel=@_tooltipTriggerLabel/>
        </legend>

        @if (DisplayDescription() != null)
        {
            <p class="edit-label-description" id="desc-@Id">
                @DisplayDescription()
            </p>
        }
    }
    else
    {
        <!-- Typical Label. `for` only when the paired element is labelable — in read-only mode the
             value is a div, and label[for] must reference a labelable element. -->
		<label class=@EffectiveLabelClass for=@(IsForLabelable ? Id : null) id="lbl-@Id">
			@* Any input that has to live inside its own label (the checkbox row EditBool renders)
			   goes first, so the star + text read after it. Renders nothing when unsupplied. *@
			@NestedInput
			@if (_isRequired && !IsStarHidden)
			{
				<span class="edit-label-required-star" aria-hidden="true">*</span>
			}
            @* The naming anchor (see the legend branch above). NestedInput and the star stay outside
			   it: the nested input is the control this label names, not part of its name. *@
			<span id="lbltext-@Id">@LabelFor()</span>

            <LabelTooltip Id=@Id Tooltip=@Tooltip Attributes=@Attributes TriggerLabel=@_tooltipTriggerLabel />
        </label>

        @if (DisplayDescription() != null)
        {
            <p class="edit-label-description" id="desc-@Id">
                @DisplayDescription()
            </p>
        }
    }
}
