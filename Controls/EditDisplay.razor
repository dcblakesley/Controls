@inherits EditControlParametersBase

@if (!IsHidden)
{
    <div class="edit-control-wrapper @ContainerClass">
        <FormLabel Id=@_id Label=@Label Description=@Description Tooltip=@Tooltip IsRequired=@IsRequired IsLabelHidden=@ShouldHideLabel IsForLabelable="false"/>

        @* No ConsumerClass merge here: parameter matching is case-insensitive, so a consumer's
           class="..." binds to the declared Class parameter and never reaches the capture dict. *@
        <div @attributes="AttributeSplat.Rest(AdditionalAttributes)"
             id=@_id
             data-test-id=@_id
             class="edit-readonly-value @Class"
             style="@AttributeSplat.MergeStyle(null, AdditionalAttributes)"
             role="group"
             aria-labelledby=@(string.IsNullOrEmpty(Label) ? null : $"lbl-{_id}")>
            @* R5: role="group" legitimizes the aria-labelledby above -- a bare div is role-generic, and
               ARIA prohibits naming a roleless element (an axe-core scan flagged exactly this shape;
               some assistive technology drops the name entirely rather than announcing it). Mirrors
               EditString's identical role="group" + aria-labelledby row on its masked-value div (see
               that markup's remarks) rather than introducing a new pattern -- the least-change option,
               since this element already only ever holds a plain value, never focusable content that a
               more specific role would need to account for. *@

            @* The same line-height-reserving placeholder ReadOnlyValue renders for an empty value (see
               that component's LST-2 remarks) -- restated here rather than reused because this div also
               carries the consumer's splatted attributes, merged style and the Class parameter, none of
               which that component takes. *@
            @if (!string.IsNullOrEmpty(Text))
            {
                @Text
            }
            else
            {
                <span style="color: var(--edit-color-placeholder, rgba(0, 0, 0, 0.55))">@EmptyText</span>
            }
        </div>
        
  </div>
}