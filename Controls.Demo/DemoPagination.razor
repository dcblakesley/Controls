@if (Standalone)
{
    <h1>Pagination Demo</h1>
}

<div class="wss-demo-gallery">

    <section class="demo-section">
        <h3>Pagination</h3>
        <Pagination Total="95" PageSize="10" Current="_page" CurrentChanged="@(p => _page = p)" />
        <p>Current page: @_page</p>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_paginationBasicExample</code></pre>
    </section>

    <section class="demo-section">
        <h3>Pagination — total text, size changer, quick jumper</h3>
        <p style="margin:0; color:#666;">
            <code>ShowTotal</code> renders the "x-y of z items" text; <code>PageSizeOptions</code>
            adds a native <code>&lt;select&gt;</code> size-changer (<code>@@bind-PageSize</code>) that
            re-clamps the current page to keep roughly the same data window in view;
            <code>ShowQuickJumper</code> adds a "Go to" input (Enter commits, then clears). All
            dependency-free -- no JS module, no <code>Select&lt;T&gt;</code>.
        </p>
        <Pagination Total="95" @bind-PageSize="_paginationDemoPageSize" @bind-Current="_paginationDemoPage"
                    PageSizeOptions="@(new[] { 10, 20, 50 })" ShowQuickJumper="true"
                    ShowTotal="@(w => $"{w.Start}-{w.End} of {w.Total} items")" />
        <p data-test-id="pagination-demo-result">Page @_paginationDemoPage, size @_paginationDemoPageSize</p>

        <p style="margin:0; color:#666;"><code>Small</code> -- the AntD compact size (CSS-only).</p>
        <Pagination Total="30" PageSize="10" @bind-Current="_smallPaginationPage" Small="true" />

        <h3>Markup</h3>
        <pre class="code-block"><code>@_paginationAdvancedExample</code></pre>
    </section>

</div>

@code {
    /// <summary> False inside <see cref="UiKitGallery"/>, whose own heading covers the whole page. </summary>
    [Parameter] public bool Standalone { get; set; } = true;

    readonly string _paginationBasicExample = @"<Pagination Total=""95"" PageSize=""10"" Current=""_page"" CurrentChanged=""@(p => _page = p)"" />";

    readonly string _paginationAdvancedExample = @"<Pagination Total=""95"" @bind-PageSize=""_paginationDemoPageSize"" @bind-Current=""_paginationDemoPage""
            PageSizeOptions=""@(new[] { 10, 20, 50 })"" ShowQuickJumper=""true""
            ShowTotal=""@(w => $""{w.Start}-{w.End} of {w.Total} items"")"" />

@* Its own Current field -- two pagers sharing one would move in lockstep *@
<Pagination Total=""30"" PageSize=""10"" @bind-Current=""_smallPaginationPage"" Small=""true"" />";

    int _page = 1;

    // --- Pagination parity-batch demo (ShowTotal / PageSizeOptions / ShowQuickJumper / Small) ---
    int _paginationDemoPageSize = 10;
    int _paginationDemoPage = 1;
    int _smallPaginationPage = 1;
}
