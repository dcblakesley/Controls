    <section class="demo-section">
        <h3>Table — ScrollY (sticky header)</h3>
        <p style="margin:0; color:#666;">
            <code>ScrollY</code> bounds the table body to a fixed height with its own vertical
            scrollbar and a sticky header (AntD's <code>scroll.y</code> equivalent) -- the header
            cells stay pinned in place while the rows scroll beneath them. The Name column's filter
            dropdown here (6 options) is taller than the scrolled area, so it escapes the wrapper's
            overflow clip via fixed positioning (JS) instead of the default CSS-anchored placement,
            and keeps tracking its trigger if the page itself scrolls. <code>Loading</code> is wired
            up too, to cover the sticky-header-vs-mask stacking fix: opening the filter while Loading
            is on must not leave its OK button hidden under the mask.
        </p>
        <button class="wss-dialog-btn" data-test-id="toggle-scrolly-loading" @onclick="@(() => _scrollYLoadingDemo = !_scrollYLoadingDemo)">
            Toggle Loading (@(_scrollYLoadingDemo ? "on" : "off"))
        </button>
        <Table TItem="Row" DataSource="_scrollYRows" ScrollY="160px" Loading="_scrollYLoadingDemo">
            <ChildContent>
                <PropertyColumn TItem="Row" TProp="string" Title="Name" Property="@(r => r.Name)"
                                FilterOptions="_scrollYFilterOptions" OnFilter="@((Row r, string v) => r.Name == v)" />
                <PropertyColumn TItem="Row" TProp="decimal" Title="Price" Property="@(r => r.Price)" Format="C2" />
            </ChildContent>
        </Table>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_scrollYExample</code></pre>
    </section>

</div>

