@using Microsoft.AspNetCore.Components.Forms
@inherits DemoFormPage

<h1>EditNumber Demo</h1>

<EditForm Model="@_model" class="wss-demo-row wss-demo-wrap" @ref=_form>
	<ObjectGraphDataAnnotationsValidator/>

	<section class="demo-section">
		<EditNumber @bind-Value="_model.Int"/>
		<EditNumber @bind-Value="_model.Decimal"/>
		<EditNumber @bind-Value="_model.Float"/>
		<EditNumber @bind-Value="_model.SteppedNumber" Step="5"/>

		<h3>Markup</h3>
		<pre class="code-block"><code>@_basicExample</code></pre>

		<h3>Model</h3>
		<pre class="code-block code-block-model"><code>@_basicModel</code></pre>
	</section>

	<section class="demo-section">
		<EditNumber @bind-Value="_model.Disabled" IsDisabled="true"/>

		<h3>Markup</h3>
		<pre class="code-block"><code>@_disabledExample</code></pre>
	</section>

	<section class="demo-section">
		<style>
            .my-custom-container { background-color: darkgreen; padding: 10px; border-radius: 400px; }
            .my-custom-number { border: 2px solid black; border-radius: 4px; padding: 4px; width: 120px; }
        </style>

		<EditNumber @bind-Value="_model.CustomStyle" ContainerClass="my-custom-container" class="my-custom-number"/>

		<h3>Markup</h3>
		<pre class="code-block"><code>@_customStyleExample</code></pre>

		<h3>CSS</h3>
		<pre class="code-block code-block-css"><code>@_customStyleCss</code></pre>
	</section>

	<section class="demo-section">
		<EditNumber @bind-Value="_model.Required"/>
		<EditNumber @bind-Value="_model.MinValue"/>
		<EditNumber @bind-Value="_model.MaxValue"/>
		<EditNumber @bind-Value="_model.RangeValue"/>

		<h3>Markup</h3>
		<pre class="code-block"><code>@_validationExample</code></pre>

		<h3>Model</h3>
		<pre class="code-block code-block-model"><code>@_validationModel</code></pre>
	</section>

	<section class="demo-section">
		<h3>Min / Max / Placeholder</h3>

		<EditNumber @bind-Value="_model.Bounded" Min="0" Max="100" Placeholder="0-100"/>

		<h3>Markup</h3>
		<pre class="code-block"><code>@_boundedExample</code></pre>
	</section>

	<section class="demo-section">
		<h3>Prefix / Suffix</h3>

		<EditNumber @bind-Value="_model.WithPrefixSuffix" Description="Prefix = $, Suffix = USD">
			<Prefix>$</Prefix>
			<Suffix>USD</Suffix>
		</EditNumber>

		<h3>Markup</h3>
		<pre class="code-block"><code>@_prefixSuffixExample</code></pre>
	</section>

	<section class="demo-section">
		<h3>Placeholder from Model Attribute</h3>
		<p>
			A <code>[Placeholder]</code> attribute on the bound property (or DataAnnotations'
			<code>[Display(Prompt = "...")]</code>) supplies the hint here even though the markup below
			sets no <code>Placeholder</code> parameter at all.
		</p>

		<EditNumber @bind-Value="_model.WithPlaceholderAttribute"/>

		<h3>Markup</h3>
		<pre class="code-block"><code>@_placeholderAttributeExample</code></pre>

		<h3>Model</h3>
		<pre class="code-block code-block-model"><code>@_placeholderAttributeModel</code></pre>
	</section>

	<section class="demo-section">
		<h3>Min / Max from Model Attribute</h3>
		<p>
			A <code>[MinValue]</code>/<code>[MaxValue]</code> attribute on the bound property (or a plain
			<code>[Range]</code>) supplies the <code>min</code>/<code>max</code> bounds here even though
			the markup below sets no <code>Min</code>/<code>Max</code> parameter at all.
		</p>

		<EditNumber @bind-Value="_model.WithMinMaxAttribute"/>

		<h3>Markup</h3>
		<pre class="code-block"><code>@_minMaxAttributeExample</code></pre>

		<h3>Model</h3>
		<pre class="code-block code-block-model"><code>@_minMaxAttributeModel</code></pre>
	</section>

	<section class="demo-section">
		<h3>Stepper (ShowStepper)</h3>
		<p>
			Opt-in minus/plus buttons flanking the input. Each press moves the value by the effective step
			(the <code>Step</code> parameter, the model's <code>[Step]</code>, else 1) and clamps to
			<code>Min</code>/<code>Max</code>; a button disables itself once the value sits at its bound.
			The buttons are not tab stops &mdash; keyboard users step with the input's own arrow keys.
		</p>

		<EditNumber @bind-Value="_model.StepperBasic" ShowStepper="true"/>
		<EditNumber @bind-Value="_model.StepperAtMax" ShowStepper="true" Min="0" Max="10"/>
		<EditNumber @bind-Value="_model.StepperAtMin" ShowStepper="true" Min="5" Max="50"/>
		<EditNumber @bind-Value="_model.StepperDecimal" ShowStepper="true" Step="0.25m"/>
		<EditNumber @bind-Value="_model.StepperDisabled" ShowStepper="true" IsDisabled="true"/>

		<p>
			<code>Size</code> scales the buttons off the same <code>--edit-control-height-sm</code>/
			<code>-lg</code> tokens the editor's own size classes use. Only the buttons visibly move on
			this page: the editor's <code>edit-input-sm</code>/<code>-lg</code> are inert outside
			<code>.edit-theme</code>, and this demo host pins every <code>input</code> to a flat 32px.
		</p>

		<EditNumber @bind-Value="_model.StepperSmall" ShowStepper="true" Size="SelectSize.Small"/>
		<EditNumber @bind-Value="_model.StepperLarge" ShowStepper="true" Size="SelectSize.Large"/>

		<h3>Markup</h3>
		<pre class="code-block"><code>@_stepperExample</code></pre>
	</section>
</EditForm>

@code {
	readonly DemoEditNumberModel _model = new();

	public class DemoEditNumberModel
	{
		[Description("Basic Description")] public int Int { get; set; }
		public double Decimal { get; set; } = 1.12345678901;
		public float Float { get; set; } = 1.1234567f;

		[DisplayName("Step by 5")] public int SteppedNumber { get; set; }
		public int CustomStyle { get; set; }

		[Required] public int? Required { get; set; }
		public int Disabled { get; set; }

		[Range(2, int.MaxValue)] public int MinValue { get; set; }

		[Range(float.MinValue, 3.14159)] public float MaxValue { get; set; } = 6;

		[Range(100.5, 110.85)] public double RangeValue { get; set; } = 33;

		public int Bounded { get; set; }
		public decimal WithPrefixSuffix { get; set; } = 19;

		[Placeholder("e.g. 42")]
		public int? WithPlaceholderAttribute { get; set; }

		[MinValue(0)]
		[MaxValue(100)]
		public int? WithMinMaxAttribute { get; set; }

		// Every stepper value is pinned: the e2e visual baseline screenshots this section, and the
		// two bounded fields are pinned AT their bound so the disabled-button state is in the shot.
		[DisplayName("Stepper")] public int StepperBasic { get; set; } = 3;
		[DisplayName("At Max")] public int StepperAtMax { get; set; } = 10;
		[DisplayName("At Min")] public int StepperAtMin { get; set; } = 5;
		[DisplayName("Quarter Steps")] public decimal StepperDecimal { get; set; } = 1.5m;
		[DisplayName("Stepper Disabled")] public int StepperDisabled { get; set; } = 7;
		[DisplayName("Stepper Small")] public int StepperSmall { get; set; } = 1;
		[DisplayName("Stepper Large")] public int StepperLarge { get; set; } = 2;
	}

	readonly string _basicExample = @"<EditNumber @bind-Value=""_model.Int"" />
<EditNumber @bind-Value=""_model.Decimal"" />
<EditNumber @bind-Value=""_model.Float"" />
<EditNumber @bind-Value=""_model.SteppedNumber""
          Step=""5"" />";

	readonly string _basicModel = @"public int Int { get; set; }
public double Decimal { get; set; } = 1.12345678901;
public float Float { get; set; } = 1.1234567f;

[DisplayName(""Step by 5"")]
public int SteppedNumber { get; set; }";

	readonly string _disabledExample = @"<EditNumber @bind-Value=""_model.Disabled""
          IsDisabled=""true"" />";

	readonly string _customStyleExample = @"<EditNumber @bind-Value=""_model.CustomStyle""
          ContainerClass=""my-custom-container""
          class=""my-custom-number"" />";

	readonly string _customStyleCss = @".my-custom-container { 
    background-color: darkgreen; 
    padding: 10px; 
    border-radius: 400px; 
}

.my-custom-number { 
    border: 2px solid black; 
    border-radius: 4px; 
    padding: 4px; 
    width: 120px; 
}";

	readonly string _validationExample = @"<EditNumber @bind-Value=""_model.Required"" />
<EditNumber @bind-Value=""_model.MinValue"" />
<EditNumber @bind-Value=""_model.MaxValue"" />
<EditNumber @bind-Value=""_model.RangeValue"" />";

	readonly string _validationModel = @"[Required]
public int? Required { get; set; }

[Range(2, int.MaxValue)]
public int MinValue { get; set; }

[Range(float.MinValue, 3.14159)]
public float MaxValue { get; set; } = 6;

[Range(100.5, 110.85)]
public double RangeValue { get; set; } = 33;";

	readonly string _boundedExample = @"<EditNumber @bind-Value=""_model.Bounded""
          Min=""0""
          Max=""100""
          Placeholder=""0-100"" />";

	readonly string _prefixSuffixExample = @"<EditNumber @bind-Value=""_model.WithPrefixSuffix"">
    <Prefix>$</Prefix>
    <Suffix>USD</Suffix>
</EditNumber>";

	readonly string _placeholderAttributeExample = @"<EditNumber @bind-Value=""_model.WithPlaceholderAttribute"" />";

	readonly string _placeholderAttributeModel = @"[Placeholder(""e.g. 42"")]
public int? WithPlaceholderAttribute { get; set; }";

	readonly string _minMaxAttributeExample = @"<EditNumber @bind-Value=""_model.WithMinMaxAttribute"" />";

	readonly string _minMaxAttributeModel = @"[MinValue(0)]
[MaxValue(100)]
public int? WithMinMaxAttribute { get; set; }";

	readonly string _stepperExample = @"<EditNumber @bind-Value=""_model.StepperBasic""
          ShowStepper=""true"" />

<!-- Value pinned at Max, so the plus button is disabled -->
<EditNumber @bind-Value=""_model.StepperAtMax""
          ShowStepper=""true""
          Min=""0"" Max=""10"" />

<!-- Fractional step -->
<EditNumber @bind-Value=""_model.StepperDecimal""
          ShowStepper=""true""
          Step=""0.25m"" />

<!-- Size variants line the buttons up with the editor -->
<EditNumber @bind-Value=""_model.StepperSmall""
          ShowStepper=""true""
          Size=""SelectSize.Small"" />";

}