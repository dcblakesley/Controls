@if (Standalone)
{
    <h1>Alert Demo</h1>
}

<div class="wss-demo-gallery">

    <section class="demo-section">
        <h3>Alert</h3>
        <Alert Type="AlertType.Success" Message="Success — saved." />
        <Alert Type="AlertType.Info" Message="Info — heads up." />
        <Alert Type="AlertType.Warning" Message="Warning — check this." />
        <Alert Type="AlertType.Error" Message="Error — something failed." Closable="true" />
        <Alert Type="AlertType.Info" Message="With description" Description="A longer explanation under the message." />
        <Alert Banner="true" Message="Banner mode — full-width, no border/radius, defaults to warning severity." />
        <Alert Message="With an action slot" Closable="true">
            <Action><button class="wss-dialog-btn wss-dialog-btn-sm" data-test-id="alert-action-btn">Undo</button></Action>
        </Alert>
    </section>

</div>

@code {
    /// <summary> False inside <see cref="UiKitGallery"/>, whose own heading covers the whole page. </summary>
    [Parameter] public bool Standalone { get; set; } = true;
}
