[DataType(DataType.Password)]
public string ReadOnlySecret { get; set; } = ""..."";
<EditString @bind-Value=""_model.ReadOnlySecret"" IsEditMode=""false""/>

@* Link -- rel=""noopener noreferrer"" for _blank AND named targets; none for _self/_parent/_top *@
<EditString @bind-Value=""_model.UrlField"" IsEditMode=""false""
