@using Microsoft.AspNetCore.Components.Forms
@inherits DemoFormPage

<h1>EditString Demo</h1>

<EditForm Model="@_model" class="wss-demo-row wss-demo-wrap" @ref="_form">
    <ObjectGraphDataAnnotationsValidator/>

    <section class="demo-section">
        <EditString @bind-Value="_model.BasicString"/>

        <EditString @bind-Value="_model.BasicString" IsEditMode=false/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_basicExample</code></pre>
    </section>

    <section class="demo-section">
        <EditString @bind-Value="_model.WithPlaceholder"
                    Placeholder="Enter some text..."/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_placeholderExample</code></pre>
    </section>

    <section class="demo-section">
        <h3>Tooltip Examples</h3>

        <EditString @bind-Value="_model.WithTooltipFromAttribute"/>

        <EditString @bind-Value="_model.WithTooltipInHtml"
                    Tooltip="This tooltip was set directly in the HTML markup, not from a model attribute!"/>

        <EditString @bind-Value="_model.WithTooltipOverride"
                    Tooltip="This HTML tooltip overrides the attribute tooltip"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_tooltipExample</code></pre>

        <h3>Model</h3>
        <pre class="code-block code-block-model"><code>@_tooltipModel</code></pre>
    </section>

    <section class="demo-section">
        <EditString @bind-Value="_model.MaskedText"
                    MaskText="*"/>

        <EditString Description="MaskText = *"
                    @bind-Value="_model.MaskedText"
                    IsEditMode="false"
                    MaskText="*"/>

        <EditString Description="MaskText = ***-**-"
                    @bind-Value="_model.MaskedText"
                    IsEditMode="false"
                    MaskText="***-**-"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_maskedExample</code></pre>
    </section>

    <section class="demo-section">
        <style>
            .my-custom-container { background-color: purple; padding: 10px; border-radius: 4px; }
            .my-custom-input { border: 2px solid #0066cc; color: green; border-radius: 4px; padding: 4px; width: 100%; }
        </style>

        <EditString @bind-Value="_model.CustomStyling"
                    ContainerClass="my-custom-container"
                    class="my-custom-input"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_customStyleExample</code></pre>

        <h3>CSS</h3>
        <pre class="code-block code-block-css"><code>@_customStyleCss</code></pre>
    </section>

    <section class="demo-section">
        <EditString @bind-Value="_model.Disabled"
                    IsDisabled="true"/>

        <EditString @bind-Value="_model.Required"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_validationExample</code></pre>

        <h3>Model</h3>
        <pre class="code-block code-block-model"><code>@_validationModel</code></pre>
    </section>

    <section class="demo-section">
        <EditString @bind-Value="_model.UrlField"
                    Url="https://example.com"
                    UrlTarget="_blank"/>
        <EditString @bind-Value="_model.UrlField"
                    Url="https://example.com"
                    UrlTarget="_blank"
                    IsEditMode=false/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_urlExample</code></pre>
    </section>

    <section class="demo-section">
        <h3>Prefix / Suffix</h3>

        <EditString @bind-Value="_model.WithPrefixSuffix" Description="Prefix = $, Suffix = .00">
            <Prefix>$</Prefix>
            <Suffix>.00</Suffix>
        </EditString>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_prefixSuffixExample</code></pre>
    </section>

    <section class="demo-section">
        <h3>AllowClear</h3>

        <EditString @bind-Value="_model.Clearable" AllowClear="true"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_allowClearExample</code></pre>
    </section>

    <section class="demo-section">
        <h3>MaxLength + ShowCount</h3>

        <EditString @bind-Value="_model.Counted" MaxLength="20" ShowCount="true"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_maxLengthExample</code></pre>
    </section>

    <section class="demo-section">
        <h3>IsPassword</h3>

        <EditString @bind-Value="_model.Password" IsPassword="true"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_passwordExample</code></pre>
    </section>

    <section class="demo-section">
        <h3>Placeholder from Model Attribute</h3>
        <p>
            A <code>[Placeholder]</code> attribute on the bound property supplies the hint without
            repeating it at every markup site; DataAnnotations' own <code>[Display(Prompt = "...")]</code>
            works the same way for a model already annotated for MVC/Razor Pages. Resolution order:
            the control's own <code>Placeholder</code> parameter wins first, then <code>[Placeholder]</code>,
            then <code>[Display(Prompt)]</code> -- so an explicit <code>Placeholder</code> in markup still
            overrides a <code>[Placeholder]</code> attribute on the same property.
        </p>

        <EditString @bind-Value="_model.WithPlaceholderAttribute"/>

        <EditString @bind-Value="_model.WithDisplayPrompt"/>

        <EditString @bind-Value="_model.WithPlaceholderOverride"
                    Placeholder="This wins over the [Placeholder] attribute"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_placeholderAttributeExample</code></pre>

        <h3>Model</h3>
        <pre class="code-block code-block-model"><code>@_placeholderAttributeModel</code></pre>
    </section>

    <section class="demo-section">
        <h3>Read-Only Views</h3>
        <p>
            Read-only mode picks one of three views, in this order: the <strong>masked row</strong> (a
            <code>MaskText</code>, or the bullet mask a password field supplies on its own), then the
            <strong>link</strong> (when <code>Url</code> passes the safety gate), else <strong>plain
            text</strong>. A masked field therefore never renders as a link, and a password field never
            prints its secret just because the form went read-only. <code>UrlTarget</code> adds
            <code>rel="noopener noreferrer"</code> for every target that can hand the opened document a
            <code>window.opener</code> handle back to this page -- <code>_blank</code> and named targets
            alike -- and a <code>javascript:</code> URL is rejected outright and falls back to plain text.
            Each control below sets an explicit <code>Id</code> so the demo's duplicate bindings still get
            distinct element ids.
        </p>

        <EditString Id="ro-masked" Description="MaskText = *** -- multi-char masks prefix the tail"
                    @bind-Value="_model.MaskedText" IsEditMode="false" MaskText="***"/>

        <EditString Id="ro-password" Description="[DataType(Password)] -- bullets, revealable"
                    @bind-Value="_model.ReadOnlySecret" IsEditMode="false"/>

        <EditString Id="ro-mask-over-url" Description="MaskText wins over Url"
                    @bind-Value="_model.MaskedText" IsEditMode="false" MaskText="*"
                    Url="https://example.com"/>

        <EditString Id="ro-url-blank" Description="UrlTarget = _blank -- rel hardened"
                    @bind-Value="_model.UrlField" IsEditMode="false"
                    Url="https://example.com/vendors/42" UrlTarget="_blank"/>

        <EditString Id="ro-url-named" Description="UrlTarget = vendor -- named targets hardened too"
                    @bind-Value="_model.UrlField" IsEditMode="false"
                    Url="https://example.com/vendors/42" UrlTarget="vendor"/>

        <EditString Id="ro-url-self" Description="UrlTarget = _self -- same context, no rel"
                    @bind-Value="_model.UrlField" IsEditMode="false"
                    Url="https://example.com/vendors/42" UrlTarget="_self"/>

        <EditString Id="ro-url-unsafe" Description="javascript: URL -- rejected, renders as text"
                    @bind-Value="_model.UrlField" IsEditMode="false"
                    Url="javascript:alert(1)"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_readOnlyViewsExample</code></pre>
    </section>
</EditForm>

@code {
    readonly DemoEditStringModel _model = new();

    public class DemoEditStringModel
    {
        [Description("Basic Description")]
        public string BasicString { get; set; } = "";
        public string WithPlaceholder { get; set; } = "";
   
        [ToolTip("This tooltip comes from the [ToolTip] attribute on the model property")]
        [DisplayName("With Tooltip From Attribute")]
     public string WithTooltipFromAttribute { get; set; } = "";
      
        [DisplayName("With Tooltip In HTML")]
        public string WithTooltipInHtml { get; set; } = "";
        
     [ToolTip("This is the attribute tooltip (will be overridden)")]
  [DisplayName("With Tooltip Override")]
        public string WithTooltipOverride { get; set; } = "";
      
        public string MaskedText { get; set; } = "123-45-6789";
        public string UrlField { get; set; } = "Friendly name for a website";
        public string CustomStyling { get; set; } = "";

        [DataType(DataType.Password)]
        [DisplayName("Read Only Secret")]
        public string ReadOnlySecret { get; set; } = "correct-horse-battery";

        [Required] public string Required { get; set; } = "";

        public string Disabled { get; set; } = "";

        public string WithPrefixSuffix { get; set; } = "19";
        public string Clearable { get; set; } = "Clear me";
        public string Counted { get; set; } = "";
        public string Password { get; set; } = "";

        [Placeholder("e.g. jane@example.com")]
        public string WithPlaceholderAttribute { get; set; } = "";

        [Display(Prompt = "e.g. (555) 555-1234")]
        public string WithDisplayPrompt { get; set; } = "";

        [Placeholder("This is overridden by the Placeholder parameter")]
        public string WithPlaceholderOverride { get; set; } = "";
    }

    readonly string _basicExample = @"<EditString @bind-Value=""_model.BasicString""/>

<EditString @bind-Value=""_model.BasicString"" IsEditMode=false/>";

    readonly string _placeholderExample = @"<EditString @bind-Value=""_model.WithPlaceholder""
           Placeholder=""Enter some text...""/>";

    readonly string _tooltipExample = @"<EditString @bind-Value=""_model.WithTooltipFromAttribute""/>

<EditString @bind-Value=""_model.WithTooltipInHtml""
           Tooltip=""This tooltip was set directly in the HTML markup!""/>

<EditString @bind-Value=""_model.WithTooltipOverride""
           Tooltip=""This HTML tooltip overrides the attribute tooltip""/>";

    readonly string _tooltipModel = @"[ToolTip(""This tooltip comes from the [ToolTip] attribute"")]
[DisplayName(""With Tooltip From Attribute"")]
public string WithTooltipFromAttribute { get; set; } = """";

[ToolTip(""This is the attribute tooltip (will be overridden)"")]
[DisplayName(""With Tooltip Override"")]
public string WithTooltipOverride { get; set; } = """";";

    readonly string _maskedExample = @"<EditString @bind-Value=""_model.MaskedText""
           MaskText=""*""/>

<EditString Description=""MaskText = ***-**-""
           @bind-Value=""_model.MaskedText""
           IsEditMode=""false""
           MaskText=""***-**-""/>";

    readonly string _customStyleExample = @"<EditString @bind-Value=""_model.CustomStyling""
           ContainerClass=""my-custom-container""
           class=""my-custom-input""/>";

    readonly string _customStyleCss = @".my-custom-container { 
    background-color: purple; 
    padding: 10px; 
    border-radius: 4px; 
}

.my-custom-input {
    border: 2px solid #0066cc;
    color: green;
    border-radius: 4px;
    padding: 4px;
    width: 100%;
}";

    readonly string _validationExample = @"<EditString @bind-Value=""_model.Disabled""
           IsDisabled=""true""/>

<EditString @bind-Value=""_model.Required""/>";

    readonly string _validationModel = @"[Required] 
public string Required { get; set; } = """";

public string Disabled { get; set; } = """";";

    readonly string _urlExample = @"<EditString @bind-Value=""_model.UrlField""
           Url=""https://example.com""
           UrlTarget=""_blank""/>";

    readonly string _prefixSuffixExample = @"<EditString @bind-Value=""_model.WithPrefixSuffix"">
    <Prefix>$</Prefix>
    <Suffix>.00</Suffix>
</EditString>";

    readonly string _allowClearExample = @"<EditString @bind-Value=""_model.Clearable""
           AllowClear=""true""/>";

    readonly string _maxLengthExample = @"<EditString @bind-Value=""_model.Counted""
           MaxLength=""20""
           ShowCount=""true""/>";

    readonly string _passwordExample = @"<EditString @bind-Value=""_model.Password""
           IsPassword=""true""/>";

    readonly string _placeholderAttributeExample = @"<EditString @bind-Value=""_model.WithPlaceholderAttribute""/>

<EditString @bind-Value=""_model.WithDisplayPrompt""/>

<EditString @bind-Value=""_model.WithPlaceholderOverride""
           Placeholder=""This wins over the [Placeholder] attribute""/>";

    readonly string _placeholderAttributeModel = @"[Placeholder(""e.g. jane@example.com"")]
public string WithPlaceholderAttribute { get; set; } = """";

[Display(Prompt = ""e.g. (555) 555-1234"")]
public string WithDisplayPrompt { get; set; } = """";

[Placeholder(""This is overridden by the Placeholder parameter"")]
public string WithPlaceholderOverride { get; set; } = """";";

    readonly string _readOnlyViewsExample = @"@* Masked row -- wins over Url, and a password field masks itself *@
