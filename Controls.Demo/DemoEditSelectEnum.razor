@using Microsoft.AspNetCore.Components.Forms

<h1>EditSelectEnum Demo</h1>

<EditForm Model="@_model" class="flex-row flex-wrap" @ref="_form">
    <ObjectGraphDataAnnotationsValidator/>

    <section class="demo-section">
        <EditSelectEnum @bind-Value="_model.BasicEnum" />

        <EditSelectEnum @bind-Value="_model.BasicEnum" IsEditMode="false" Label="Read-only" />
        
        <h3>Markup</h3>
        <pre class="code-block"><code>@_basicExample</code></pre>
    </section>

    <section class="demo-section">

        <style>
            .my-custom-container {
                background-color: lime;
                padding: 10px;
                border-radius: 4px;
            }
            .my-custom-select {
                border: 2px solid black;
                color: green;
                border-radius: 4px;
                padding: 4px;
                min-width: 200px;
            }
        </style>

        <EditSelectEnum @bind-Value="_model.CustomClass"
                        ContainerClass="my-custom-container"
                        class="my-custom-select"/>
        
        <h3>Markup</h3>
        <pre class="code-block"><code>@_customStyleExample</code></pre>
        
        <h3>CSS</h3>
        <pre class="code-block code-block-css"><code>@_customStyleCss</code></pre>
    </section>

    <section class="demo-section">
        <EditSelectEnum @bind-Value="_model.Disabled"
                        IsDisabled="true"/>

        <EditSelectEnum @bind-Value="_model.Required"/>
        
        <h3>Markup</h3>
        <pre class="code-block"><code>@_validationExample</code></pre>
        
        <h3>Model</h3>
        <pre class="code-block code-block-model"><code>@_validationModel</code></pre>
    </section>

    <section class="demo-section">
        <h3>Placeholder from Model Attribute</h3>
        <p>
            A native <code>&lt;select&gt;</code> has no <code>placeholder</code> attribute, so
            <code>EditSelectEnum</code> has no <code>Placeholder</code> parameter either -- instead a
            <code>[Placeholder]</code> attribute (or <code>[Display(Prompt = "...")]</code>) on a
            <b>nullable</b> enum property supplies the text for the leading blank option.
        </p>

        <EditSelectEnum @bind-Value="_model.WithPlaceholderAttribute"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_placeholderAttributeExample</code></pre>

        <h3>Model</h3>
        <pre class="code-block code-block-model"><code>@_placeholderAttributeModel</code></pre>
    </section>
</EditForm>

@code {

    EditForm? _form;
    protected override void OnAfterRender(bool firstRender) => _form?.EditContext!.Validate();

    readonly DemoEditSelectEnumModel _model = new();

    public class DemoEditSelectEnumModel
    {
        [Description("Basic Description")]
        public Animal BasicEnum { get; set; }
        public Animal CustomClass { get; set; }

        [Required] public Animal Required { get; set; }
        public Animal Disabled { get; set; }

        [Placeholder("Choose an animal...")]
        public Animal? WithPlaceholderAttribute { get; set; }
    }

    readonly string _basicExample = @"<EditSelectEnum @bind-Value=""_model.BasicEnum"" />

<EditSelectEnum @bind-Value=""_model.BasicEnum"" IsEditMode=""false"" Label=""Read-only"" />";

    readonly string _customStyleExample = @"<EditSelectEnum @bind-Value=""_model.CustomClass""
               ContainerClass=""my-custom-container""
               class=""my-custom-select""/>";

    readonly string _customStyleCss = @".my-custom-container {
    background-color: lime;
    padding: 10px;
    border-radius: 4px;
}

.my-custom-select {
    border: 2px solid black;
    color: green;
    border-radius: 4px;
    padding: 4px;
    min-width: 200px;
}";

    readonly string _validationExample = @"<EditSelectEnum @bind-Value=""_model.Disabled""
               IsDisabled=""true""/>

<EditSelectEnum @bind-Value=""_model.Required""/>";

    readonly string _validationModel = @"[Required]
public Animal Required { get; set; }

public Animal Disabled { get; set; }";

    readonly string _placeholderAttributeExample = @"<EditSelectEnum @bind-Value=""_model.WithPlaceholderAttribute""/>";

    readonly string _placeholderAttributeModel = @"[Placeholder(""Choose an animal..."")]
public Animal? WithPlaceholderAttribute { get; set; }";
}