        new("8999000", null, "--",
        [
            new("150005", "Stainless lid to reduce boil-overs", 1),
            new("150006", "Heat-resistant, non-slip handle", 6),
        ]),
        new("8999002", new DateTime(2026, 1, 4), "L01892155231421",
        [
            new("150007", "Fine-mist bottle for even oil coating", 1),
        ]),
        new("8999005", new DateTime(2026, 1, 4), "--", []),
