@using Microsoft.AspNetCore.Components.Web

<h1>UI Kit Gallery</h1>
<p>Dependency-free AntDesign-style controls ported into WssBlazorControls. These are general UI
   widgets (not form Edit* controls). Icon / Button / Checkbox / Tag are intentionally not included.</p>

<div class="wss-demo-gallery">

    <section class="demo-section">
        <h3>Alert</h3>
        <Alert Type="AlertType.Success" Message="Success — saved." />
        <Alert Type="AlertType.Info" Message="Info — heads up." />
        <Alert Type="AlertType.Warning" Message="Warning — check this." />
        <Alert Type="AlertType.Error" Message="Error — something failed." Closable="true" />
        <Alert Type="AlertType.Info" Message="With description" Description="A longer explanation under the message." />
        <Alert Banner="true" Message="Banner mode — full-width, no border/radius, defaults to warning severity." />
        <Alert Message="With an action slot" Closable="true">
            <Action><button class="wss-dialog-btn wss-dialog-btn-sm" data-test-id="alert-action-btn">Undo</button></Action>
        </Alert>
    </section>

    <section class="demo-section">
        <h3>Skeleton</h3>
        <Skeleton Loading="_skeletonLoading" Rows="3">
            <p>Loaded content goes here.</p>
        </Skeleton>
        <button class="wss-dialog-btn" @onclick="@(() => _skeletonLoading = !_skeletonLoading)">
            Toggle loading (@(_skeletonLoading ? "on" : "off"))
        </button>

        <p style="margin:0; color:#666;">
            <code>Avatar</code>/<code>AvatarShape</code> add a placeholder block beside the
            title/paragraph; the standalone <code>SkeletonElement</code> covers AntD's
            <code>Skeleton.Button</code>/<code>Skeleton.Input</code> shapes.
        </p>
        <Skeleton Avatar="true" Rows="2" />
        <Skeleton Avatar="true" AvatarShape="SkeletonAvatarShape.Square" Rows="2" />
        <div style="display:flex; gap:12px; align-items:center;">
            <SkeletonElement Kind="SkeletonElementKind.Button" />
            <SkeletonElement Kind="SkeletonElementKind.Input" />
        </div>
    </section>

    <section class="demo-section">
        <h3>Popover</h3>
        <Popover Title="Popover title">
            <ChildContent>
                <button class="wss-dialog-btn">Click me</button>
            </ChildContent>
            <Content>
                <div>Some popover content.</div>
            </Content>
        </Popover>
    </section>

    <section class="demo-section">
        <h3>Pagination</h3>
        <Pagination Total="95" PageSize="10" Current="_page" CurrentChanged="@(p => _page = p)" />
        <p>Current page: @_page</p>
    </section>

    <section class="demo-section">
        <h3>Modal &amp; Drawer</h3>
        <div style="display:flex; gap:1rem;">
            <button class="wss-dialog-btn wss-dialog-btn-primary" @onclick="@(() => _modalVisible = true)">Open Modal</button>
            <button class="wss-dialog-btn" @onclick="@(() => _drawerVisible = true)">Open Drawer</button>
        </div>

        <Modal @bind-Visible="_modalVisible" Title="A modal" OnOk="@(() => _modalVisible = false)">
            <p>Modal body content. Click OK or Cancel.</p>
        </Modal>

        <Drawer @bind-Visible="_drawerVisible" Title="A drawer" Placement="DrawerPlacement.Right">
            <p>Drawer body content.</p>
        </Drawer>
    </section>

    <section class="demo-section">
        <h3>Modal &amp; Drawer — Centered, Keyboard, Extra</h3>
        <p style="margin:0; color:#666;">
            <code>Centered</code> vertically centers the dialog. <code>Keyboard</code> (default
            true) independently governs Escape-to-close — here it's off, so Escape does nothing
            while <code>Closable</code> still shows the header X. <code>Drawer.Extra</code> adds a
            header-right slot beside the close button.
        </p>
        <div style="display:flex; gap:1rem;">
            <button class="wss-dialog-btn" data-test-id="open-centered-modal" @onclick="@(() => _centeredModalVisible = true)">
                Open Centered Modal (Keyboard off)
            </button>
            <button class="wss-dialog-btn" data-test-id="open-extra-drawer" @onclick="@(() => _extraDrawerVisible = true)">
                Open Extra-slot Drawer
            </button>
        </div>

        <Modal @bind-Visible="_centeredModalVisible" Title="Centered modal" Centered="true" Keyboard="false">
            <p data-test-id="centered-modal-body">Escape does nothing here — try it.</p>
        </Modal>

        <Drawer @bind-Visible="_extraDrawerVisible" Title="Drawer with Extra">
            <Extra><button class="wss-dialog-btn wss-dialog-btn-sm" data-test-id="drawer-extra-btn">Save</button></Extra>
            <ChildContent><p>Drawer body content.</p></ChildContent>
        </Drawer>
    </section>

    <section class="demo-section">
        <h3>Popconfirm</h3>
        <Popconfirm Title="Delete this item?" OnConfirm="@(() => _confirmResult = "confirmed")" OnCancel="@(() => _confirmResult = "cancelled")">
            <button class="wss-dialog-btn">Delete</button>
        </Popconfirm>
        <p>Last action: @_confirmResult</p>

        <p style="margin:0; color:#666;">
            <code>OkDanger</code> styles the OK button as danger; a genuinely-async
            <code>OnConfirm</code> keeps the popup open with both buttons disabled and a spinner
            until it resolves (a real API call stands in for the 1s delay here).
        </p>
        <Popconfirm Title="Permanently delete this record?" OkDanger="true" OkText="Delete"
                    OnConfirm="SimulateAsyncConfirmAsync">
            <button class="wss-dialog-btn" data-test-id="async-confirm-trigger">Delete (async)</button>
        </Popconfirm>
        <p data-test-id="async-confirm-result">Async result: @_asyncConfirmResult</p>
    </section>

    <section class="demo-section">
        <h3>Popconfirm &amp; Popover — controlled Visible</h3>
        <p style="margin:0; color:#666;">
            <code>@@bind-Visible</code> lets the parent own the open state — the same controlled
            design as <code>Select</code>'s <code>@@bind-Open</code>.
        </p>
        <div style="display:flex; gap:1rem; align-items:center;">
            <button class="wss-dialog-btn" data-test-id="controlled-popconfirm-toggle"
                    @onclick="@(() => _controlledPopconfirmVisible = !_controlledPopconfirmVisible)">
                @(_controlledPopconfirmVisible ? "Close" : "Open") Popconfirm externally
            </button>
            <Popconfirm Title="Controlled from outside" @bind-Visible="_controlledPopconfirmVisible">
                <button class="wss-dialog-btn" data-test-id="controlled-popconfirm-trigger">Trigger</button>
            </Popconfirm>
        </div>
        <div style="display:flex; gap:1rem; align-items:center;">
            <button class="wss-dialog-btn" data-test-id="controlled-popover-toggle"
                    @onclick="@(() => _controlledPopoverVisible = !_controlledPopoverVisible)">
                @(_controlledPopoverVisible ? "Close" : "Open") Popover externally
            </button>
            <Popover Title="Controlled from outside" @bind-Visible="_controlledPopoverVisible">
                <ChildContent><button class="wss-dialog-btn" data-test-id="controlled-popover-trigger">Trigger</button></ChildContent>
                <Content><div>Popover body.</div></Content>
            </Popover>
        </div>
    </section>

    <section class="demo-section">
        <h3>Table (selectable, sortable, paged, styled checkboxes)</h3>
        <p style="margin:0; color:#666;">
            Antd-style custom-drawn checkboxes for header/row selection (<code>UseStyledCheckbox</code>),
            including the indeterminate "mixed" glyph when only some rows on the page are selected
            (preselected below). Settable per-<code>Table</code> or globally via a cascaded
            <code>FormDefaults</code> (or the process-wide <code>FormOptions.DefaultUseStyledCheckbox</code>
            static).
        </p>
        <Table TItem="Row" DataSource="_rows" Selectable="true" UseStyledCheckbox="true" PageSize="5" PagerAlign="PagerAlign.Center"
               SelectedItems="_selectedRows" SelectedItemsChanged="@(s => _selectedRows = s.ToList())">
            <PropertyColumn TItem="Row" TProp="int" Title="Id" Property="@(r => r.Id)" Sortable="true" />
            <PropertyColumn TItem="Row" TProp="string" Title="Name" Property="@(r => r.Name)" Sortable="true" />
            <PropertyColumn TItem="Row" TProp="decimal" Title="Price" Property="@(r => r.Price)" Format="C2" Sortable="true" />
            <ActionColumn TItem="Row" Title="Action">
                <button class="wss-dialog-btn wss-dialog-btn-sm">Edit</button>
            </ActionColumn>
        </Table>
        <p>Selected: @_selectedRows.Count</p>
    </section>

    <section class="demo-section">
        <h3>Table — expandable rows + header info tooltip</h3>
        <p style="margin:0; color:#666;">
            <code>RowDetail</code> adds a leading chevron column; clicking it reveals the template
            as a full-width row (here a nested selectable child <code>Table</code>, the Vendor PO
            pattern). <code>Column.TitleContent</code> replaces the plain title — here composing a
            <code>LabelTooltip</code> info icon into the header.
        </p>
        <Table TItem="PoRow" DataSource="_poRows" RowKey="@(r => r.Number)">
            <ChildContent>
                <PropertyColumn TItem="PoRow" TProp="string" Title="PO #" Property="@(r => r.Number)" />
                <Column TItem="PoRow" Title="ESD">
                    <TitleContent>
                        ESD <LabelTooltip Id="esd-info" Tooltip="Estimated ship date for the full PO." />
                    </TitleContent>
                    <ChildContent Context="r">@(r.Esd?.ToString("MM/dd/yyyy") ?? "--")</ChildContent>
                </Column>
                <PropertyColumn TItem="PoRow" TProp="string" Title="Tracking Number" Property="@(r => r.Tracking)" />
            </ChildContent>
            <RowDetail Context="r">
                <Table TItem="SkuRow" DataSource="r.Skus" Selectable="true" UseStyledCheckbox="true">
                    <PropertyColumn TItem="SkuRow" TProp="string" Title="SKU" Property="@(s => s.Sku)" />
                    <PropertyColumn TItem="SkuRow" TProp="string" Title="Description" Property="@(s => s.Description)" />
                    <PropertyColumn TItem="SkuRow" TProp="int" Title="Quantity" Property="@(s => s.Quantity)" />
                </Table>
            </RowDetail>
        </Table>
    </section>

    <section class="demo-section">
        <h3>Table — server-side paging (compose pattern)</h3>
        <p style="margin:0; color:#666;">
            The Table renders only the current page (no built-in <code>PageSize</code>); a standalone
            <code>Pagination</code> you drive fetches each page. The 150&nbsp;ms delay below stands in
            for a server round-trip.
        </p>
        <Table TItem="Row" DataSource="_serverRows">
            <PropertyColumn TItem="Row" TProp="int" Title="Id" Property="@(r => r.Id)" />
            <PropertyColumn TItem="Row" TProp="string" Title="Name" Property="@(r => r.Name)" />
            <PropertyColumn TItem="Row" TProp="decimal" Title="Price" Property="@(r => r.Price)" Format="C2" />
        </Table>
        <div style="display:flex; justify-content:flex-end;">
            <Pagination Total="_serverTotal" PageSize="ServerPageSize" Current="_serverPage" CurrentChanged="LoadServerPageAsync" />
        </div>
        <p>Server has @_serverTotal rows; showing page @_serverPage.</p>
    </section>

    <section class="demo-section">
        <h3>Toasts (static services — not Blazor Server)</h3>
        @if (StaticToastsSupported)
        {
            <div style="display:flex; gap:1rem; flex-wrap:wrap;">
                <button class="wss-dialog-btn" @onclick="@(() => WasmMessageService.Success("Saved!"))">Message</button>
                <button class="wss-dialog-btn" @onclick="@(() => WasmNotificationService.Info("Notification", "With a description."))">Notification</button>
            </div>

            <p style="margin:0; color:#666;">
                <code>Placement</code> is set on the CONTAINER (not the service) — a second
                <code>WasmNotificationContainer</code> here, anchored bottom-left. Both containers
                render the same static service's items (so a notification appears in both corners at
                once here); a real app would typically use one container per placement it needs.
            </p>
            <button class="wss-dialog-btn" data-test-id="bottom-left-notification-btn"
                    @onclick="@(() => WasmNotificationService.Warning("Bottom-left", "Anchored via Placement.", 4))">
                Show it bottom-left
            </button>
            <WasmNotificationContainer Placement="NotificationPlacement.BottomLeft" />
        }
        else
        {
            <p style="margin:0; color:#666;" data-test-id="static-toasts-unavailable">
                This gallery is running on the Blazor <strong>Server</strong> renderer.
                <code>WasmMessageService</code>/<code>WasmNotificationService</code> keep their state
                in process-wide statics, which one Server process shares across every circuit, so the
                containers deliberately refuse to render here rather than leak one user's toasts onto
                another's screen. Register the scoped services with
                <code>builder.Services.AddWssControlsToasts()</code>, inject
                <code>IMessageService</code>/<code>INotificationService</code>, and use
                <code>&lt;MessageContainer /&gt;</code>/<code>&lt;NotificationContainer /&gt;</code>
                instead. Everything else on this page works the same either way.
            </p>
        }
    </section>

    <section class="demo-section">
        <h3>Tabs + SearchInput (filter strip)</h3>
        <p style="margin:0; color:#666;">
            The Vendor PO Management subheader pattern: labeled pill search fields
            (<code>SearchInput</code> — Enter or the button raises <code>OnSearch</code>) above an
            underline <code>Tabs</code> strip whose tabs carry bordered count chips. These tabs are
            a bare filter strip (no pane content); give a <code>Tab</code> child content to render
            the active pane below the strip.
        </p>
        <div style="display:flex; gap:16px; flex-wrap:wrap; align-items:center;">
            <SearchInput @bind-Value="_poSearch" AddonLabel="POs" OnSearch="@(v => _lastSearch = $"POs: {v}")"
                         Id="demo-search-pos" Width="240px" />
            <SearchInput @bind-Value="_skuSearch" AddonLabel="SKUs" OnSearch="@(v => _lastSearch = $"SKUs: {v}")"
                         Id="demo-search-skus" Width="240px" Loading="@_skuSearchLoading" />
            <button class="wss-dialog-btn" type="button" data-test-id="toggle-sku-search-loading"
                    @onclick="@(() => _skuSearchLoading = !_skuSearchLoading)">
                Toggle SKU search Loading
            </button>
        </div>
        <Tabs @bind-ActiveKey="_activeTab" Id="demo-tabs" TablistLabel="Shipment filters">
            <Tab Key="overdue" Title="Overdue" Count="12" />
            <Tab Key="missing" Title="Missing Estimations" Count="12" />
            <Tab Key="other" Title="Other Active" Count="5" />
        </Tabs>
        <p data-test-id="tabs-result">Active: @_activeTab · Last search: @_lastSearch</p>
    </section>

    <section class="demo-section">
        <h3>Tabs — TabBarExtraContent, Centered, Card type</h3>
        <p style="margin:0; color:#666;">
            <code>TabBarExtraContent</code> adds a right-aligned strip slot; <code>Centered</code>
            centers the tab buttons; <code>Type="TabsType.Card"</code> switches to AntD's boxed
            card-style tabs (CSS-only — keyboard/ARIA unchanged).
        </p>
        <label style="display:flex; align-items:center; gap:6px; margin-bottom:8px;">
            <input type="checkbox" data-test-id="toggle-priority-tab" @bind="_showPriorityTab" />
            Insert a "Priority" tab before Tab 1 (exercises conditional insertion -- Tab 1/2/3's own
            parameters never change on this toggle, so nothing but the render-tree diff can place
            the newcomer, which is why each Tab renders its own nav button).
        </label>
        <Tabs @bind-ActiveKey="_cardTab" Id="demo-tabs-card" Type="TabsType.Card" Centered="true">
            <TabBarExtraContent><button class="wss-dialog-btn wss-dialog-btn-sm" data-test-id="tabs-extra-btn">+ Add</button></TabBarExtraContent>
            <ChildContent>
                @if (_showPriorityTab)
                {
                    <Tab Key="priority" Title="Priority"><p>Pane priority.</p></Tab>
                }
                <Tab Key="one" Title="Tab 1"><p>Pane one.</p></Tab>
                <Tab Key="two" Title="Tab 2"><p>Pane two.</p></Tab>
                <Tab Key="three" Title="Tab 3"><p>Pane three.</p></Tab>
            </ChildContent>
        </Tabs>
    </section>

    <section class="demo-section">
        <h3>SearchInput — AllowClear, EnterButtonText</h3>
        <p style="margin:0; color:#666;">
            <code>AllowClear</code> shows a × between the input and the search button whenever
            there's text; <code>EnterButtonText</code> swaps the icon-only button for a labeled
            primary button (AntD's <code>enterButton="Search"</code>).
        </p>
        <div style="display:flex; gap:16px; flex-wrap:wrap; align-items:center;">
            <SearchInput @bind-Value="_clearableSearch" AllowClear="true" Placeholder="Clearable..."
                         Id="demo-search-clearable" Width="220px" />
            <SearchInput @bind-Value="_enterButtonSearch" EnterButtonText="Search" AllowClear="true"
                         Id="demo-search-enter-button" Width="240px" />
        </div>
    </section>

    <section class="demo-section">
        <h3>Select — pill filter variant</h3>
        <p style="margin:0; color:#666;">
            <code>Variant="SelectVariant.Pill"</code> turns the Select trigger into a rounded
            filter button; <code>Prefix</code> supplies the leading icon. The section is themed via
            a scoped <code>--wss-select-pill-color</code> / <code>--wss-color-bg-selected</code>
            override — one knob recolors border, label, chevron, and focus ring.
        </p>
        <div class="wss-demo-pill-filters" style="display:flex; gap:12px; flex-wrap:wrap;">
            <Select TValue="string" @bind-Value="_shipmentFilter" Options="_shipmentOptions"
                    Variant="SelectVariant.Pill" ShowSearch="false" AllowClear="false"
                    InputLabel="Shipment filter" Id="demo-pill-select">
                <Prefix>
                    <svg width="1.25em" height="1.25em" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="1" y="3" width="15" height="13"></rect>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg>
                </Prefix>
            </Select>
            <Select TValue="string" @bind-Value="_productFilter" Options="_productOptions"
                    Variant="SelectVariant.Pill" ShowSearch="false" AllowClear="false"
                    Placeholder="Products" InputLabel="Product filter" Id="demo-pill-select-2">
                <Prefix>
                    <svg width="1.25em" height="1.25em" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                </Prefix>
            </Select>
        </div>
        <p data-test-id="pill-result">Shipments filter: @_shipmentFilter</p>
    </section>

    <section class="demo-section">
        <h3>DateRangePicker</h3>
        <p style="margin:0; color:#666;">
            Composite start → end field opening a preset sidebar + dual-month calendar with
            month/year quick-select headers. Presets are page-supplied (nothing is built in) and
            resolve at click time. The initial value is pinned to Jan/Feb 2025 so the e2e visual
            baseline is deterministic; <code>FirstDayOfWeek</code> is pinned for the same reason.
        </p>
        <DateRangePicker @bind-Start="_rangeStart" @bind-End="_rangeEnd"
                         Presets="_rangePresets"
                         Min="@(new DateTime(2017, 1, 1))"
                         FirstDayOfWeek="DayOfWeek.Sunday"
                         Id="demo-range"
                         Width="300px" />
        <p data-test-id="range-result">
            Selected: @(_rangeStart?.ToString("yyyy-MM-dd") ?? "—") → @(_rangeEnd?.ToString("yyyy-MM-dd") ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>Mode</code> swaps what both linked panels select together -- the bound
            <code>Start</code>/<code>End</code> stay <code>DateTime?</code> in every mode.
            <code>Month</code> shows two consecutive years, each a 3x4 month grid; two clicks (one
            per endpoint) commit their first-of-month starts. Initial values are pinned for the same
            baseline-determinism reason as the single-date sibling's own Mode demos.
        </p>
        <DateRangePicker @bind-Start="_rangeMonthStart" @bind-End="_rangeMonthEnd"
                         Mode="DatePickerMode.Month"
                         Id="demo-range-month"
                         Width="280px" />
        <p data-test-id="range-month-result">
            Selected: @(_rangeMonthStart?.ToString("yyyy-MM") ?? "—") → @(_rangeMonthEnd?.ToString("yyyy-MM") ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>Year</code> shows two consecutive decades, each a 3x4 year grid (10 of the decade
            plus 2 dimmed adjacent-decade years).
        </p>
        <DateRangePicker @bind-Start="_rangeYearStart" @bind-End="_rangeYearEnd"
                         Mode="DatePickerMode.Year"
                         Id="demo-range-year"
                         Width="220px" />
        <p data-test-id="range-year-result">
            Selected: @(_rangeYearStart?.Year.ToString() ?? "—") → @(_rangeYearEnd?.Year.ToString() ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>Week</code> renders the same dual one-month calendars as <code>Date</code> plus a
            leading week-number column in both -- always shown regardless of
            <code>ShowWeekNumbers</code>. The ROW, not the day, is the selection unit: clicking any
            day commits its week's start. <code>FirstDayOfWeek</code> is pinned for the same
            baseline-determinism reason as the single-date sibling's own Week demo.
        </p>
        <DateRangePicker @bind-Start="_rangeWeekStart" @bind-End="_rangeWeekEnd"
                         Mode="DatePickerMode.Week"
                         FirstDayOfWeek="DayOfWeek.Sunday"
                         Id="demo-range-week"
                         Width="280px" />
        <p data-test-id="range-week-result">
            Selected: @(_rangeWeekStart?.ToString("yyyy-MM-dd") ?? "—") → @(_rangeWeekEnd?.ToString("yyyy-MM-dd") ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>Quarter</code> shows two consecutive years, each a single row of 4 quarter buttons.
        </p>
        <DateRangePicker @bind-Start="_rangeQuarterStart" @bind-End="_rangeQuarterEnd"
                         Mode="DatePickerMode.Quarter"
                         Id="demo-range-quarter"
                         Width="240px" />
        <p data-test-id="range-quarter-result">
            Selected: @(_rangeQuarterStart?.ToString("yyyy-MM-dd") ?? "—") → @(_rangeQuarterEnd?.ToString("yyyy-MM-dd") ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>DateTime</code>/<code>Time</code> abandon the dual-panel layout for a SINGLE panel
            per-endpoint pick session ending in an OK button: picking the active endpoint's day/time
            and clicking OK either advances to the other endpoint (the active underline moves,
            nothing is committed yet) or -- once both sides are resolved -- commits both and closes.
            <code>Use12Hours="false"</code> and seconds on for this one; both endpoints start empty
            (<code>DefaultViewDate</code> pins the panel's initial month) so the advance step is
            actually observable.
        </p>
        <DateRangePicker @bind-Start="_rangeDateTimeStart" @bind-End="_rangeDateTimeEnd"
                         Mode="DatePickerMode.DateTime"
                         Use12Hours="false"
                         ShowSeconds="true"
                         DefaultViewDate="@(new DateTime(2026, 2, 10))"
                         Id="demo-range-datetime"
                         Width="260px" />
        <p data-test-id="range-datetime-result">
            Selected: @(_rangeDateTimeStart?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—") → @(_rangeDateTimeEnd?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>Time</code> drops the calendar entirely -- just the time row and OK, per endpoint.
            <code>Use12Hours</code> + <code>MinuteStep="15"</code> + <code>ShowSeconds="false"</code>
            together here.
        </p>
        <DateRangePicker @bind-Start="_rangeTimeStart" @bind-End="_rangeTimeEnd"
                         Mode="DatePickerMode.Time"
                         Use12Hours="true"
                         MinuteStep="15"
                         ShowSeconds="false"
                         Id="demo-range-time"
                         Width="220px" />
        <p data-test-id="range-time-result">
            Selected: @(_rangeTimeStart?.ToString("HH:mm") ?? "—") → @(_rangeTimeEnd?.ToString("HH:mm") ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>DisabledDate</code> (weekends, here) rejects a cell/commit alongside
            <code>Min</code>/<code>Max</code>; <code>ExtraFooter</code> renders its own strip below
            the calendar in every mode (AntD's <code>renderExtraFooter</code>).
        </p>
        <DateRangePicker @bind-Start="_rangeDisabledStart" @bind-End="_rangeDisabledEnd"
                         DisabledDate="IsWeekend"
                         Id="demo-range-disabled"
                         Width="300px">
            <ExtraFooter>
                <span data-test-id="range-disabled-extra-footer">Weekdays only — weekends are disabled.</span>
            </ExtraFooter>
        </DateRangePicker>
        <p data-test-id="range-disabled-result">
            Selected: @(_rangeDisabledStart?.ToString("yyyy-MM-dd") ?? "—") → @(_rangeDisabledEnd?.ToString("yyyy-MM-dd") ?? "—")
        </p>
    </section>

    <section class="demo-section">
        <h3>DatePicker (single date)</h3>
        <p style="margin:0; color:#666;">
            The single-date sibling of the range picker: one field with a calendar suffix, one
            month panel with month/year quick-select headers. Picking a day (or typing a date and
            pressing Enter) commits and closes. The initial value is pinned to Feb 2026 so the e2e
            visual baseline is deterministic; <code>FirstDayOfWeek</code> is pinned for the same reason.
        </p>
        <DatePicker @bind-Value="_singleDate"
                    Min="@(new DateTime(2017, 1, 1))"
                    FirstDayOfWeek="DayOfWeek.Sunday"
                    Id="demo-date"
                    Width="300px" />
        <p data-test-id="date-result">
            Selected: @(_singleDate?.ToString("yyyy-MM-dd") ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>Mode</code> swaps what the panel offers — the bound <code>Value</code> stays
            <code>DateTime?</code> in every mode. <code>Month</code> replaces the day calendar with a
            year header + 3x4 month grid; <code>Time</code> drops the calendar for hour/minute/second
            selects over an OK button; <code>DateTime</code> keeps the day calendar and appends that
            same time row below it. Initial values are pinned for the same baseline-determinism reason.
        </p>
        <DatePicker @bind-Value="_monthValue"
                    Mode="DatePickerMode.Month"
                    Id="demo-month"
                    Width="200px" />
        <p data-test-id="month-result">
            Selected: @(_monthValue?.ToString("yyyy-MM") ?? "—")
        </p>

        <DatePicker @bind-Value="_timeValue"
                    Mode="DatePickerMode.Time"
                    Id="demo-time"
                    Width="200px" />
        <p data-test-id="time-result">
            Selected: @(_timeValue?.ToString("HH:mm:ss") ?? "—")
        </p>

        <DatePicker @bind-Value="_dateTimeValue"
                    Mode="DatePickerMode.DateTime"
                    Id="demo-datetime"
                    Width="260px" />
        <p data-test-id="datetime-result">
            Selected: @(_dateTimeValue?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>Year</code>/<code>Quarter</code>/<code>Week</code> round out <code>Mode</code>'s
            remaining granularities — initial values stay in the Feb 2026 family for the same
            baseline-determinism reason as the demos above.
        </p>
        <DatePicker @bind-Value="_yearValue"
                    Mode="DatePickerMode.Year"
                    Id="demo-year"
                    Width="160px" />
        <p data-test-id="year-result">
            Selected: @(_yearValue?.Year.ToString() ?? "—")
        </p>

        <DatePicker @bind-Value="_quarterValue"
                    Mode="DatePickerMode.Quarter"
                    Id="demo-quarter"
                    Width="200px" />
        <p data-test-id="quarter-result">
            Selected: @(_quarterValue?.ToString("yyyy-MM-dd") ?? "—")
        </p>

        <DatePicker @bind-Value="_weekValue"
                    Mode="DatePickerMode.Week"
                    FirstDayOfWeek="DayOfWeek.Sunday"
                    Id="demo-week"
                    Width="220px" />
        <p data-test-id="week-result">
            Selected: @(_weekValue?.ToString("yyyy-MM-dd") ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>Presets</code> adds a shortcut sidebar (resolved at click time, same contract as
            <code>DateRangePicker.Presets</code> above) and <code>ShowToday</code> adds a footer
            link — both commit a value and close the panel.
        </p>
        <DatePicker @bind-Value="_presetsValue"
                    Presets="_datePresets"
                    ShowToday="true"
                    Id="demo-presets"
                    Width="300px" />
        <p data-test-id="presets-result">
            Selected: @(_presetsValue?.ToString("yyyy-MM-dd") ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>Use12Hours</code> + <code>MinuteStep</code> + <code>ShowSeconds="false"</code>
            together on a <code>Time</code> mode picker.
        </p>
        <DatePicker @bind-Value="_twelveHourValue"
                    Mode="DatePickerMode.Time"
                    Use12Hours="true"
                    MinuteStep="15"
                    ShowSeconds="false"
                    Id="demo-12h"
                    Width="200px" />
        <p data-test-id="twelve-hour-result">
            Selected: @(_twelveHourValue?.ToString("HH:mm") ?? "—")
        </p>
    </section>

    <section class="demo-section">
        <h3>Popover — swapped trigger child</h3>
        <p style="margin:0; color:#666;">
            The trigger child is re-created across renders (a common busy/idle swap). The popup ARIA
            must follow the live child, and a disabled Popconfirm's button child must be marked inert.
        </p>
        <button class="wss-dialog-btn" data-test-id="swap-toggle" @onclick="@(() => _triggerBusy = !_triggerBusy)">
            Toggle trigger (@(_triggerBusy ? "loading" : "ready"))
        </button>
        <Popover Title="Swapped trigger">
            <ChildContent>
                @if (_triggerBusy)
                {
                    <span data-test-id="swap-trigger-child">Loading…</span>
                }
                else
                {
                    <button type="button" class="wss-dialog-btn" data-test-id="swap-trigger-child">Open popover</button>
                }
            </ChildContent>
            <Content>
                <div data-test-id="swap-popover-content">Swapped-trigger popover content.</div>
            </Content>
        </Popover>

        <Popconfirm Title="Delete this item?" Disabled="true">
            <button type="button" class="wss-dialog-btn" data-test-id="disabled-popconfirm-child">Delete (disabled)</button>
        </Popconfirm>
    </section>

    <section class="demo-section">
        <h3>Hover Tooltip (<code>data-tooltip</code>)</h3>
        <p style="margin:0; color:#666;">
            Not a component — a <code>data-tooltip="..."</code> attribute on any element, styled by
            plain CSS rules in <code>wss-controls.css</code>. The optional <code>wss-tooltip.js</code>
            (linked in this demo's <code>App.razor</code>) auto-places the bubble based on the
            trigger's position in its container; an explicit placement class (like the second button
            below) opts out of auto-placement.
        </p>
        <div style="display:flex; gap:2rem; flex-wrap:wrap; padding: 2rem 0;">
            <button class="wss-dialog-btn" data-tooltip="Auto-placed — flips/shifts based on position" data-test-id="tooltip-auto">
                Hover me (auto)
            </button>
            <button class="wss-dialog-btn wss-tooltip-top" data-tooltip="Forced above via wss-tooltip-top" data-test-id="tooltip-forced-top">
                Hover me (forced top)
            </button>
        </div>
    </section>

    @* ---- AntD 4.x parity batch: Pagination + Table (appended -- existing sections/baselines above
       are untouched; ordinal Playwright locators for THOSE sections use .First, so they're safe). ---- *@

    <section class="demo-section">
        <h3>Pagination — total text, size changer, quick jumper</h3>
        <p style="margin:0; color:#666;">
            <code>ShowTotal</code> renders the "x-y of z items" text; <code>PageSizeOptions</code>
            adds a native <code>&lt;select&gt;</code> size-changer (<code>@@bind-PageSize</code>) that
            re-clamps the current page to keep roughly the same data window in view;
            <code>ShowQuickJumper</code> adds a "Go to" input (Enter commits, then clears). All
            dependency-free -- no JS module, no <code>Select&lt;T&gt;</code>.
        </p>
        <Pagination Total="95" @bind-PageSize="_paginationDemoPageSize" @bind-Current="_paginationDemoPage"
                    PageSizeOptions="@(new[] { 10, 20, 50 })" ShowQuickJumper="true"
                    ShowTotal="@(w => $"{w.Start}-{w.End} of {w.Total} items")" />
        <p data-test-id="pagination-demo-result">Page @_paginationDemoPage, size @_paginationDemoPageSize</p>

        <p style="margin:0; color:#666;"><code>Small</code> -- the AntD compact size (CSS-only).</p>
        <Pagination Total="30" PageSize="10" @bind-Current="_smallPaginationPage" Small="true" />
    </section>

    <section class="demo-section">
        <h3>Table — Loading overlay, disabled rows, single-select</h3>
        <p style="margin:0; color:#666;">
            <code>Loading</code> shows a translucent mask + spinner over the body (rows stay rendered
            beneath it, <code>aria-busy</code> on the wrapper). <code>IsRowSelectable</code> disables
            row 2's control and excludes it from the header select-all math.
            <code>SelectionMode.Single</code> renders radio-semantics selection instead of checkboxes
            -- the header cell is empty (no "select all" for an exclusive choice).
        </p>
        <button class="wss-dialog-btn" data-test-id="toggle-table-loading" @onclick="@(() => _tableLoadingDemo = !_tableLoadingDemo)">
            Toggle Loading (@(_tableLoadingDemo ? "on" : "off"))
        </button>
        <Table TItem="Row" DataSource="_singleSelectRows" Selectable="true" SelectionMode="SelectionMode.Single"
               IsRowSelectable="@(r => r.Id != 2)" Loading="_tableLoadingDemo"
               SelectedItems="_singleSelected" SelectedItemsChanged="@(s => _singleSelected = s.ToList())">
            <PropertyColumn TItem="Row" TProp="int" Title="Id" Property="@(r => r.Id)" />
            <PropertyColumn TItem="Row" TProp="string" Title="Name" Property="@(r => r.Name)" />
        </Table>
        <p data-test-id="single-select-result">Selected: @(_singleSelected.Count == 0 ? "(none)" : _singleSelected[0].Name)</p>
    </section>

    <section class="demo-section">
        <h3>Table — OnRowClick, ExpandRowByClick, controlled expansion</h3>
        <p style="margin:0; color:#666;">
            <code>ExpandRowByClick</code> toggles a row's <code>RowDetail</code> on a whole-row click
            (clicks on the chevron/checkbox/action cells stop propagation, so they don't double-fire);
            <code>OnRowClick</code> always fires independently. <code>ExpandedRowKeys</code>/
            <code>ExpandedRowKeysChanged</code> makes expansion parent-controlled.
        </p>
        <Table TItem="Row" DataSource="_clickRows" RowKey="@(r => r.Id)" ExpandRowByClick="true"
               OnRowClick="@(r => _lastRowClicked = r.Name)"
               ExpandedRowKeys="_clickExpandedKeys" ExpandedRowKeysChanged="@(k => _clickExpandedKeys = k.ToList())">
            <ChildContent>
                <PropertyColumn TItem="Row" TProp="string" Title="Name" Property="@(r => r.Name)" />
            </ChildContent>
            <RowDetail Context="r">
                <p data-test-id="row-detail">Detail for @r.Name</p>
            </RowDetail>
        </Table>
        <p data-test-id="row-click-result">Last row clicked: @_lastRowClicked</p>
    </section>

    <section class="demo-section">
        <h3>Table — Ellipsis, EmptyContent, FooterContent</h3>
        <p style="margin:0; color:#666;">
            <code>Ellipsis</code> truncates long text with a hover <code>title</code>
            (<code>PropertyColumn</code> only) -- the table switches to <code>table-layout: fixed</code>
            only while a column requests it. <code>FooterContent</code> renders a consumer-supplied
            summary row in a <code>&lt;tfoot&gt;</code>, unaffected by paging/sorting.
            <code>EmptyContent</code> replaces <code>EmptyText</code> with richer markup when there
            are no rows.
        </p>
        <div style="max-width: 320px;">
            <Table TItem="Row" DataSource="_ellipsisRows">
                <ChildContent>
                    <PropertyColumn TItem="Row" TProp="string" Title="Name" Property="@(r => r.Name)" Ellipsis="true" />
                    <PropertyColumn TItem="Row" TProp="decimal" Title="Price" Property="@(r => r.Price)" Format="C2" />
                </ChildContent>
                <FooterContent>
                    <tr>
                        <td class="wss-table-cell">Total</td>
                        <td class="wss-table-cell" data-test-id="ellipsis-footer-total">@_ellipsisRows.Sum(r => r.Price).ToString("C2")</td>
                    </tr>
                </FooterContent>
            </Table>
        </div>

        <Table TItem="Row" DataSource="@(new List<Row>())">
            <ChildContent>
                <PropertyColumn TItem="Row" TProp="string" Title="Name" Property="@(r => r.Name)" />
            </ChildContent>
            <EmptyContent><em data-test-id="empty-content">No rows match your filter.</em></EmptyContent>
        </Table>
    </section>

    <section class="demo-section">
        <h3>Table — column filtering (FilterOptions/OnFilter)</h3>
        <p style="margin:0; color:#666;">
            The funnel icon opens a checkbox dropdown: checking multiple values in one column is an
            OR (Name matches ANY checked value), and two filterable columns AND together (Name AND
            Price). <code>OK</code> applies and closes; <code>Reset</code> clears that column
            immediately; clicking outside the dropdown discards any pending checkbox changes without
            applying them. <code>OnFilterChanged</code> observes every apply/reset. The Name column
            is also <code>Sortable</code> -- the sort trigger and the filter button share one header
            cell.
        </p>
        <Table TItem="Row" DataSource="_filterDemoRows" OnFilterChanged="OnDemoFilterChanged">
            <ChildContent>
                <PropertyColumn TItem="Row" TProp="string" Title="Name" Property="@(r => r.Name)" Sortable="true"
                                FilterOptions="_nameFilterOptions" OnFilter="@((Row r, string v) => r.Name == v)" />
                <Column TItem="Row" Title="Price" FilterOptions="_priceFilterOptions"
                        OnFilter="@((Row r, string v) => v == "low" ? r.Price < 20 : r.Price >= 20)">
                    @context.Price.ToString("C2")
                </Column>
            </ChildContent>
        </Table>
        <p data-test-id="filter-demo-result">@_filterChangedMessage</p>
    </section>

    <section class="demo-section">
        <h3>Table — text and custom filters (FilterText / FilterDropdown)</h3>
        <p style="margin:0; color:#666;">
            <code>FilterText</code> gives a column a free-text dropdown over an accessor (Name, the
            default <code>Contains</code> match); <code>TextFilterMatch</code> switches the comparison
            (Code uses <code>StartsWith</code>, so "AX" matches but "X-1" doesn't). Enter applies the
            staged text, and the clear button empties it without applying.
            <code>FilterDropdown</code> hands the WHOLE panel to the consumer (Quantity): the template
            stages keys with <code>SetSelectedValues</code>, applies with <code>ConfirmAsync</code> and
            clears with <code>ResetAsync</code> -- AntD's <code>filterDropdown</code> shape.
            <code>FilterIcon</code> replaces the funnel glyph with one that reports the applied state,
            and <code>OnFilterDropdownOpenChange</code> reports every open/close.
            <code>OnFiltersChanged</code> publishes one aggregate snapshot of every active column,
            each with a ready-made <code>Description</code>.
        </p>
        <Table TItem="Widget"
               DataSource="_widgetRows"
               OnFiltersChanged="@(s => _widgetFilterSummary = DescribeFilters(s))">
            <ChildContent>
                <PropertyColumn TItem="Widget"
                                TProp="string"
                                Title="Name"
                                Property="@(w => w.Name)"
                                FilterText="@(w => w.Name)" />
                <PropertyColumn TItem="Widget"
                                TProp="string"
                                Title="Code"
                                Property="@(w => w.Code)"
                                FilterText="@(w => w.Code)"
                                TextFilterMatch="TextFilterMatch.StartsWith" />
                <PropertyColumn TItem="Widget"
                                TProp="int"
                                Title="Quantity"
                                Property="@(w => w.Quantity)"
                                OnFilter="@((Widget w, string v) => int.TryParse(v, out var min) && w.Quantity >= min)"
                                OnFilterDropdownOpenChange="@(open => _widgetCustomOpen = open)">
                    <FilterIcon Context="applied">
                        <span class="wss-demo-filter-icon"
                              data-test-id="widget-filter-icon"
                              data-applied="@(applied ? "true" : "false")">@(applied ? "≥" : "#")</span>
                    </FilterIcon>
                    <FilterDropdown Context="ctx">
                        <div class="wss-demo-filter-panel">
                            <input type="search"
                                   class="wss-table-filter-input"
                                   data-test-id="widget-custom-input"
                                   autocomplete="off"
                                   aria-label="Minimum quantity"
                                   value="@(ctx.SelectedValues.Count > 0 ? ctx.SelectedValues[0] : "")"
                                   @oninput="@(e => StageMinQuantity(ctx, e.Value as string))" />
                            <div class="wss-demo-filter-panel-footer">
                                <button type="button"
                                        class="wss-dialog-btn wss-dialog-btn-sm"
                                        data-test-id="widget-custom-reset"
                                        @onclick="@(() => ctx.ResetAsync())">Reset</button>
                                <button type="button"
                                        class="wss-dialog-btn wss-dialog-btn-sm"
                                        data-test-id="widget-custom-apply"
                                        @onclick="@(() => ctx.ConfirmAsync())">Filter</button>
                            </div>
                        </div>
                    </FilterDropdown>
                </PropertyColumn>
            </ChildContent>
        </Table>
        <p data-test-id="filter-summary-1">@_widgetFilterSummary</p>
        <p data-test-id="widget-dropdown-open">Quantity panel open: @(_widgetCustomOpen ? "true" : "false")</p>
    </section>

    <section class="demo-section">
        <h3>Table — filter row (FilterPlacement.Row) with type-derived editors</h3>
        <p style="margin:0; color:#666;">
            <code>FilterPlacement="TableFilterPlacement.Row"</code> drops the funnels and puts one
            always-visible editor per filterable column into a second header row, applying as the user
            edits -- freely typed boxes after <code>FilterDebounceMilliseconds</code> (150 here) of
            quiet, discrete picks at once. <code>PropertyColumn.Filterable</code> derives the editor
            from the property type the way <code>Sortable</code> derives its comparison: string to a
            text box, a numeric to an inclusive min/max pair, a date to a
            <code>DateRangePicker</code>, a bool to a yes/no select, an enum to its member list
            (labelled by <code>[EnumDisplayName]</code>/<code>[Display]</code>).
            <code>FilterValuesFromData</code> builds Supplier's options from the distinct values
            actually present in <code>DataSource</code>. Every editor is named
            "<code>Filter by {header}</code>" (<code>FilterRowLabelFormat</code>), and
            <code>ClearFiltersAsync()</code> clears the lot in one call.
        </p>
        <button class="wss-dialog-btn"
                data-test-id="filter-row-clear"
                @onclick="ClearFilterRowAsync">Clear filters</button>
        <Table @ref="_filterRowTable"
               TItem="Product"
               DataSource="_products"
               Size="TableSize.Small"
               FilterPlacement="TableFilterPlacement.Row"
               FilterDebounceMilliseconds="150"
               OnFiltersChanged="@(s => _filterRowSummary = DescribeFilters(s))">
            <ChildContent>
                <PropertyColumn TItem="Product"
                                TProp="string"
                                Title="Name"
                                Property="@(p => p.Name)"
                                Filterable="true" />
                <PropertyColumn TItem="Product"
                                TProp="decimal"
                                Title="Price"
                                Property="@(p => p.Price)"
                                Format="C2"
                                Filterable="true" />
                <PropertyColumn TItem="Product"
                                TProp="DateTime"
                                Title="Added"
                                Property="@(p => p.Added)"
                                Format="d"
                                Filterable="true" />
                <PropertyColumn TItem="Product"
                                TProp="bool"
                                Title="In stock"
                                Property="@(p => p.InStock)"
                                Filterable="true" />
                <PropertyColumn TItem="Product"
                                TProp="ProductCategory"
                                Title="Category"
                                Property="@(p => p.Category)"
                                Filterable="true" />
                <PropertyColumn TItem="Product"
                                TProp="string"
                                Title="Supplier"
                                Property="@(p => p.Supplier)"
                                FilterValuesFromData="true" />
            </ChildContent>
        </Table>
        <p data-test-id="filter-summary-2">@_filterRowSummary</p>
    </section>

    <section class="demo-section">
        <h3>Table — filter row under ScrollY</h3>
        <p style="margin:0; color:#666;">
            The same rows under <code>ScrollY</code>: the whole <code>&lt;thead&gt;</code> pins as one
            block (both the title row and the editors stay put while the body scrolls beneath them),
            which is why the sticky positioning moves from each header cell to the
            <code>&lt;thead&gt;</code> whenever the table carries
            <code>wss-table-has-filter-row</code>. The editors here open popups of their own -- a
            <code>Select</code> list and a date panel -- from inside a wrapper that clips its
            overflow.
        </p>
        <Table TItem="Product"
               DataSource="_products"
               Size="TableSize.Small"
               ScrollY="200px"
               FilterPlacement="TableFilterPlacement.Row">
            <ChildContent>
                <PropertyColumn TItem="Product"
                                TProp="string"
                                Title="Item"
                                Property="@(p => p.Name)"
                                Filterable="true" />
                <PropertyColumn TItem="Product"
                                TProp="ProductCategory"
                                Title="Group"
                                Property="@(p => p.Category)"
                                Filterable="true" />
                <PropertyColumn TItem="Product"
                                TProp="DateTime"
                                Title="Listed"
                                Property="@(p => p.Added)"
                                Format="d"
                                Filterable="true" />
            </ChildContent>
        </Table>
    </section>

    <section class="demo-section">
        <h3>Table — dropdown extras (FilterSearch, FilterCheckAll, DefaultFilterValues)</h3>
        <p style="margin:0; color:#666;">
            <code>FilterSearch</code> puts a search box above a long option list (Region, 12 options)
            and shows <code>FilterEmptyText</code> when nothing matches; <code>FilterCheckAll</code>
            adds a "Select all" row that toggles exactly the options the query leaves visible and
            renders mixed when only some are ticked. <code>DefaultFilterValues</code> starts Status
            filtered to Open without raising a change event, and
            <code>FilterResetToDefault</code> makes <code>Reset</code> return there instead of
            clearing. <code>FilterOnClose</code> (Tier) turns dismissing the panel -- an outside
            click or Escape -- into an <code>OK</code>.
        </p>
        <Table TItem="Ticket" DataSource="_tickets">
            <ChildContent>
                <PropertyColumn TItem="Ticket"
                                TProp="string"
                                Title="Region"
                                Property="@(t => t.Region)"
                                FilterOptions="_regionFilterOptions"
                                OnFilter="@((Ticket t, string v) => t.Region == v)"
                                FilterSearch="true"
                                FilterCheckAll="true" />
                <PropertyColumn TItem="Ticket"
                                TProp="string"
                                Title="Status"
                                Property="@(t => t.Status)"
                                FilterOptions="_statusFilterOptions"
                                OnFilter="@((Ticket t, string v) => t.Status == v)"
                                DefaultFilterValues="_statusDefaultFilterValues"
                                FilterResetToDefault="true" />
                <PropertyColumn TItem="Ticket"
                                TProp="string"
                                Title="Tier"
                                Property="@(t => t.Tier)"
                                FilterOptions="_tierFilterOptions"
                                OnFilter="@((Ticket t, string v) => t.Tier == v)"
                                FilterOnClose="true" />
            </ChildContent>
        </Table>
    </section>

    <section class="demo-section">
        <h3>Table — short dropdown-filter table (typed kinds, no ScrollY)</h3>
        <p style="margin:0; color:#666;">
            <code>Filterable</code> in the default Dropdown placement: a date column opens a
            <code>DateRangePicker</code> panel, a numeric column a min/max pair, a bool column a
            yes/no select — each popup far taller than these three rows.
            <code>.wss-table-wrapper</code>'s <code>overflow-x: auto</code> makes
            <code>overflow-y</code> compute to <code>auto</code> too, so the panel escapes the
            wrapper's clip with fixed positioning (JS) here as well, not only under
            <code>ScrollY</code>.
        </p>
        <Table TItem="ShortRow" DataSource="_shortRows" Size="TableSize.Small">
            <ChildContent>
                <PropertyColumn TItem="ShortRow" TProp="string" Title="Item" Property="@(r => r.Name)" />
                <PropertyColumn TItem="ShortRow" TProp="DateTime" Title="Due" Property="@(r => r.Due)"
                                Format="d" Filterable="true" />
                <PropertyColumn TItem="ShortRow" TProp="int" Title="Count" Property="@(r => r.Count)"
                                Filterable="true" />
                <PropertyColumn TItem="ShortRow" TProp="bool" Title="Active" Property="@(r => r.Active)"
                                Filterable="true" />
            </ChildContent>
        </Table>
    </section>

    <section class="demo-section">
        <h3>Table — Sortable + Filterable header in a narrow fixed-width column</h3>
        <p style="margin:0; color:#666;">
            Regression coverage for a header that combines a sort trigger AND a filter button in a
            column narrow enough to squeeze both (<code>table-layout: fixed</code>, forced here by
            <code>Ellipsis</code>) -- the sort label truncates with an ellipsis instead of pushing
            the filter button out of the header cell.
        </p>
        <div style="max-width: 180px;">
            <Table TItem="Row" DataSource="_narrowSortFilterRows">
                <ChildContent>
                    <PropertyColumn TItem="Row" TProp="string" Title="Name" Property="@(r => r.Name)"
                                    Sortable="true" Ellipsis="true"
                                    FilterOptions="_nameFilterOptions" OnFilter="@((Row r, string v) => r.Name == v)" />
                </ChildContent>
            </Table>
        </div>
    </section>

    <section class="demo-section">
        <h3>Table — keyboard/pointer parity for a control inside a plain column</h3>
        <p style="margin:0; color:#666;">
            A <code>&lt;button&gt;</code> a consumer drops into an ordinary <code>Column</code> (not
            <code>ActionColumn</code>, which stops row-click propagation for the whole cell) still
            activates the row when clicked -- that is the pointer behavior, and Enter on the same
            button has to match it exactly. The browser synthesizes a click from Enter, so the cell's
            own keydown is stopped at the <code>&lt;td&gt;</code>: both counters below advance by one
            per activation, whichever input device produced it.
        </p>
        <Table TItem="Row" DataSource="_parityRows" RowKey="@(r => r.Id)"
               OnRowClick="@(_ => _parityRowActivations++)">
            <ChildContent>
                <PropertyColumn TItem="Row" TProp="string" Title="Name" Property="@(r => r.Name)" />
                <Column TItem="Row" Title="Action">
                    <button type="button" class="wss-dialog-btn wss-dialog-btn-sm"
                            data-test-id="parity-cell-button" @onclick="@(() => _parityButtonClicks++)">
                        Edit @context.Name
                    </button>
                </Column>
            </ChildContent>
        </Table>
        <p data-test-id="parity-row-activations">Row activations: @_parityRowActivations</p>
        <p data-test-id="parity-button-clicks">Button clicks: @_parityButtonClicks</p>
    </section>

    <section class="demo-section">
        <h3>Table — ScrollY (sticky header)</h3>
        <p style="margin:0; color:#666;">
            <code>ScrollY</code> bounds the table body to a fixed height with its own vertical
            scrollbar and a sticky header (AntD's <code>scroll.y</code> equivalent) -- the header
            cells stay pinned in place while the rows scroll beneath them. The Name column's filter
            dropdown here (6 options) is taller than the scrolled area, so it escapes the wrapper's
            overflow clip via fixed positioning (JS) instead of the default CSS-anchored placement,
            and keeps tracking its trigger if the page itself scrolls. <code>Loading</code> is wired
            up too, to cover the sticky-header-vs-mask stacking fix: opening the filter while Loading
            is on must not leave its OK button hidden under the mask.
        </p>
        <button class="wss-dialog-btn" data-test-id="toggle-scrolly-loading" @onclick="@(() => _scrollYLoadingDemo = !_scrollYLoadingDemo)">
            Toggle Loading (@(_scrollYLoadingDemo ? "on" : "off"))
        </button>
        <Table TItem="Row" DataSource="_scrollYRows" ScrollY="160px" Loading="_scrollYLoadingDemo">
            <ChildContent>
                <PropertyColumn TItem="Row" TProp="string" Title="Name" Property="@(r => r.Name)"
                                FilterOptions="_scrollYFilterOptions" OnFilter="@((Row r, string v) => r.Name == v)" />
                <PropertyColumn TItem="Row" TProp="decimal" Title="Price" Property="@(r => r.Price)" Format="C2" />
            </ChildContent>
        </Table>
    </section>

    <section class="demo-section">
        <h3>ColorPicker</h3>
        <p style="margin:0; color:#666;">
            The raw picker behind <code>EditColor</code>: a swatch trigger over a transparency
            checkerboard opening a saturation/brightness area, a hue slider, an alpha slider, and a
            HEX/RGB input row. It binds a plain <code>string</code> and emits normalized lowercase
            hex — <code>#rrggbb</code>, or <code>#rrggbbaa</code> when the color is translucent. The
            handles drag with the pointer, and every track is a <code>role="slider"</code> the arrow
            keys step (Shift or PageUp/PageDown for a larger step). Initial values are pinned so the
            e2e visual baselines are deterministic.
        </p>
        <ColorPicker @bind-Value="_colorValue" Id="demo-color" ShowText="true" />
        <p data-test-id="color-result">
            Selected: @(_colorValue ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>ShowAlpha="false"</code> drops the alpha slider and strips the channel from the
            value; <code>AllowClear</code> adds a clear affordance that raises <code>null</code>; and
            <code>Presets</code> adds a labeled swatch row (any form the picker accepts works as a
            preset entry — the last one below is <code>rgba()</code>).
        </p>
        <ColorPicker @bind-Value="_colorNoAlpha" Id="demo-color-opaque" ShowAlpha="false" ShowText="true" />
        <p data-test-id="color-opaque-result">
            Selected: @(_colorNoAlpha ?? "—")
        </p>

        <ColorPicker @bind-Value="_colorClearable" Id="demo-color-clear"
                     AllowClear="true" ShowText="true" Presets="_colorPresets" />
        <p data-test-id="color-clear-result">
            Selected: @(_colorClearable ?? "—")
        </p>

        <p style="margin:0; color:#666;">
            <code>Disabled</code> makes the trigger inert — the popup can't be opened at all.
        </p>
        <ColorPicker @bind-Value="_colorDisabled" Id="demo-color-disabled" Disabled="true" ShowText="true" />
    </section>
</div>

@* Static-state toast hosts. WssBlazorControls.Demo is a published package, so <UiKitGallery /> can be
   dropped onto a Blazor Server page -- where these two throw by design (see WasmToastHost). Gated so
   the rest of the gallery still renders there instead of the whole page dying with them. *@
@if (StaticToastsSupported)
{
    <WasmMessageContainer />
    <WasmNotificationContainer />
}

@code {
    // WasmMessageContainer/WasmNotificationContainer throw on the Blazor Server renderer, where their
    // process-static state is shared by every circuit. This gallery ships in a published package, so
    // it has to survive being dropped on a Server page: gate the toast demo on the same condition the
    // containers themselves check and show an explanation in its place. Every other host -- WebAssembly,
    // WebView (Blazor Hybrid), and the static prerender pass -- gets the real containers.
    bool StaticToastsSupported => RendererInfo.Name != "Server";

    bool _skeletonLoading = true;
