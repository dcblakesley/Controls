@if (Standalone)
{
    <h1>Select Pill Demo</h1>
}

<div class="wss-demo-gallery">

    <section class="demo-section">
        <h3>Select — pill filter variant</h3>
        <p style="margin:0; color:#666;">
            <code>Variant="SelectVariant.Pill"</code> turns the Select trigger into a rounded
            filter button; <code>Prefix</code> supplies the leading icon. The section is themed via
            a scoped <code>--wss-select-pill-color</code> / <code>--wss-color-bg-selected</code>
            override — one knob recolors border, label, chevron, and focus ring.
        </p>
        <div class="wss-demo-pill-filters" style="display:flex; gap:12px; flex-wrap:wrap;">
            <Select TValue="string" @bind-Value="_shipmentFilter" Options="_shipmentOptions"
                    Variant="SelectVariant.Pill" ShowSearch="false" AllowClear="false"
                    InputLabel="Shipment filter" Id="demo-pill-select">
                <Prefix>
                    <svg width="1.25em" height="1.25em" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="1" y="3" width="15" height="13"></rect>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                        <circle cx="5.5" cy="18.5" r="2.5"></circle>
                        <circle cx="18.5" cy="18.5" r="2.5"></circle>
                    </svg>
                </Prefix>
            </Select>
            <Select TValue="string" @bind-Value="_productFilter" Options="_productOptions"
                    Variant="SelectVariant.Pill" ShowSearch="false" AllowClear="false"
                    Placeholder="Products" InputLabel="Product filter" Id="demo-pill-select-2">
                <Prefix>
                    <svg width="1.25em" height="1.25em" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                </Prefix>
            </Select>
        </div>
        <p data-test-id="pill-result">Shipments filter: @_shipmentFilter</p>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_selectPillExample</code></pre>

        <h3>CSS</h3>
        <pre class="code-block code-block-css"><code>@_selectPillCss</code></pre>
    </section>

</div>

@code {
    /// <summary> False inside <see cref="UiKitGallery"/>, whose own heading covers the whole page. </summary>
    [Parameter] public bool Standalone { get; set; } = true;

    readonly string _selectPillExample = @"<Select TValue=""string"" @bind-Value=""_shipmentFilter"" Options=""_shipmentOptions""
        Variant=""SelectVariant.Pill"" ShowSearch=""false"" AllowClear=""false""
        InputLabel=""Shipment filter"">
    <Prefix>
        <svg width=""1.25em"" height=""1.25em"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor""
             stroke-width=""2"" aria-hidden=""true"">
            <rect x=""1"" y=""3"" width=""15"" height=""13""></rect>
            <polygon points=""16 8 20 8 23 11 23 16 16 16 16 8""></polygon>
        </svg>
    </Prefix>
</Select>";

    readonly string _selectPillCss = @".wss-demo-pill-filters {
    --wss-select-pill-color: #1c4a3f;
    --wss-color-bg-selected: #d9e8e2;
}";

    // --- Pill-select demo ---
    string _shipmentFilter = "all";
    string? _productFilter;

    static readonly List<SelectOption<string>> _shipmentOptions =
    [
        new("all", "All shipments"),
        new("drop", "Drop shipments"),
        new("warehouse", "Warehouse shipments"),
    ];

    static readonly List<SelectOption<string>> _productOptions =
    [
        new("all", "All products"),
        new("in-stock", "In stock"),
        new("special-order", "Special order"),
    ];
}
