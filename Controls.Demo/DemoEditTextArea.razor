@using Microsoft.AspNetCore.Components.Forms
@inherits DemoFormPage

<h1>EditTextArea Demo</h1>

<EditForm Model="@_model" class="wss-demo-row wss-demo-wrap" @ref=_form >
    <ObjectGraphDataAnnotationsValidator/>
    
    <section class="demo-section">
        <EditTextArea @bind-Value="_model.BasicTextArea" />

        <EditTextArea @bind-Value="_model.BasicTextArea"
                      IsEditMode=false/>
        
        <h3>Markup</h3>
        <pre class="code-block"><code>@_basicExample</code></pre>
    </section>

    <section class="demo-section">
        <EditTextArea @bind-Value="_model.LargerTextArea"
                      Rows="5"/>
        
        <h3>Markup</h3>
        <pre class="code-block"><code>@_rowsExample</code></pre>
    </section>

    <section class="demo-section">
        <EditTextArea @bind-Value="_model.WithPlaceholder"
                      Placeholder="Enter your detailed comments here..."
                      Rows="4"/>
        
        <h3>Markup</h3>
        <pre class="code-block"><code>@_placeholderExample</code></pre>
    </section>

    <section class="demo-section">
        <EditTextArea @bind-Value="_model.MultilinePlaceholder"
                      Placeholder="Describe your experience, thoughts, or feedback. Feel free to be as detailed as you'd like."
                      Rows="3"/>
        
        <h3>Markup</h3>
        <pre class="code-block"><code>@_multilinePlaceholderExample</code></pre>
    </section>

    <section class="demo-section">
        <style>
            .my-custom-container { background-color:cyan; padding: 10px; border-radius: 40px; }
            .my-custom-textarea { background-color: magenta; border: 2px solid #0066cc; border-radius: 40px; padding: 8px; width: 100%; min-height: 100px; font-family: 'Courier New', monospace; }
        </style>

        <EditTextArea @bind-Value="_model.CustomStyling"
                      ContainerClass="my-custom-container"
                      class="my-custom-textarea"/>
        
        <h3>Markup</h3>
        <pre class="code-block"><code>@_customStyleExample</code></pre>
        
        <h3>CSS</h3>
        <pre class="code-block code-block-css"><code>@_customStyleCss</code></pre>
    </section>

    <section class="demo-section">
        <EditTextArea @bind-Value="_model.Disabled"
                      IsDisabled="true"/>

        <EditTextArea @bind-Value="_model.Required"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_validationExample</code></pre>

        <h3>Model</h3>
        <pre class="code-block code-block-model"><code>@_validationModel</code></pre>
    </section>

    <section class="demo-section">
        <h3>AllowClear</h3>

        <EditTextArea @bind-Value="_model.Clearable" AllowClear="true"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_allowClearExample</code></pre>
    </section>

    <section class="demo-section">
        <h3>MaxLength + ShowCount</h3>

        <EditTextArea @bind-Value="_model.Counted" MaxLength="200" ShowCount="true"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_maxLengthExample</code></pre>
    </section>

    <section class="demo-section">
        <h3>Placeholder from Model Attribute</h3>
        <p>
            A <code>[Placeholder]</code> attribute on the bound property (or DataAnnotations'
            <code>[Display(Prompt = "...")]</code>) supplies the hint here even though the markup below
            sets no <code>Placeholder</code> parameter at all.
        </p>

        <EditTextArea @bind-Value="_model.WithPlaceholderAttribute" Rows="3"/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_placeholderAttributeExample</code></pre>

        <h3>Model</h3>
        <pre class="code-block code-block-model"><code>@_placeholderAttributeModel</code></pre>
    </section>

    @* The two AutoSize sections below must stay LAST on this page: EditTextAreaE2ETests anchors on
       section.demo-section.Last to reach the "AutoSize" one. Append new sections ABOVE this comment. *@
    <section class="demo-section">
        <h3>AutoSize -- programmatic value change</h3>
        <p>
            AutoSize is already on here -- "Load long text" sets the bound value directly (not by
            typing into the box), which must still re-measure and grow it.
        </p>

        <EditTextArea @bind-Value="_model.AutoSizeProgrammatic" AutoSize="true" MinRows="2" MaxRows="6"/>

        <button type="button" @onclick="LoadLongProgrammaticText">Load long text</button>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_autoSizeProgrammaticExample</code></pre>
    </section>

    <section class="demo-section">
        <h3>AutoSize -- toggled on at runtime</h3>
        <p>
            AutoSize starts off on a box that already holds several lines of content -- switching it
            on must measure immediately rather than waiting for the next keystroke.
        </p>

        <EditTextArea @bind-Value="_model.AutoSizeToggleTarget" AutoSize="_autoSizeToggledOn" MinRows="2" MaxRows="6"/>

        <button type="button" @onclick="EnableAutoSizeToggle">Enable AutoSize</button>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_autoSizeToggleExample</code></pre>
    </section>

    <section class="demo-section">
        <h3>AutoSize + UpdateOn=Change</h3>

        <EditTextArea @bind-Value="_model.AutoSizedChangeTrigger" AutoSize="true" MinRows="2" MaxRows="6"
                      UpdateOn="UpdateTrigger.Change"
                      Placeholder="Grows while you type -- the bound value only commits on blur."/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_autoSizeChangeExample</code></pre>
    </section>

    <section class="demo-section">
        <h3>AutoSize</h3>

        <EditTextArea @bind-Value="_model.AutoSized" AutoSize="true" MinRows="2" MaxRows="6"
                      Placeholder="Type several lines -- the box grows until it hits 6 rows, then scrolls."/>

        <h3>Markup</h3>
        <pre class="code-block"><code>@_autoSizeExample</code></pre>
    </section>
</EditForm>

@code {
    readonly DemoEditTextAreaModel _model = new();

    // Finding 60 demo: AutoSize starts off here, so "Enable AutoSize" exercises the false->true
    // runtime flip against content that's already several lines long.
    bool _autoSizeToggledOn;

    void LoadLongProgrammaticText() =>
        _model.AutoSizeProgrammatic = string.Join("\n", Enumerable.Range(1, 10).Select(i => $"line {i}"));

    void EnableAutoSizeToggle() => _autoSizeToggledOn = true;

    public class DemoEditTextAreaModel
    {
        [Description("Basic Description")]
        public string BasicTextArea { get; set; } = "";
        public string LargerTextArea { get; set; } = "Rows isn't being respected in the test project right now.";
        
        [Description("Example with placeholder text")]
        public string WithPlaceholder { get; set; } = "";
        
        [Description("Another placeholder example")]
        public string MultilinePlaceholder { get; set; } = "";
        
        public string CustomStyling { get; set; } = "I have custom styling";

        [Required] public string Required { get; set; } = "";

        public string Disabled { get; set; } = "This textarea is disabled";

        public string Clearable { get; set; } = "Clear me";
        public string Counted { get; set; } = "";
        public string AutoSized { get; set; } = "";
        public string AutoSizedChangeTrigger { get; set; } = "";
        public string AutoSizeProgrammatic { get; set; } = "";
        public string AutoSizeToggleTarget { get; set; } =
            string.Join("\n", Enumerable.Range(1, 8).Select(i => $"line {i}"));

        [Placeholder("Describe your experience, thoughts, or feedback...")]
        public string WithPlaceholderAttribute { get; set; } = "";
    }

    readonly string _basicExample = @"<EditTextArea @bind-Value=""_model.BasicTextArea"" />

<EditTextArea @bind-Value=""_model.BasicTextArea""
             IsEditMode=false/>";

    readonly string _rowsExample = @"<EditTextArea @bind-Value=""_model.LargerTextArea""
             Rows=""5""/>";

    readonly string _placeholderExample = @"<EditTextArea @bind-Value=""_model.WithPlaceholder""
             Placeholder=""Enter your detailed comments here...""
             Rows=""4""/>";

    readonly string _multilinePlaceholderExample = @"<EditTextArea @bind-Value=""_model.MultilinePlaceholder""
             Placeholder=""Describe your experience, thoughts, or feedback...""
             Rows=""3""/>";

    readonly string _customStyleExample = @"<EditTextArea @bind-Value=""_model.CustomStyling""
             ContainerClass=""my-custom-container""
             class=""my-custom-textarea""/>";

    readonly string _customStyleCss = @".my-custom-container { 
    background-color:cyan; 
    padding: 10px; 
    border-radius: 40px; 
}

.my-custom-textarea {
    background-color: magenta;
    border: 2px solid #0066cc;
    border-radius: 40px;
    padding: 8px;
    width: 100%;
    min-height: 100px;
    font-family: 'Courier New', monospace;
}";

    readonly string _validationExample = @"<EditTextArea @bind-Value=""_model.Disabled""
             IsDisabled=""true""/>

<EditTextArea @bind-Value=""_model.Required""/>";

    readonly string _validationModel = @"[Required]
public string Required { get; set; } = """";

public string Disabled { get; set; } = ""This textarea is disabled"";";

    readonly string _allowClearExample = @"<EditTextArea @bind-Value=""_model.Clearable""
             AllowClear=""true""/>";

    readonly string _maxLengthExample = @"<EditTextArea @bind-Value=""_model.Counted""
             MaxLength=""200""
             ShowCount=""true""/>";

    readonly string _autoSizeExample = @"<EditTextArea @bind-Value=""_model.AutoSized""
             AutoSize=""true""
             MinRows=""2""
             MaxRows=""6""
             Placeholder=""Type several lines...""/>";

    readonly string _autoSizeChangeExample = @"<EditTextArea @bind-Value=""_model.AutoSizedChangeTrigger""
             AutoSize=""true""
             MinRows=""2""
             MaxRows=""6""
             UpdateOn=""UpdateTrigger.Change""/>";

    readonly string _autoSizeProgrammaticExample = @"<EditTextArea @bind-Value=""_model.AutoSizeProgrammatic""
             AutoSize=""true""
             MinRows=""2""
             MaxRows=""6""/>

<button @onclick=""LoadLongProgrammaticText"">Load long text</button>";

    readonly string _autoSizeToggleExample = @"<EditTextArea @bind-Value=""_model.AutoSizeToggleTarget""
             AutoSize=""@_autoSizeToggledOn""
             MinRows=""2""
             MaxRows=""6""/>

<button @onclick=""EnableAutoSizeToggle"">Enable AutoSize</button>";

    readonly string _placeholderAttributeExample = @"<EditTextArea @bind-Value=""_model.WithPlaceholderAttribute""
             Rows=""3""/>";

    readonly string _placeholderAttributeModel = @"[Placeholder(""Describe your experience, thoughts, or feedback..."")]
public string WithPlaceholderAttribute { get; set; } = """";";
}
