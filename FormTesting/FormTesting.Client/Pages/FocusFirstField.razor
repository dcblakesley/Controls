@page "/focus-first-field"
@using Controls
@using Microsoft.AspNetCore.Components.Forms

<h1>Focus First Field</h1>

@* Test-only page (not part of the Controls.Demo gallery), same precedent as FocusApi.razor and
   JsInteropFallback.razor. FormDefaults.FocusFirstField resolves "first" in JavaScript from the
   rendered DOM, so bUnit can only prove the interop call was issued with the right scope id --
   FocusFirstFieldTests does that part. Only a real browser can answer the question that matters:
   which element is document.activeElement afterwards? FocusFirstFieldE2ETests drives this page.

   One case renders at a time (?case=...), so every field id below is unique document-wide and each
   assertion targets an id rather than a position. The default case is "off": a bare visit must focus
   nothing at all, which is also the byte-identical-when-unset baseline. *@

@if (Case is null or "off")
{
    @* FormDefaults present and doing its normal job, but FocusFirstField unset -- no markers, no
       interop call, no focus. The <template> markers must be absent from this render entirely. *@
    <FormDefaults UseStyledCheckbox="false">
        <EditForm Model="_model">
            <EditString @bind-Value="_model.OffFirst" />
            <EditString @bind-Value="_model.OffSecond" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "plain")
{
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_model">
            <EditString @bind-Value="_model.PlainFirst" />
            <EditString @bind-Value="_model.PlainSecond" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "skip")
{
    @* Every skip rule in front of the one field that should win, so "the first field" and "the first
       field the user could actually type in" disagree three times over. *@
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_model">
            <EditString @bind-Value="_model.SkipDisabled" IsDisabled="true" />
            <EditString @bind-Value="_model.SkipReadOnly" readonly="readonly" />
            <EditString @bind-Value="_model.SkipHidden" IsHidden="true" />
            <EditString @bind-Value="_model.SkipTarget" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "async")
{
    @* The ubiquitous asynchronous form: the scope mounts immediately, the fields arrive with the
       model a quarter of a second later. Its scope is EMPTY on first render, which is precisely the
       shape that used to focus nothing at all, ever -- the one attempt found no candidate and there
       was never another. The FormDefaults is deliberately OUTSIDE the @if, since putting it inside
       (so its own first render is the form's) is the deterministic alternative, not the bug. *@
    <FormDefaults FocusFirstField="true">
        @if (_asyncReady)
        {
            <EditForm Model="_model">
                <EditString @bind-Value="_model.AsyncFirst" />
                <EditString @bind-Value="_model.AsyncSecond" />
            </EditForm>
        }
        else
        {
            <p id="async-loading">Loading...</p>
        }
    </FormDefaults>
}
else if (Case == "aria-disabled")
{
    @* A disabled EditBool with AllowFocusWhenDisabled (the DEFAULT) renders aria-disabled="true" +
       tabindex="0" and NO `disabled` attribute -- deliberately, so a screen-reader user can still
       reach and read it. That also means el.disabled alone cannot tell it is unusable, and the
       checkbox was being chosen as "the first field". *@
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_model">
            <EditBool @bind-Value="_model.DisabledFlag" IsDisabled="true" />
            <EditString @bind-Value="_model.AfterDisabledBool" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "select-no-search")
{
    @* ShowSearch="false" renders the combobox `readonly` (a typing guard -- @oninput means "search"
       there) together with an explicit aria-readonly="false", because arrows/Enter/Space/type-ahead
       all still change the value. It is fully operable, so it IS the first field. *@
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_model">
            <EditSelectSearch @bind-Value="_model.NoSearchChoice" Options="_choices" ShowSearch="false" />
            <EditString @bind-Value="_model.AfterSelect" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "multi-select-no-search")
{
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_model">
            <EditMultiSelect @bind-Value="_model.NoSearchTags" Options="_choices" ShowSearch="false" />
            <EditString @bind-Value="_model.AfterMultiSelect" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "css-hidden")
{
    @* Rendered, present in the DOM, and not visible -- which is what checkVisibility is for. The
       "skip" case above can't reach this branch: HidingMode-hidden doesn't render the input at all,
       so there is nothing in the DOM to test. *@
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_model">
            <div style="display:none">
                <EditString @bind-Value="_model.DisplayNoneField" />
            </div>
            <div style="visibility:hidden">
                <EditString @bind-Value="_model.VisibilityHiddenField" />
            </div>
            <EditString @bind-Value="_model.CssHiddenTarget" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "unfocusable")
{
    @* The three remaining skip rules, each in front of the field that should win: out of the Tab
       order, and the two ancestor states that take a whole subtree out of play. *@
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_model">
            <EditString @bind-Value="_model.NotTabbableField" tabindex="-1" />
            <div inert>
                <EditString @bind-Value="_model.InertField" />
            </div>
            <div aria-hidden="true">
                <EditString @bind-Value="_model.AriaHiddenField" />
            </div>
            <EditString @bind-Value="_model.UnfocusableTarget" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "radio")
{
    @* Real radiogroup Tab semantics: a group with a selection has ONE tab stop, the checked radio --
       not the first one. Priority starts at High, the THIRD option, so the two rules disagree. *@
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_model">
            <EditRadioEnum @bind-Value="_model.Priority" />
            <EditString @bind-Value="_model.AfterRadio" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "two-forms-first-unusable")
{
    @* "First in the scope" genuinely crossing an EditForm boundary: form one's only field is
       disabled, so the answer has to come from form two. *@
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_model">
            <EditString @bind-Value="_model.FormOneDisabled" IsDisabled="true" />
        </EditForm>
        <EditForm Model="_other">
            <EditString @bind-Value="_other.FormTwoTarget" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "explicit")
{
    @* Precedence: a named control beats "whichever is first". Both mechanisms fire in the same
       render cycle, so this is the race the JS-side guard exists to settle. *@
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_model">
            <EditString @bind-Value="_model.ExplicitFirst" />
            <EditString @bind-Value="_model.ExplicitSecond" FocusOnFirstRender="true" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "two-forms")
{
    @* Two forms under ONE scope: one fire, and it lands in the first form. *@
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_model">
            <EditString @bind-Value="_model.FormOneField" />
        </EditForm>
        <EditForm Model="_other">
            <EditString @bind-Value="_other.FormTwoField" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "sibling-scopes")
{
    @* Two independently armed scopes. Both fire; the guard means the one that resolves first keeps
       focus rather than the last one silently winning. *@
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_model">
            <EditString @bind-Value="_model.ScopeAField" />
        </EditForm>
    </FormDefaults>
    <FormDefaults FocusFirstField="true">
        <EditForm Model="_other">
            <EditString @bind-Value="_other.ScopeBField" />
        </EditForm>
    </FormDefaults>
}
else if (Case == "bounded")
{
    @* The scope is delimited at BOTH ends: an armed FormDefaults with no field of its own must not
       reach past its closing marker to the field written after it in the same parent. *@
    <FormDefaults FocusFirstField="true">
        <p>No fields in this scope.</p>
    </FormDefaults>
    <EditForm Model="_model">
        <EditString @bind-Value="_model.OutsideField" />
    </EditForm>
}
else if (Case == "modal")
{
    <button type="button" id="open-modal" @onclick="() => _modalVisible = true">Open modal</button>
    @* Modal gates its children on @if (Visible), so the FormDefaults inside it FIRST renders as the
       dialog opens -- the same cycle in which wss-overlay.js's activateModal takes its own initial
       focus. The two interact by design: activateModal skips its grab when something in the panel is
       already focused, and this feature skips its own when a field already has focus, so whichever
       order they land in, focus ends on the first field and stays there. *@
    <Modal @bind-Visible="_modalVisible" Title="Modal form" HideFooter="true">
        <FormDefaults FocusFirstField="true">
            <EditForm Model="_model">
                <EditString @bind-Value="_model.ModalFirst" />
                <EditString @bind-Value="_model.ModalSecond" />
            </EditForm>
        </FormDefaults>
    </Modal>
}
else if (Case == "drawer")
{
    <button type="button" id="open-drawer" @onclick="() => _drawerVisible = true">Open drawer</button>
    <Drawer @bind-Visible="_drawerVisible" Title="Drawer form">
        <FormDefaults FocusFirstField="true">
            <EditForm Model="_model">
                <EditString @bind-Value="_model.DrawerFirst" />
                <EditString @bind-Value="_model.DrawerSecond" />
            </EditForm>
        </FormDefaults>
    </Drawer>
}

@code {
    [SupplyParameterFromQuery(Name = "case")]
    public string? Case { get; set; }

    readonly Model _model = new();
    readonly OtherModel _other = new();

    // SelectOption<string?> to match the nullable bound properties (see FocusApi.razor's note).
    readonly List<SelectOption<string?>> _choices = [new("alpha", "Alpha"), new("beta", "Beta")];

    bool _modalVisible;
    bool _drawerVisible;
    bool _asyncReady;

    // The "load the model, then render the form" shape, driven from OnAfterRender rather than
    // OnInitializedAsync on purpose: the scope has to be MOUNTED and empty while the wait happens,
    // which is the whole point of the case.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Case != "async") return;

        // Long enough to still be pending when the e2e's navigation settles: Playwright's
        // NetworkIdle wait alone costs half a second past the last request, and the test's premise is
        // that it observes the EMPTY scope before the fields land.
        await Task.Delay(1500);
        _asyncReady = true;
        StateHasChanged();
    }

    // Same three-plus-one shape as FocusApi.razor's: the model starts on the THIRD member, so
    // "focus the checked radio" and "focus the first radio" can't both be right.
    public enum PriorityLevel { Low, Medium, High, Critical }

    class Model
    {
        public string? OffFirst { get; set; }
        public string? OffSecond { get; set; }
        public string? PlainFirst { get; set; }
        public string? PlainSecond { get; set; }
        public string? SkipDisabled { get; set; }
        public string? SkipReadOnly { get; set; } = "Read only";
        public string? SkipHidden { get; set; }
        public string? SkipTarget { get; set; }
        public string? DisplayNoneField { get; set; }
        public string? VisibilityHiddenField { get; set; }
        public string? CssHiddenTarget { get; set; }
        public string? NotTabbableField { get; set; }
        public string? InertField { get; set; }
        public string? AriaHiddenField { get; set; }
        public string? UnfocusableTarget { get; set; }
        public PriorityLevel? Priority { get; set; } = PriorityLevel.High;
        public string? AfterRadio { get; set; }
        public string? FormOneDisabled { get; set; }
        public string? AsyncFirst { get; set; }
        public string? AsyncSecond { get; set; }
        public bool DisabledFlag { get; set; }
        public string? AfterDisabledBool { get; set; }
        public string? NoSearchChoice { get; set; }
        public string? AfterSelect { get; set; }
        public List<string?> NoSearchTags { get; set; } = [];
        public string? AfterMultiSelect { get; set; }
        public string? ExplicitFirst { get; set; }
        public string? ExplicitSecond { get; set; }
        public string? FormOneField { get; set; }
        public string? ScopeAField { get; set; }
        public string? OutsideField { get; set; }
        public string? ModalFirst { get; set; }
        public string? ModalSecond { get; set; }
        public string? DrawerFirst { get; set; }
        public string? DrawerSecond { get; set; }
    }

    // A second model so the second EditForm on the page binds its own instance, exactly as a real
    // page with two independent forms would.
    class OtherModel
    {
        public string? FormTwoField { get; set; }
        public string? FormTwoTarget { get; set; }
        public string? ScopeBField { get; set; }
    }
}
